local function refreshRemotes()
    for _, c in ipairs(RemScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    local found, seen = {}, {}
    local services = {}
    for _, sn in ipairs({"ReplicatedStorage","ReplicatedFirst","Players","Workspace"}) do
        pcall(function() services[#services+1] = game:GetService(sn) end)
    end
    for _, svc in ipairs(services) do
        pcall(function()
            for _, d in ipairs(svc:GetDescendants()) do
                if not seen[d] and (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then
                    seen[d] = true
                    found[#found+1] = d
