-- ── SELECTION BOX ──────────────────────────────────────────────────
local selectionBox = nil

local function clearSelectionBox()
    if selectionBox then
        selectionBox:Destroy()
        selectionBox = nil
    end
end

local function createSelectionBox(model)
    clearSelectionBox()
    selectionBox = Instance.new("SelectionBox")
    selectionBox.Color3             = C_YELLOW
    selectionBox.LineThickness      = 0.06
    selectionBox.SurfaceTransparency = 0.82
    selectionBox.SurfaceColor3      = C_YELLOW
    -- Adornee: model если есть PrimaryPart, иначе первый BasePart
    if model.PrimaryPart then
        selectionBox.Adornee = model
    else
        selectionBox.Adornee = model:FindFirstChildWhichIsA("BasePart")
    end
    selectionBox.Parent = workspace
end

-- ── DESELECT ───────────────────────────────────────────────────────
local function deselectBlock()
    selectedBlock = nil
    clearSelectionBox()
    updateSubPanels()
    setStatus("🔧 FreeBuilder — нажми на блок")
end

-- ── SELECT ─────────────────────────────────────────────────────────
local function selectBlock(model)
    selectedBlock = model
    createSelectionBox(model)
    updateSubPanels()
    setStatus("📦 " .. model.Name .. "  |  " .. activeMode)
end

-- ── FIND BLOCK MODEL ───────────────────────────────────────────────
-- БАГ #2 исправлен: строго ищем Model чей прямой parent = BUILD_MODEL_FOLDER
-- Это исключает Character и другие Models
local function getBlockModel(part)
    if not BUILD_MODEL_FOLDER then return nil end
    local obj = part
    while obj do
        if obj:IsA("Model") and obj.Parent == BUILD_MODEL_FOLDER then
            return obj
        end
        obj = obj.Parent
    end
    return nil
end

-- ── RAYCAST ────────────────────────────────────────────────────────
local function raycastScreen(screenPos)
    local ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    -- БАГ #8 исправлен: character берём динамически
    local char = player.Character
    params.FilterDescendantsInstances = char and {char} or {}
    return workspace:Raycast(ray.Origin, ray.Direction * 1200, params)
end

-- ── TAP / CLICK НА МИР ─────────────────────────────────────────────
local function onWorldTap(screenPos)
    local result = raycastScreen(screenPos)
    if not result or not result.Instance then
        deselectBlock()
        return
    end
    local model = getBlockModel(result.Instance)
    if model then
        selectBlock(model)
    else
        deselectBlock()
    end
end

-- ── COMMIT HELPERS ─────────────────────────────────────────────────
local function safeCommitMove(model)
    if not model or not model.Parent then return end
    if not rfCommitMove then
        warn("[FreeBuilder] CommitMove не найден, изменения только локальные!")
        return
    end
    local pp = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not pp then return end
    pcall(rfCommitMove.InvokeServer, rfCommitMove, model, pp.CFrame)
end

local function safeCommitResize(model, newSize)
    if not model or not model.Parent then return end
    if not rfCommitResize then
        warn("[FreeBuilder] CommitResize не найден, изменения только локальные!")
        return
    end
    pcall(rfCommitResize.InvokeServer, rfCommitResize, model, newSize)
end

-- ── MOVE ───────────────────────────────────────────────────────────
local MOVE_STEP = 1  -- studs за нажатие

local function moveBlock(axis, dir)
    if not selectedBlock or not selectedBlock.Parent then return end
    local pp = selectedBlock.PrimaryPart or selectedBlock:FindFirstChildWhichIsA("BasePart")
    if not pp then return end

    local cf = pp.CFrame
    local delta
    if axis == "X" then delta = Vector3.new(MOVE_STEP * dir, 0, 0)
    elseif axis == "Y" then delta = Vector3.new(0, MOVE_STEP * dir, 0)
    else delta = Vector3.new(0, 0, MOVE_STEP * dir) end

    -- БАГ #4 исправлен: CFrame + Vector3 корректно сохраняет ротацию
    local newCF = cf + delta
    if selectedBlock.PrimaryPart then
        selectedBlock:SetPrimaryPartCFrame(newCF)
    else
        pp.CFrame = newCF
    end
    safeCommitMove(selectedBlock)
end

-- ── ROTATE ─────────────────────────────────────────────────────────
local ROT_STEP = math.rad(15)

local function rotateBlock(axis, dir)
    if not selectedBlock or not selectedBlock.Parent then return end
    local pp = selectedBlock.PrimaryPart or selectedBlock:FindFirstChildWhichIsA("BasePart")
    if not pp then return end

    local cf = pp.CFrame
    local angle = ROT_STEP * dir
    local rot
    if axis == "X" then rot = CFrame.Angles(angle, 0, 0)
    elseif axis == "Y" then rot = CFrame.Angles(0, angle, 0)
    else rot = CFrame.Angles(0, 0, angle) end

    local newCF = cf * rot
    if selectedBlock.PrimaryPart then
        selectedBlock:SetPrimaryPartCFrame(newCF)
    else
        pp.CFrame = newCF
    end
    safeCommitMove(selectedBlock)
end

-- ── SCALE ──────────────────────────────────────────────────────────
local SCALE_STEP = 0.5
local MIN_SIZE   = 0.1

local function scaleBlock(axis, dir)
    if not selectedBlock or not selectedBlock.Parent then return end
    local pp = selectedBlock.PrimaryPart or selectedBlock:FindFirstChildWhichIsA("BasePart")
    if not pp then return end

    local sz = pp.Size
    local newSize
    if axis == "X" then
        newSize = Vector3.new(math.max(MIN_SIZE, sz.X + SCALE_STEP * dir), sz.Y, sz.Z)
    elseif axis == "Y" then
        newSize = Vector3.new(sz.X, math.max(MIN_SIZE, sz.Y + SCALE_STEP * dir), sz.Z)
    else
        newSize = Vector3.new(sz.X, sz.Y, math.max(MIN_SIZE, sz.Z + SCALE_STEP * dir))
    end

    -- Preview локально
    pp.Size = newSize
    -- БАГ #7: CommitResize передаём newSize — сервер масштабирует все Parts модели
    safeCommitResize(selectedBlock, newSize)
end

-- ── THROTTLED HOLD PRESS ────────────────────────────────────────────
-- БАГ #5 исправлен: throttle 0.15с, commitMove только при отпускании для move
local function setupHold(btn, actionFn, commitOnRelease)
    local conn
    local lastTime = 0
    btn.MouseButton1Down:Connect(function()
        actionFn()  -- первый клик сразу
        conn = RunService.Heartbeat:Connect(function()
            -- throttle: не чаще раз в 0.15 сек
            local now = tick()
            if now - lastTime >= 0.15 then
                lastTime = now
                actionFn()
            end
        end)
    end)
    btn.MouseButton1Up:Connect(function()
        if conn then conn:Disconnect(); conn = nil end
        if commitOnRelease then
            -- финальный commit при отпускании (для move чтобы не флудить)
            if selectedBlock and selectedBlock.Parent then
                safeCommitMove(selectedBlock)
            end
        end
    end)
    -- Touch support
    btn.TouchLongPress:Connect(function()
        if conn then conn:Disconnect(); conn = nil end
    end)
end

