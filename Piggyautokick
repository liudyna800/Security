local function makePage()
    local p = Instance.new("Frame")
    p.Parent = MainFrame
    p.BackgroundTransparency = 1
    p.Size = UDim2.new(1, 0, 1, -78)
    p.Position = UDim2.new(0, 0, 0, 78)
    p.Visible = false
    return p
end

for i = 1, 3 do
    pages[i] = makePage()
end
pages[1].Visible = true

local function switchTab(i)
    for k, p in ipairs(pages) do p.Visible = (k == i) end
    for k, b in ipairs(tabBtns) do
        b.BackgroundColor3 = (k == i) and Color3.fromRGB(30,30,55) or Color3.fromRGB(18,18,30)
        b.TextColor3 = (k == i) and Color3.fromRGB(0,170,255) or Color3.fromRGB(130,130,160)
    end
end

for i, btn in ipairs(tabBtns) do
    btn.MouseButton1Click:Connect(function() switchTab(i) end)
end

-- ==================== ТОГГЛ С ШАРИКОМ (нормальный) ====================
local function CreateNiceToggle(parent, text, yPos, defaultState, callback)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    frame.Size = UDim2.new(0.9, 0, 0, 42)
    frame.Position = UDim2.new(0.05, 0, 0, yPos)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.Text = text
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Position = UDim2.new(0, 15, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(230, 230, 240)
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left

    local toggleBg = Instance.new("Frame")
    toggleBg.Parent = frame
    toggleBg.Size = UDim2.new(0, 52, 0, 26)
    toggleBg.Position = UDim2.new(1, -68, 0.5, -13)
    toggleBg.BackgroundColor3 = defaultState and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(55, 55, 70)
    Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(1, 0)

    local ball = Instance.new("Frame")
    ball.Parent = toggleBg
    ball.Size = UDim2.new(0, 22, 0, 22)
    ball.Position = defaultState and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 2, 0.5, -11)
    ball.BackgroundColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", ball).CornerRadius = UDim.new(1, 0)

    local state = defaultState

    frame.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            state = not state
            TweenService:Create(toggleBg, TweenInfo.new(0.25), {
                BackgroundColor3 = state and Color3.fromRGB(0,170,80) or Color3.fromRGB(55,55,70)
            }):Play()
            TweenService:Create(ball, TweenInfo.new(0.25), {
                Position = state and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 2, 0.5, -11)
            }):Play()
            if callback then callback(state) end
        end
    end)
end

