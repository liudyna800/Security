-- [[ FLEE THE FACILITY — LOGIC CORE (NO GUI) ]]
-- All toggles are plain booleans. Connect them to your GUI buttons.

local Players         = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService      = game:GetService("RunService")
local Lighting        = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer
local Comp = 0

-- =============================================
-- HELPERS
-- =============================================
local function IsThereChar(APlr)
    local plr = APlr or LocalPlayer
    if plr.Character and plr.Character:FindFirstChild("Humanoid") then
        return true
    end
    return false
end

-- =============================================
-- TOGGLES (set these from your GUI)
-- =============================================
local T = {
    -- Player
    speedEnabled  = false,
    speedValue    = 16,
    jumpEnabled   = false,
    jumpValue     = 50,
    infiniteJump  = false,
    fullbright    = false,
    -- ESP
    beastESP      = false,
    playerESP     = false,
    exitESP       = false,
    podESP        = false,
    computerESP   = false,
    -- Misc
    autoRemoveRope = false,
    beastCrawl    = false,
    antiPCError   = false,
}

-- =============================================
-- INFINITE JUMP
-- =============================================
UserInputService.JumpRequest:Connect(function()
    if T.infiniteJump and IsThereChar() then
        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- =============================================
-- ESP TABLES
-- =============================================
local BeastHighlights   = {}
local PlrHighlights     = {}
local ExitHighlights    = {}
local PodHighlights     = {}
local PCHighlights      = {}

local function clearHighlights(tbl)
    for i = #tbl, 1, -1 do
        if tbl[i] and tbl[i].Parent then tbl[i]:Destroy() end
        table.remove(tbl, i)
    end
end

-- =============================================
-- ESP UPDATE FUNCTIONS
-- =============================================
local function UpdateBeastESP()
    -- Remove invalid
    for i = #BeastHighlights, 1, -1 do
        local h = BeastHighlights[i]
        if not T.beastESP or h.Adornee == nil then
            h:Destroy(); table.remove(BeastHighlights, i)
        end
    end
    if not T.beastESP then return end
    for _, v in pairs(Players:GetPlayers()) do
        if v.Character and v.Character:FindFirstChild("BeastPowers") and v ~= LocalPlayer then
            -- Check not already highlighted
            local already = false
            for _, h in pairs(BeastHighlights) do
                if h.Adornee == v.Character then already = true; break end
            end
            if not already then
                local h = Instance.new("Highlight")
                h.Adornee = v.Character
                h.Parent  = v.Character
                table.insert(BeastHighlights, h)
            end
        end
    end
end

local function UpdatePlrESP()
    for i = #PlrHighlights, 1, -1 do
        local h = PlrHighlights[i]
        if not T.playerESP or h.Adornee == nil or h.Adornee.Parent == nil
            or h.Adornee.Parent:FindFirstChild("BeastPowers") then
            h:Destroy(); table.remove(PlrHighlights, i)
        end
    end
    if not T.playerESP then return end
    for _, v in pairs(Players:GetPlayers()) do
        if v.Character and not v.Character:FindFirstChild("BeastPowers") and v ~= LocalPlayer then
            local already = false
            for _, h in pairs(PlrHighlights) do
                if h.Adornee == v.Character then already = true; break end
            end
            if not already then
                local h = Instance.new("Highlight")
                h.Adornee   = v.Character
                h.FillColor = Color3.fromRGB(0, 255, 0)
                h.Parent    = v.Character
                table.insert(PlrHighlights, h)
            end
        end
    end
end

local function UpdateExitESP()
    for i = #ExitHighlights, 1, -1 do
        local h = ExitHighlights[i]
        if not T.exitESP or h.Adornee == nil then
            h:Destroy(); table.remove(ExitHighlights, i)
        end
    end
    if not T.exitESP then return end
    for _, v in pairs(game.Workspace:GetDescendants()) do
        if v.Name == "ExitDoor" then
            local already = false
            for _, h in pairs(ExitHighlights) do
                if h.Adornee == v then already = true; break end
            end
            if not already then
                local h = Instance.new("Highlight")
                h.Adornee   = v
                h.FillColor = Color3.fromRGB(150, 255, 0)
                h.Parent    = v
                table.insert(ExitHighlights, h)
            end
        end
    end
end

local function UpdatePodESP()
    for i = #PodHighlights, 1, -1 do
        local h = PodHighlights[i]
        if not T.podESP or h.Adornee == nil then
            h:Destroy(); table.remove(PodHighlights, i)
        end
    end
    if not T.podESP then return end
    for _, v in pairs(game.Workspace:GetDescendants()) do
        if v.Name == "FreezePod" then
            local already = false
            for _, h in pairs(PodHighlights) do
                if h.Adornee == v then already = true; break end
            end
            if not already then
                local h = Instance.new("Highlight")
                h.Adornee   = v
                h.FillColor = Color3.fromRGB(0, 150, 255)
                h.Parent    = v
                table.insert(PodHighlights, h)
            end
        end
    end
end

local function UpdateAllESP()
    UpdatePlrESP()
    UpdateBeastESP()
    UpdateExitESP()
    UpdatePodESP()
end

-- =============================================
-- MAIN LOOP
-- =============================================
task.spawn(function()
    while true do
        task.wait()

        -- Speed
        if IsThereChar() then
            if T.speedEnabled then
                LocalPlayer.Character.Humanoid.WalkSpeed = T.speedValue
            end

            -- Jump
            if T.jumpEnabled then
                LocalPlayer.Character.Humanoid.JumpPower = T.jumpValue
            end

            -- Fullbright
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if T.fullbright and not hrp:FindFirstChild("KH_FullBright") then
                    local light = Instance.new("PointLight", hrp)
                    light.Name       = "KH_FullBright"
                    light.Range      = math.huge
                    light.Brightness = 2.5
                    Lighting.GlobalShadows = false
                elseif not T.fullbright and hrp:FindFirstChild("KH_FullBright") then
                    hrp.KH_FullBright:Destroy()
                    Lighting.GlobalShadows = true
                end
            end

            -- Beast Crawl
            local char = LocalPlayer.Character
            if T.beastCrawl and char:FindFirstChild("CrawlScript") then
                char.CrawlScript.Enabled = true
            elseif char:FindFirstChild("BeastPowers") and char:FindFirstChild("CrawlScript") then
                char.CrawlScript.Enabled = false
            end

            -- Auto Remove Rope
            if T.autoRemoveRope and not LocalPlayer.Character:FindFirstChild("BeastPowers") then
                for _, v in pairs(Players:GetPlayers()) do
                    if IsThereChar(v) and v.Character:FindFirstChild("BeastPowers") then
                        for _, v2 in pairs(v.Character:GetDescendants()) do
                            if v2:IsA("RopeConstraint") then v2:Destroy() end
                        end
                    end
                end
            end
        end

        -- Anti PC Error
        if T.antiPCError then
            pcall(function()
                game.ReplicatedStorage.RemoteEvent:FireServer("SetPlayerMinigameResult", true)
            end)
        end

        -- Computer ESP
        local GotComputers = 0
        for _, v in pairs(game.Workspace:GetChildren()) do
            if v:FindFirstChild("MapThumbnail") then
                for _, v2 in pairs(v:GetChildren()) do
                    if v2.Name == "ComputerTable" and v2:FindFirstChild("Screen") then
                        GotComputers = GotComputers + 1
                        if T.computerESP then
                            local found = false
                            for _, h in pairs(PCHighlights) do
                                if h.Adornee == v2 then
                                    h.FillColor = v2.Screen.Color
                                    found = true
                                end
                            end
                            if not found then
                                local h = Instance.new("Highlight")
                                h.FillColor = v2.Screen.Color
                                h.Adornee   = v2
                                h.Parent    = v2
                                table.insert(PCHighlights, h)
                            end
                        else
                            clearHighlights(PCHighlights)
                        end
                    end
                end
            end
        end

        -- Auto refresh ESPs on round change
        if GotComputers ~= Comp then
            task.spawn(function()
                if GotComputers == 0 then
                    task.wait(1)
                    UpdatePlrESP()
                    UpdateExitESP()
                    UpdatePodESP()
                    UpdateBeastESP()
                else
                    task.wait(3)
                    UpdatePlrESP()
                    UpdateExitESP()
                    UpdatePodESP()
                    task.wait(15)
                    UpdateBeastESP()
                end
            end)
            Comp = GotComputers
        end
    end
end)

-- =============================================
-- SPEED/JUMP RESET ON DISABLE (call from GUI)
-- =============================================
local function OnSpeedDisabled()
    if IsThereChar() then
        LocalPlayer.Character.Humanoid.WalkSpeed = 16
    end
end

local function OnJumpDisabled()
    if IsThereChar() then
        LocalPlayer.Character.Humanoid.JumpPower = 50
    end
end

