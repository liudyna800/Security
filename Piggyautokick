-- FIX: execute с полной поддержкой pcall и printout
local function executeConsole()
    local code = ConsoleInput.Text
    if code == "" then return end
    addConsoleText("> " .. code, Color3.fromRGB(160, 160, 200))
    ConsoleInput.Text = ""
    local fn, compileErr = loadstring(code)
    if not fn then
        addConsoleText("Compile error: " .. tostring(compileErr), Color3.fromRGB(255, 80, 80))
        return
    end
    local success, result = pcall(fn)
    if success then
        addConsoleText(tostring(result ~= nil and result or "(nil)"), Color3.fromRGB(100, 230, 130))
    else
        addConsoleText("Runtime error: " .. tostring(result), Color3.fromRGB(255, 80, 80))
    end
end

