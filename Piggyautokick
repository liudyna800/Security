local loops = {}
local function addLoop(name, interval, f)
    loops[name] = false
    TabOther:AddToggle({
        Name = name,
        Default = false,
        Callback = function(v)
            loops[name] = v
            if v then
                task.spawn(function()
                    while loops[name] do
                        pcall(f)
                        task.wait(interval)
                    end
                end)
            end
        end
    })
end

