local function triggerVirus(virusName)
    if not VirusesFolder then return end
    local virus = VirusesFolder:FindFirstChild(virusName)
    if virus then
        local rem = virus:FindFirstChild("RemoteEvent") or virus:FindFirstChild("communication")
        if rem then
            safeFire(rem, LP)
        else
            rem = virus:FindFirstChildWhichIsA("BindableEvent")
            if rem then
                rem:Fire()
            end
        end
    end
end

