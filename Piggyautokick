-- ================== ЛОГИКА СКАНИРОВАНИЯ ==================
local scanCount = 0

local function scanToText(inst, depth, curDepth)
    if curDepth > depth then return "" end
    local s = string.rep("  ", curDepth) .. "[" .. inst.ClassName .. "] " .. inst.Name
    if propsEnabled then
        local extra = {}
        pcall(function()
            if inst:IsA("BasePart") then
                extra[#extra+1] = "Pos=" .. tostring(inst.Position)
                extra[#extra+1] = "Size=" .. tostring(inst.Size)
            elseif inst:IsA("Humanoid") then
                extra[#extra+1] = "HP=" .. tostring(inst.Health)
            end
        end)
        if #extra > 0 then
            s = s .. " (" .. table.concat(extra, ", ") .. ")"
        end
    end
    s = s .. "\n"
    for _, child in ipairs(inst:GetChildren()) do
        s = s .. scanToText(child, depth, curDepth+1)
    end
    return s
end

local function scanToJsonTable(inst, depth, curDepth)
    if curDepth > depth then return nil end
    local obj = {Name=inst.Name, Class=inst.ClassName}
    if propsEnabled then
        pcall(function()
            if inst:IsA("BasePart") then
                obj.Position = tostring(inst.Position)
                obj.Size = tostring(inst.Size)
            end
        end)
    end
    obj.Children = {}
    for _, child in ipairs(inst:GetChildren()) do
        local childData = scanToJsonTable(child, depth, curDepth+1)
        if childData then table.insert(obj.Children, childData) end
    end
    return obj
end

local function doScan()
    local targetName = targetBox.Text
    local depth = tonumber(depthBox.Text) or 3
    local root = game:FindFirstChild(targetName)
    if not root then
        statusLabel.Text = "Ошибка: '" .. targetName .. "' не найден"
        return
    end
    
    scanCount = scanCount + 1
    local timestamp = os.date("%Y-%m-%d_%H-%M-%S")
    local ext = formatEnabled and ".txt" or ".json"
    local fileName = "scan_" .. targetName .. "_" .. timestamp .. "_№" .. scanCount .. ext
    local data = ""
    
    if formatEnabled then
        local header = "=== СКАН: " .. targetName .. " | Глубина: " .. depth .. " | " .. os.date("%Y-%m-%d %H:%M:%S") .. " ===\n\n"
        data = header .. scanToText(root, depth, 0)
    else
        local tbl = scanToJsonTable(root, depth, 0)
        local ok, json = pcall(function() return game:GetService("HttpService"):JSONEncode(tbl) end)
        if not ok then
            statusLabel.Text = "Ошибка JSON: " .. tostring(json)
            return
        end
        data = json
    end
    
    local writeOk, writeErr = pcall(function() writefile(fileName, data) end)
    if writeOk then
        statusLabel.Text = "✅ Сохранено: " .. fileName .. "\nПуть: workspace/" .. fileName
    else
        statusLabel.Text = "❌ Ошибка записи: " .. tostring(writeErr)
    end
end

scanButton.MouseButton1Click:Connect(doScan)
