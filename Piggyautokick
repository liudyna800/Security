-- =============================================
-- BLACKLIST: сохранение через файл
-- =============================================
local BLACKLIST_FILE = "security_blacklist.json"
local blacklist = {}

local function saveBlacklist()
    pcall(function()
        local data = {}
        for name, _ in pairs(blacklist) do
            table.insert(data, name)
        end
        writefile(BLACKLIST_FILE, game:GetService("HttpService"):JSONEncode(data))
    end)
end

local function loadBlacklist()
    pcall(function()
        if isfile(BLACKLIST_FILE) then
            local raw = readfile(BLACKLIST_FILE)
            local data = game:GetService("HttpService"):JSONDecode(raw)
            for _, name in ipairs(data) do
                blacklist[name:lower()] = true
            end
        end
    end)
end

loadBlacklist()

-- =============================================
-- AUTO-KICK по блэклисту (фоновый поток)
-- =============================================
task.spawn(function()
    while true do
        task.wait(3)
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            if blacklist[player.Name:lower()] then
                for _, obj in ipairs(game:GetDescendants()) do
                    if obj:IsA("GuiButton") and obj.Name == "Kick" then
                        pcall(function()
                            if firesignal then
                                firesignal(obj.Activated)
                                firesignal(obj.MouseButton1Click)
                            else
                                obj:Click()
                            end
                        end)
                        break
                    end
                end
                task.wait(0.4)
                for _, obj in ipairs(game:GetDescendants()) do
                    if (obj:IsA("TextButton") or obj:IsA("ImageButton")) then
                        local nameMatch = obj.Name:lower():find(player.Name:lower())
                        local textMatch = obj:IsA("TextButton") and obj.Text:lower():find(player.Name:lower())
                        if nameMatch or textMatch then
                            pcall(function()
                                if firesignal then
                                    firesignal(obj.Activated)
                                    firesignal(obj.MouseButton1Click)
                                else
                                    obj:Click()
                                end
                            end)
                            break
                        end
                    end
                end
            end
        end
    end
end)

