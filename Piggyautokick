-- Перехват
local oldFireServer = hookfunction(Instance.new("RemoteEvent").FireServer, function(self, ...)
    if Settings.HookEnabled and not HookedRemotes[self] then
        HookedRemotes[self] = true
        addLog(string.format("[FireServer] %s (%s)", self:GetFullName(), serializeArgs({...})))
    end
    return oldFireServer(self, ...)
end)

local oldInvokeServer = hookfunction(Instance.new("RemoteFunction").InvokeServer, function(self, ...)
    local result = oldInvokeServer(self, ...)
    if Settings.HookEnabled and not HookedRemotes[self] then
        HookedRemotes[self] = true
        addLog(string.format("[InvokeServer] %s (%s) -> %s", self:GetFullName(), serializeArgs({...}), tostring(result)))
    end
    return result
end)

-- Функция сериализации
function serializeArgs(args)
    local parts = {}
    for i, v in ipairs(args) do
        local t = type(v)
        if t == "string" then parts[i] = string.format("%q", v)
        elseif t == "number" or t == "boolean" then parts[i] = tostring(v)
        elseif t == "nil" then parts[i] = "nil"
        elseif t == "userdata" then
            if typeof(v) == "Vector3" then parts[i] = string.format("Vector3.new(%s,%s,%s)", v.X, v.Y, v.Z)
            else parts[i] = tostring(v) end
        else parts[i] = tostring(v) end
    end
    return table.concat(parts, ", ")
end

