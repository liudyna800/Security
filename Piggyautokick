    local btn = Instance.new("TextButton")
    btn.Parent = TabBar
    btn.Text = name
    btn.Size = UDim2.new(0, 106, 1, 0)
    btn.Position = UDim2.new(0, (i-1)*113 + 5, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(18, 18, 30)
