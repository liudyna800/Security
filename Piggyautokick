-- =============================================
-- ANTICHEAT DETECT FLUSH
-- =============================================
local detectBuffer = {}

local function flushDetect(player)
    local uid = player.UserId
    local buf = detectBuffer[uid]
    if not buf or #buf.cheats == 0 then return end

    local displayName = player.DisplayName or player.Name
    local userName = player.Name
    local fullName = displayName .. " (@" .. userName .. ")"

    local cheatTypes = {}
    local details = {}
    local speedVal = nil
    for _, c in ipairs(buf.cheats) do
        table.insert(cheatTypes, c.cheatType)
        table.insert(details, c.reasonText)
        if c.speed then speedVal = c.speed end
    end
    local typesStr = table.concat(cheatTypes, " + ")
    local detailsStr = table.concat(details, "; ")

    local alertText = "DETECT[" .. typesStr .. "]: " .. fullName .. " | Reason: " .. detailsStr
    addLogMsgGlobal(alertText, true, userName)

    detectBuffer[uid] = nil
end

onCheatDetected = function(player, speed, reason)
    local speedRounded = speed > 0 and math.floor(speed * 10) / 10 or nil
    local reasonText = ""
    local cheatType = ""

    if reason == "SPEED_OVER_MAX" then
        reasonText = "speed " .. speedRounded .. " (above max " .. settings.sprintMax .. ")"
        cheatType = "SPEEDHACK"
    elseif reason == "SPEED_SUSTAINED" then
        reasonText = "speed " .. speedRounded .. " sustained for " .. settings.sprintTime .. "+ sec"
        cheatType = "SPEEDHACK"
    elseif reason == "FLY1" then
        reasonText = "Freefall/Jump state over 4 sec"
        cheatType = "FLYHACK"
        speedRounded = nil
    elseif reason == "FLY2" then
        reasonText = "body tilted over 4 sec"
        cheatType = "FLYHACK"
        speedRounded = nil
    end

    local uid = player.UserId
    if not detectBuffer[uid] then
        detectBuffer[uid] = {cheats = {}}
    end
    
    local alreadyHas = false
    for _, c in ipairs(detectBuffer[uid].cheats) do
        if c.cheatType == cheatType then alreadyHas = true; break end
    end
    if not alreadyHas then
        table.insert(detectBuffer[uid].cheats, {
            cheatType = cheatType,
            reasonText = reasonText,
            speed = speedRounded
        })
    end

    if detectBuffer[uid].thread then
        task.cancel(detectBuffer[uid].thread)
    end
    detectBuffer[uid].thread = task.delay(1, function()
        flushDetect(player)
    end)
end

-- =============================================
-- KICKING LOGIC (ИСправлены баги лагов и окон)
-- =============================================
local active = false
local lastKickOpen = 0
local kickCooldown = 2.0 -- Задержка между открытием меню
local menuOpened = false

local function fastClick(obj)
    pcall(function()
        if firesignal then firesignal(obj.Activated); firesignal(obj.MouseButton1Click)
        else obj:Click() end
    end)
end

task.spawn(function()
    while true do
        if active then
            local target = InputField.Text:lower():gsub("%s", "")
            if target == "" then
                StatusLabel.Text = "Error: Enter username!"
                task.wait(0.5)
            else
                -- 1. Проверяем, есть ли игрок на сервере
                local playerFound = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Name:lower():find(target) or p.DisplayName:lower():find(target) then
                        playerFound = true
                        break
                    end
                end

                if not playerFound then
                    StatusLabel.Text = "Status: Target not found!"
                    menuOpened = false
                    task.wait(1)
                else
                    -- 2. Если игрок есть, ищем только в своем PlayerGui, а не во всем game
                    local lpGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
                    if lpGui then
                        local targetFound = false
                        for _, obj in ipairs(lpGui:GetDescendants()) do
                            if not active then break end
                            if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and isGuiVisible(obj) then
                                local nameMatch = obj.Name:lower():find(target)
                                local textMatch = false
                                if obj:IsA("TextButton") then textMatch = obj.Text:lower():find(target) end
                                if nameMatch or textMatch then
                                    fastClick(obj); StatusLabel.Text = "CLICKED USERNAME!"
                                    targetFound = true; menuOpened = false; task.wait(0.5); break
                                end
                            end
                        end
                        -- Если ника на экране нет, пробуем нажать Kick
                        if not targetFound then
                            if not menuOpened or (tick() - lastKickOpen > kickCooldown) then
                                for _, obj in ipairs(lpGui:GetDescendants()) do
                                    if obj.Name == "Kick" and obj:IsA("GuiButton") and isGuiVisible(obj) then
                                        fastClick(obj); lastKickOpen = tick(); menuOpened = true
                                        StatusLabel.Text = "Opening menu..."; break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            StatusLabel.Text = "Status: Stopped"
            menuOpened = false
        end
        task.wait(0.25)
    end
end)

