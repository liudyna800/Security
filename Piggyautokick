-- ПОДСВЕТКА АКТИВНОГО РЕЖИМА
-- ═══════════════════════════════════════
local modeWraps = {
    select=wSelect, move=wMove, rotate=wRotate, scale=wScale
}

local function setHL(m)
    for k, w in pairs(modeWraps) do
        if k == m then
            w.BackgroundTransparency = 0.05
            stroke(w, C.yellow, 2)
        else
            w.BackgroundTransparency = 0.9
            -- убрать обводку
            local s = w:FindFirstChildWhichIsA("UIStroke")
            if s then s:Destroy() end
        end
    end
end

-- ═══════════════════════════════════════
-- COMMIT
-- ═══════════════════════════════════════
local function commitMove(model)
    if not model or not model.Parent or not rfCommitMove then return end
    local pp = getPP(model)
    if pp then pcall(rfCommitMove.InvokeServer, rfCommitMove, model, pp.CFrame) end
end

local function commitResize(model, sz)
    if not model or not model.Parent or not rfCommitResize then return end
    pcall(rfCommitResize.InvokeServer, rfCommitResize, model, sz)
end

-- ═══════════════════════════════════════
-- INFO UPDATE
-- ═══════════════════════════════════════
local function updateInfo()
    if not sel or not sel.Parent then return end
    local pp = getPP(sel)
    if not pp then return end
    local p       = pp.Position
    local s       = pp.Size
    local rx,ry,rz = pp.CFrame:ToEulerAnglesXYZ()  -- БАГ4 FIX: один вызов
    local function f(n) return math.floor(n*100)/100 end
    rowPos.Text = string.format("%.1f, %.1f, %.1f", f(p.X), f(p.Y), f(p.Z))
    rowSz.Text  = string.format("%.1f, %.1f, %.1f", f(s.X), f(s.Y), f(s.Z))
    rowRot.Text = string.format("%d°, %d°, %d°",
        math.floor(math.deg(rx)),
        math.floor(math.deg(ry)),
        math.floor(math.deg(rz)))
end

