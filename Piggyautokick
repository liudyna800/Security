local function makePage()
    local page = Instance.new("Frame")
    page.Parent = MainFrame
    page.BackgroundTransparency = 1
    page.Size = UDim2.new(1, 0, 1, -78)
    page.Position = UDim2.new(0, 0, 0, 78)
    page.Visible = false
    return page
end

for i = 1, #tabNames do
    tabPages[i] = makePage()
end
tabPages[1].Visible = true

-- TAB SWITCHING
local function switchTab(idx)
    for i, page in ipairs(tabPages) do
        page.Visible = (i == idx)
        local btn = tabButtons[i]
        if i == idx then
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
            btn.TextColor3 = Color3.fromRGB(0, 170, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(18, 18, 30)
            btn.TextColor3 = Color3.fromRGB(130, 130, 160)
        end
    end
end

for i, btn in ipairs(tabButtons) do
    btn.MouseButton1Click:Connect(function() switchTab(i) end)
end

