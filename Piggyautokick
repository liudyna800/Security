--[[
    MEGA HUB FOR MURDER MYSTERY 2
    Работает на Orion UI, для Delta X, CodeX и других исполнителей
    Содержит ESP, Aimbot, Auto Farm, God Mode, TP и многое другое
--]]

-- Загрузка библиотеки интерфейса
local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua'))()
local Window = OrionLib:MakeWindow({
    Name = "MM2 Mega Hub | v1.0",
    HidePremium = false,
    SaveConfig = false,
    ConfigFolder = "MM2_Config"
})

-- Общие переменные и функции
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- Функция для получения персонажа (с ожиданием)
local function getCharacter()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.CharacterAdded:Wait()
        character = LocalPlayer.Character
    end
    return character
end

-- Создание вкладок
local MainTab = Window:MakeTab({Name = "Главная", Icon = "rbxassetid://4483345998", PremiumOnly = false})
local AimbotTab = Window:MakeTab({Name = "Аимбот и бой", Icon = "rbxassetid://4483345998", PremiumOnly = false})
local FarmTab = Window:MakeTab({Name = "Ферма", Icon = "rbxassetid://4483345998", PremiumOnly = false})
local EspTab = Window:MakeTab({Name = "Визуалы (ESP)", Icon = "rbxassetid://4483345998", PremiumOnly = false})
local TeleportTab = Window:MakeTab({Name = "Телепорты", Icon = "rbxassetid://4483345998", PremiumOnly = false})
local MiscTab = Window:MakeTab({Name = "Разное", Icon = "rbxassetid://4483345998", PremiumOnly = false})

-- =================== ВКЛАДКА ГЛАВНАЯ (GODMODE, SPEED, NOCLIP) ===================
MainTab:AddLabel("⚡ Основные усиления")
MainTab:AddToggle({Name = "Бессмертие (Godmode)", Default = false, Callback = function(val)
    getCharacter().Humanoid.MaxHealth = math.huge
    getCharacter().Humanoid.Health = math.huge
    while val do
        task.wait(0.5)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.Health = math.huge
        end
    end
end})

MainTab:AddToggle({Name = "Ноклип (Хождение сквозь стены)", Default = false, Callback = function(val)
    local function noclipLoop()
        if val then
            for _, part in ipairs(getCharacter():GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
            task.wait(0.1)
        end
    end
    while val do noclipLoop() end
end})

MainTab:AddSlider({Name = "Скорость ходьбы", Min = 16, Max = 200, Default = 16, Color = Color3.fromRGB(0, 255, 0), Increment = 1, ValueName = "ед.", Callback = function(val)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = val
    end
end})

MainTab:AddSlider({Name = "Высота прыжка", Min = 50, Max = 500, Default = 50, Color = Color3.fromRGB(255, 255, 0), Increment = 1, ValueName = "ед.", Callback = function(val)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.JumpPower = val
    end
end})

MainTab:AddToggle({Name = "Бесконечные прыжки", Default = false, Callback = function(val)
    local function infiniteJump()
        if val and getCharacter():FindFirstChild("Humanoid") then
            getCharacter().Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
    while val do infiniteJump() task.wait(0.01) end
end})

MainTab:AddToggle({Name = "Режим полёта (Fly)", Default = false, Callback = function(val)
    -- Простая реализация полёта через BodyVelocity
    local bodyVel = nil
    if val then
        local char = getCharacter()
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.Velocity = Vector3.new(0, 0, 0)
        bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVel.Parent = char.HumanoidRootPart
        while val do
            task.wait(0.01)
            local moveDir = (char.HumanoidRootPart.CFrame.LookVector * (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) + char.HumanoidRootPart.CFrame.RightVector * (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - char.HumanoidRootPart.CFrame.RightVector * (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)) * 50
            bodyVel.Velocity = Vector3.new(moveDir.X, (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 50 or (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and -50 or 0)), moveDir.Z)
        end
        bodyVel:Destroy()
    else
        if bodyVel then bodyVel:Destroy() end
    end
end})

-- =================== ВКЛАДКА АИМБОТ И БОЙ ===================
AimbotTab:AddLabel("🎯 Боевые функции (только для маньяка/шерифа)")
AimbotTab:AddButton({Name = "Убить маньяка (будучи шерифом)", Callback = function()
    local gun = nil
    for _, v in ipairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Tool") and v.Name:lower():find("gun") then gun = v break end
    end
    if not gun then OrionLib:MakeNotification({Name = "Ошибка", Content = "У вас нет оружия!", Time = 2}) return end

    -- Поиск маньяка
    local murderer = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
            murderer = player
            break
        end
    end
    if murderer and murderer.Character then
        LocalPlayer.Character.HumanoidRootPart.CFrame = murderer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 5)
        task.wait(0.1)
        gun:Activate()
        OrionLib:MakeNotification({Name = "Атака", Content = "Маньяк ликвидирован!", Time = 2})
    else
        OrionLib:MakeNotification({Name = "Ошибка", Content = "Маньяк не найден", Time = 2})
    end
end})

AimbotTab:AddButton({Name = "Убить всех (будучи маньяком)", Callback = function()
    local knife = nil
    for _, v in ipairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Tool") and v.Name:lower():find("knife") then knife = v break end
    end
    if not knife then OrionLib:MakeNotification({Name = "Ошибка", Content = "У вас нет ножа!", Time = 2}) return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            LocalPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            task.wait(0.05)
            knife:Activate()
            task.wait(0.1)
        end
    end
    OrionLib:MakeNotification({Name = "Атака", Content = "Все игроки убиты!", Time = 2})
end})

AimbotTab:AddButton({Name = "Телепорт к оружию (пистолету)", Callback = function()
    -- Ищем пистолет (gun) на земле
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Tool") and v.Name:lower():find("gun") and v.Parent ~= LocalPlayer.Character then
            LocalPlayer.Character.HumanoidRootPart.CFrame = v.Handle.CFrame * CFrame.new(0, 1, 0)
            OrionLib:MakeNotification({Name = "Телепорт", Content = "Вы у оружия!", Time = 2})
            return
        end
    end
    OrionLib:MakeNotification({Name = "Ошибка", Content = "Оружие не найдено", Time = 2})
end})

AimbotTab:AddToggle({Name = "Автоматический подбор оружия", Default = false, Callback = function(val)
    while val do
        task.wait(0.5)
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Tool") and v.Name:lower():find("gun") and v.Parent ~= LocalPlayer.Character then
                LocalPlayer.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                task.wait(0.2)
                fireproximityprompt(v:FindFirstChildOfClass("ProximityPrompt"), 0)
            end
        end
    end
end})

-- =================== ВКЛАДКА ФЕРМА ===================
FarmTab:AddLabel("💰 Автоматическая фарма")
FarmTab:AddToggle({Name = "Автофарм монет (Beach Balls)", Default = false, Callback = function(val)
    while val do
        task.wait(0.5)
        for _, v in ipairs(workspace:GetDescendants()) do
            if v.Name == "BeachBall" or v.Name == "Coin" or v.Name == "CoinContainer" then
                if v:IsA("BasePart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
                elseif v:IsA("Tool") and v:FindFirstChild("Handle") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                end
                task.wait(0.1)
            end
        end
    end
end})

FarmTab:AddToggle({Name = "Автоферма опыта (XP)", Default = false, Callback = function(val)
    while val do
        task.wait(0.1)
        -- Симулируем активность для получения опыта
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid:Move(Vector3.new(math.random(-1, 1), 0, math.random(-1, 1)), true)
        end
    end
end})

FarmTab:AddButton({Name = "Собрать все монеты (разово)", Callback = function()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "BeachBall" or v.Name == "Coin" then
            if v:IsA("BasePart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
            elseif v:IsA("Tool") and v:FindFirstChild("Handle") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
            end
            task.wait(0.05)
        end
    end
end})

-- =================== ВКЛАДКА ВИЗУАЛЫ (ESP) ===================
EspTab:AddLabel("👁️ Визуальные читы")
EspTab:AddToggle({Name = "ESP игроков (Boxes)", Default = false, Callback = function(val)
    while val do
        task.wait(0.1)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                local head = player.Character.Head
                -- Создаём или обновляем BillboardGui над головой
                local gui = head:FindFirstChild("ESP_Gui")
                if not gui then
                    gui = Instance.new("BillboardGui")
                    gui.Name = "ESP_Gui"
                    gui.Size = UDim2.new(0, 100, 0, 30)
                    gui.StudsOffset = Vector3.new(0, 2, 0)
                    gui.Parent = head
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 0.5
                    label.Text = player.Name
                    label.TextColor3 = Color3.new(1, 1, 1)
                    label.BackgroundColor3 = Color3.new(0, 0, 0)
                    label.Parent = gui
                end
            end
        end
    end
    -- Очистка GUI при выключении
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("Head") then
            local gui = player.Character.Head:FindFirstChild("ESP_Gui")
            if gui then gui:Destroy() end
        end
    end
end})

EspTab:AddToggle({Name = "Чамсы (подсветка игроков)", Default = false, Callback = function(val)
    local highlightList = {}
    while val do
        task.wait(0.5)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if not highlightList[player.UserId] then
                    local highlight = Instance.new("Highlight")
                    highlight.Parent = player.Character
                    highlight.FillColor = player.Backpack:FindFirstChild("Knife") and Color3.new(1, 0, 0) or (player.Backpack:FindFirstChild("Gun") and Color3.new(0, 0, 1) or Color3.new(0, 1, 0))
                    highlightList[player.UserId] = highlight
                end
            end
        end
    end
    -- Очистка
    for _, highlight in pairs(highlightList) do highlight:Destroy() end
end})

