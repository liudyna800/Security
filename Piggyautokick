local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"))()
local Window = OrionLib:MakeWindow({
    Name = "ZOMBIE LAB HUB",
    HidePremium = false,
    SaveConfig = false,
    ConfigFolder = "ZombieLab_Config"
})

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local WS = game:GetService("Workspace")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- Удобная функция получения персонажа
local function getChar()
    return LP.Character or LP.CharacterAdded:Wait()
end

-- Поиск всех зомби (обычно это модель NPC с Humanoid)
local function getZombies()
    local zombies = {}
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") then
            -- Отсеиваем своих игроков
            local isPlayer = false
            for _, pl in ipairs(Players:GetPlayers()) do
                if pl.Character == obj then
                    isPlayer = true
                    break
                end
            end
            if not isPlayer then
                table.insert(zombies, obj)
            end
        end
    end
    return zombies
end

-- Вкладки
local MainTab = Window:MakeTab({Name = "Главная"})
local CombatTab = Window:MakeTab({Name = "Бой/Оружие"})
local FarmTab = Window:MakeTab({Name = "Фарм"})
local VisualsTab = Window:MakeTab({Name = "Визуал"})
local WorldTab = Window:MakeTab({Name = "Волны/Мир"})
local MiscTab = Window:MakeTab({Name = "Прочее"})

-- ================== ГЛАВНАЯ ==================
MainTab:AddLabel("Основные читы")

MainTab:AddToggle({
    Name = "God Mode (Бесконечное HP)",
    Default = false,
    Callback = function(val)
        while val do
            local char = getChar()
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.MaxHealth = math.huge
                char.Humanoid.Health = math.huge
                task.wait(0.3)
            end
        end
    end
})

MainTab:AddToggle({
    Name = "NoClip (Сквозь стены)",
    Default = false,
    Callback = function(val)
        while val do
            local char = getChar()
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            task.wait(0.1)
        end
    end
})

MainTab:AddSlider({
    Name = "Скорость передвижения",
    Min = 16, Max = 200, Default = 16,
    Color = Color3.fromRGB(0, 255, 0),
    Increment = 1, ValueName = "studs/s",
    Callback = function(val)
        getChar().Humanoid.WalkSpeed = val
    end
})

MainTab:AddSlider({
    Name = "Прыжок",
    Min = 50, Max = 300, Default = 50,
    Color = Color3.fromRGB(255, 255, 0),
    Increment = 1, ValueName = "power",
    Callback = function(val)
        getChar().Humanoid.JumpPower = val
    end
})

-- ================== БОЙ/ОРУЖИЕ ==================
CombatTab:AddLabel("Оружие и убийство зомби")

CombatTab:AddToggle({
    Name = "Infinite Ammo (Беск. патроны)",
    Default = false,
    Callback = function(val)
        while val do
            local char = getChar()
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AmmoValue")
                    if ammo and ammo:IsA("IntValue") or ammo:IsA("NumberValue") then
                        ammo.Value = 9999
                    end
                end
            end
            task.wait(0.5)
        end
    end
})

CombatTab:AddButton({
    Name = "Kill All Zombies (убить всех зомби)",
    Callback = function()
        local zombies = getZombies()
        for _, z in ipairs(zombies) do
            z.Humanoid.Health = 0
        end
        OrionLib:MakeNotification({Name = "Резня", Content = #zombies .. " зомби убито", Time = 2})
    end
})

CombatTab:AddButton({
    Name = "Дать всё оружие (спавн)",
    Callback = function()
        -- Попытка через ремонтажные события
        local giveEvent = RS:FindFirstChild("GiveWeapon") or RS:FindFirstChild("GiveTool") or RS:FindFirstChild("WeaponEvent")
        if giveEvent and giveEvent:IsA("RemoteEvent") then
            giveEvent:FireServer("All")
            OrionLib:MakeNotification({Name = "Оружие", Content = "Запрос отправлен", Time = 2})
        else
            OrionLib:MakeNotification({Name = "Ошибка", Content = "Событие не найдено, пробуйте другие функции", Time = 2})
        end
    end
})

CombatTab:AddToggle({
    Name = "Auto Aim (автоприцеливание на зомби)",
    Default = false,
    Callback = function(val)
        while val do
            local char = getChar()
            local nearestZombie, minDist = nil, 50
            for _, z in ipairs(getZombies()) do
                if z:FindFirstChild("Head") then
                    local dist = (z.Head.Position - char.HumanoidRootPart.Position).Magnitude
                    if dist < minDist then
                        nearestZombie = z.Head
                        minDist = dist
                    end
                end
            end
            if nearestZombie then
                task.spawn(function()
                    fireclickdetector(nearestZombie:FindFirstChildOfClass("ClickDetector"))
                end)
                -- Поворачиваем персонажа к цели
                char.HumanoidRootPart.CFrame = CFrame.lookAt(char.HumanoidRootPart.Position, nearestZombie.Position)
            end
            task.wait()
        end
    end
})

-- ================== ФАРМ ==================
FarmTab:AddLabel("Автофарм монет/валюты")

FarmTab:AddToggle({
    Name = "Auto Collect Money (подбирать деньги)",
    Default = false,
    Callback = function(val)
        while val do
            local char = getChar()
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj.Name == "Money" or obj.Name == "Coin" or obj.Name == "Cash" then
                    if obj:IsA("BasePart") then
                        char.HumanoidRootPart.CFrame = obj.CFrame
                        task.wait(0.1)
                    elseif obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                        char.HumanoidRootPart.CFrame = obj.Handle.CFrame
                        task.wait(0.1)
                    end
                end
            end
            task.wait(0.5)
        end
    end
})

FarmTab:AddToggle({
    Name = "Auto Farm XP (опыт)",
    Default = false,
    Callback = function(val)
        while val do
            -- Пробуем подбирать объекты опыта или убивать зомби
            local zombies = getZombies()
            if #zombies > 0 then
                for _, z in ipairs(zombies) do
                    z.Humanoid.Health = 0
                    task.wait(0.1)
                end
            end
            task.wait(2)
        end
    end
})

FarmTab:AddToggle({
    Name = "Auto Upgrade (автопрокачка)",
    Default = false,
    Callback = function(val)
        while val do
            local char = getChar()
            for _, btn in ipairs(WS:GetDescendants()) do
                if (btn.Name == "Upgrade" or btn.Name == "Buy") and btn:IsA("ProximityPrompt") then
                    fireproximityprompt(btn)
                end
            end
            task.wait(1)
        end
    end
})

-- ================== ВИЗУАЛ ==================
VisualsTab:AddLabel("ESP и настройки видимости")

VisualsTab:AddToggle({
    Name = "ESP Zombies (подсветка зомби)",
    Default = false,
    Callback = function(val)
        local highlights = {}
        while val do
            for _, z in ipairs(getZombies()) do
                if not highlights[z] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = z
                    highlights[z] = hl
                end
            end
            -- Удаляем подсветку с мёртвых
            for z, hl in pairs(highlights) do
                if not z.Parent or z.Humanoid.Health <= 0 then
                    hl:Destroy()
                    highlights[z] = nil
                end
            end
            task.wait(2)
        end
        -- очистка при выключении
        for _, hl in pairs(highlights) do hl:Destroy() end
    end
})

VisualsTab:AddToggle({
    Name = "ESP Items (подсветка лута)",
    Default = false,
    Callback = function(val)
        local itemList = {}
        while val do
            for _, obj in ipairs(WS:GetDescendants()) do
                if (obj.Name == "Money" or obj.Name == "Coin" or obj.Name == "Weapon" or obj.Name == "Loot") and obj:IsA("BasePart") then
                    if not obj:FindFirstChild("ESP_Highlight") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "ESP_Highlight"
                        hl.FillColor = Color3.fromRGB(0, 255, 0)
                        hl.Parent = obj
                        itemList[obj] = hl
                    end
                end
            end
            task.wait(3)
        end
        for _, hl in pairs(itemList) do hl:Destroy() end
    end
})

VisualsTab:AddToggle({
    Name = "Full Bright (яркий свет)",
    Default = false,
    Callback = function(val)
        local lighting = game:GetService("Lighting")
        if val then
            lighting.Brightness = 2
            lighting.GlobalShadows = false
            lighting.FogEnd = 1e6
        else
            lighting.Brightness = 1
            lighting.GlobalShadows = true
            lighting.FogEnd = 10000
        end
    end
})

-- ================== ВОЛНЫ/МИР ==================
WorldTab:AddLabel("Управление волнами")

WorldTab:AddButton({
    Name = "Пропустить текущую волну",
    Callback = function()
        local waveEvent = RS:FindFirstChild("NextWave") or RS:FindFirstChild("SkipWave")
        if waveEvent and waveEvent:IsA("RemoteEvent") then
            waveEvent:FireServer()
            OrionLib:MakeNotification({Name = "Волна", Content = "Пропущена", Time = 2})
        else
            OrionLib:MakeNotification({Name = "Ошибка", Content = "Не удалось пропустить", Time = 2})
        end
    end
})

WorldTab:AddButton({
    Name = "Установить волну 99 (макс)",
    Callback = function()
        -- Попытка изменить номер волны через NumberValue
        for _, val in ipairs(WS:GetDescendants()) do
            if val.Name == "Wave" or val.Name == "WaveNumber" then
                if val:IsA("IntValue") or val:IsA("NumberValue") then
                    val.Value = 99
                end
            end
        end
        OrionLib:MakeNotification({Name = "Волна", Content = "Установлена волна 99", Time = 2})
    end
})

WorldTab:AddButton({
    Name = "Убрать всех зомби навсегда",
    Callback = function()
        task.spawn(function()
            while true do
                for _, z in ipairs(getZombies()) do
                    z:Destroy()
                end
                task.wait(0.5)
            end
        end)
        OrionLib:MakeNotification({Name = "Геноцид", Content = "Зомби удаляются бесконечно", Time = 2})
    end
})

-- ================== ПРОЧЕЕ ==================
MiscTab:AddLabel("Дополнительно")
MiscTab:AddButton({
    Name = "Телепорт к торговому автомату",
    Callback = function()
        for _, obj in ipairs(WS:GetDescendants()) do
            if obj.Name:lower():find("shop") or obj.Name:lower():find("vendor") then
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    getChar().HumanoidRootPart.CFrame = obj.PrimaryPart.CFrame + Vector3.new(0,3,0)
                    return
                end
            end
        end
    end
})

MiscTab:AddButton({
    Name = "Телепорт к столу улучшений",
    Callback = function()
        for _, obj in ipairs(WS:GetDescendants()) do
            if obj.Name:lower():find("upgrade") and (obj:IsA("BasePart") or obj:IsA("Model")) then
                getChar().HumanoidRootPart.CFrame = obj:IsA("Model") and obj.PrimaryPart.CFrame + Vector3.new(0,3,0) or obj.CFrame + Vector3.new(0,3,0)
                return
            end
        end
    end
})

MiscTab:AddToggle({
    Name = "Anti-AFK (анти бездействие)",
    Default = false,
    Callback = function(val)
        while val do
            getChar().HumanoidRootPart.CFrame = getChar().HumanoidRootPart.CFrame * CFrame.new(0, 0, 0)
            task.wait(60)
        end
    end
})

