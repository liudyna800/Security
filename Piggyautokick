-- Для удобства
local function makeLabel(parent, text, position, size)
    local l = Instance.new("TextLabel", parent)
    l.Text = text
    l.Position = position
    l.Size = size
    l.Font = Enum.Font.SourceSans
    l.TextSize = 14
    l.TextColor3 = Color3.new(1,1,1)
    l.BackgroundTransparency = 1
    return l
end

local function makeButton(parent, text, position, size, callback)
    local b = Instance.new("TextButton", parent)
    b.Text = text
    b.Position = position
    b.Size = size
    b.Font = Enum.Font.SourceSans
    b.TextSize = 14
    b.TextColor3 = Color3.new(1,1,1)
    b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.MouseButton1Click:Connect(callback)
    b.TouchTap:Connect(callback) -- для телефона
    return b
end

local function makeTextBox(parent, placeholder, position, size)
    local t = Instance.new("TextBox", parent)
    t.PlaceholderText = placeholder
    t.Text = ""
    t.Position = position
    t.Size = size
    t.Font = Enum.Font.SourceSans
    t.TextSize = 14
    t.TextColor3 = Color3.new(0,0,0)
    t.BackgroundColor3 = Color3.new(1,1,1)
    t.BorderSizePixel = 1
    return t
end

