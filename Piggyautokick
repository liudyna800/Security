local function loadOrion(url)
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        return result
    else
        warn("Ошибка загрузки Orion из " .. url .. ": " .. tostring(result))
        return nil
    end
end

OrionLib = loadOrion(mainURL)
if not OrionLib then
    warn("Пробуем запасную ссылку...")
    OrionLib = loadOrion(fallbackURL)
end

