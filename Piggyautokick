------------------- ESP TAB -------------------
local ESPEnabled = false
local ESPConnections = {}
local function clearESP()
    for _, conn in ipairs(ESPConnections) do
        conn:Disconnect()
    end
    ESPConnections = {}
end

local function createESP(player)
    local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ESP_"..player.Name
    screenGui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 50)
    frame.BackgroundColor3 = Color3.fromRGB(0,0,0)
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Parent = screenGui

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1,0,0,20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
    nameLabel.Font = Enum.Font.SourceSans
    nameLabel.TextSize = 14
    nameLabel.Parent = frame

    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Size = UDim2.new(1,0,0,20)
    distanceLabel.Position = UDim2.new(0,0,0,20)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.TextColor3 = Color3.fromRGB(200,200,200)
    distanceLabel.Font = Enum.Font.SourceSans
    distanceLabel.TextSize = 13
    distanceLabel.Parent = frame

    local roleLabel = Instance.new("TextLabel")
    roleLabel.Size = UDim2.new(1,0,0,20)
    roleLabel.Position = UDim2.new(0,0,0,30)
    roleLabel.BackgroundTransparency = 1
    roleLabel.TextColor3 = Color3.fromRGB(255,0,0)
    roleLabel.Font = Enum.Font.SourceSans
    roleLabel.TextSize = 13
    roleLabel.Parent = frame

    local runservice = game:GetService("RunService")
    local localPlayer = game.Players.LocalPlayer

    local connection = runservice.RenderStepped:Connect(function()
        if not ESPEnabled then
            frame.Visible = false
            return
        end
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            frame.Visible = false
            return
        end
        local rootPart = player.Character.HumanoidRootPart
        local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if localRoot then
            local distance = (rootPart.Position - localRoot.Position).Magnitude
            distanceLabel.Text = math.floor(distance) .. " studs"
        else
            distanceLabel.Text = "?"
        end

        -- Determine role (rough)
        local role = "Unknown"
        if player.Backpack then
            -- Sheriff has gun tool named "SheriffPistol" or "Gun"
            if player.Backpack:FindFirstChild("SheriffPistol") or player.Character:FindFirstChild("SheriffPistol") then
                role = "Sheriff"
            elseif player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife") then
                role = "Murderer"
            else
                role = "Innocent"
            end
        end
        roleLabel.Text = role
        if role == "Murderer" then
            roleLabel.TextColor3 = Color3.fromRGB(255,0,0)
        elseif role == "Sheriff" then
            roleLabel.TextColor3 = Color3.fromRGB(0,180,255)
        else
            roleLabel.TextColor3 = Color3.fromRGB(0,255,0)
        end

        -- Position frame on screen based on world point
        local worldPos = rootPart.Position
        local camera = workspace.CurrentCamera
        local screenPos, onScreen = camera:WorldToScreenPoint(worldPos)
        if onScreen then
            frame.Visible = true
            frame.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - 40)
        else
            frame.Visible = false
        end
    end)
    table.insert(ESPConnections, connection)
end

local function enableESP()
    local players = game:GetService("Players")
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= players.LocalPlayer then
            createESP(player)
        end
    end
end

local function disableESP()
    clearESP()
    for _, gui in ipairs(game.Players.LocalPlayer.PlayerGui:GetChildren()) do
        if gui.Name:sub(1,4) == "ESP_" then
            gui:Destroy()
        end
    end
end

ESPTab:AddToggle({
    Name = "Enable ESP",
    Default = false,
    Callback = function(Value)
        ESPEnabled = Value
        if Value then
            enableESP()
        else
            disableESP()
        end
    end
})

