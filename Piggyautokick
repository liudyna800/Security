    end
})

BeastTab:AddToggle({
    Name = "Crawl Mode (ускорение)",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = 100
                char.Humanoid.CameraOffset = Vector3.new(0, -2, 0)
            end
            task.wait(0.5)
        end
    end
})

-- ================== ВИЗУАЛ ==================
VisualsTab:AddLabel("ESP на всех")
VisualsTab:AddToggle({
    Name = "ESP Computers",
    Default = false,
    Callback = function(v)
        local list = {}
        while v do
            for _, obj in ipairs(WS:GetDescendants()) do
                if (obj.Name == "Computer" or obj.Name == "HackComputer") and obj:IsA("BasePart") then
                    if not list[obj] then
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(0, 100, 255)
                        hl.Parent = obj
                        list[obj] = hl
                    end
                end
            end
            task.wait(1)
        end
        for _, hl in pairs(list) do hl:Destroy() end
    end
})

VisualsTab:AddToggle({
    Name = "ESP Players",
    Default = false,
    Callback = function(v)
        local list = {}
        while v do
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character and not list[p.UserId] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = p.Character:FindFirstChild("Beast") and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                    hl.Parent = p.Character
                    list[p.UserId] = hl
                end
            end
            task.wait(2)
        end
        for _, hl in pairs(list) do hl:Destroy() end
    end
})

VisualsTab:AddToggle({
    Name = "ESP Exits",
    Default = false,
    Callback = function(v)
        local list = {}
        while v do
            for _, obj in ipairs(WS:GetDescendants()) do
                if (obj.Name == "ExitDoor" or obj.Name == "EscapeDoor") and obj:IsA("BasePart") and not list[obj] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(255, 215, 0)
                    hl.Parent = obj
                    list[obj] = hl
                end
            end
            task.wait(2)
        end
        for _, hl in pairs(list) do hl:Destroy() end
    end
})

VisualsTab:AddToggle({
    Name = "ESP Pods",
    Default = false,
    Callback = function(v)
        local list = {}
        while v do
            for _, obj in ipairs(WS:GetDescendants()) do
                if (obj.Name == "FreezePod" or obj.Name == "FrozenPlayer") and obj:IsA("BasePart") and not list[obj] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(100, 200, 255)
                    hl.Parent = obj
                    list[obj] = hl
                end
            end
            task.wait(2)
        end
        for _, hl in pairs(list) do hl:Destroy() end
    end
