-- ЛОГИКА РАБОТЫ
local active = false
local lastKickOpen = 0
local kickCooldown = 1.0 -- Пауза между нажатиями на "Kick", чтобы не плодить окна

local function fastClick(obj)
    pcall(function()
        -- Жмем всеми возможными способами сразу
        if firesignal then
            firesignal(obj.Activated)
            firesignal(obj.MouseButton1Click)
        else
            -- Для простых исполнителей
            obj:Click() 
        end
    end)
end

task.spawn(function()
    while true do
        if active then
            local target = InputField.Text:lower()
            if target == "" then 
                StatusLabel.Text = "Ошибка: Введите ник!"
                task.wait(0.5)
            else
                local targetFound = false
                
                -- ШАГ 1: Ищем цель по всему Explorer
                for _, obj in ipairs(game:GetDescendants()) do
                    if not active then break end
                    
                    if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                        -- Проверяем текст или имя на наличие ника
                        local nameMatch = obj.Name:lower():find(target)
                        local textMatch = false
                        if obj:IsA("TextButton") then
                            textMatch = obj.Text:lower():find(target)
                        end
                        
                        if nameMatch or textMatch then
                            fastClick(obj)
                            StatusLabel.Text = "🎯 КЛИК ПО НИКУ!"
                            targetFound = true
                            task.wait(0.5) -- Пауза после успешного кика
                            break
                        end
                    end
                end
                
                -- ШАГ 2: Если ник не нашли, открываем меню кнопкой Kick
                if not targetFound then
                    if tick() - lastKickOpen > kickCooldown then
                        for _, obj in ipairs(game:GetDescendants()) do
                            if obj.Name == "Kick" and (obj:IsA("GuiButton")) then
                                fastClick(obj)
                                lastKickOpen = tick()
                                StatusLabel.Text = "📂 Открываем меню..."
                                break
                            end
                        end
                    end
                end
            end
        else
            StatusLabel.Text = "Статус: Остановлен"
        end
        task.wait(0.1) -- Скорость работы цикла
    end
end)

StartBtn.MouseButton1Click:Connect(function()
    active = true
    print("--- ЗАПУЩЕНО ---")
end)

StopBtn.MouseButton1Click:Connect(function()
    active = false
    print("--- ОСТАНОВЛЕНО ---")
end)
