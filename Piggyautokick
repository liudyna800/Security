-- ═══════════════════════════════════════
-- ОЧИСТКА ХЕНДЛОВ  (БАГ1 + БАГ5 FIX)
-- ═══════════════════════════════════════
local function clearHandles()
    if hMove   then hMove:Destroy();   hMove   = nil end
    if hRotate then hRotate:Destroy(); hRotate = nil end

    -- БАГ1 FIX: disconnect scaleConn отдельно
    if scaleConn then scaleConn:Disconnect(); scaleConn = nil end

    -- БАГ5 FIX: disconnect InputEnded листенер
    if inputEndedConn then inputEndedConn:Disconnect(); inputEndedConn = nil end

    for _, s in ipairs(hScaleList) do s:Destroy() end
    hScaleList = {}

    if selBox then selBox:Destroy(); selBox = nil end
end

-- ═══════════════════════════════════════
-- FACES для Scale
-- ═══════════════════════════════════════
local FACES = {
    {norm = Vector3.new( 1, 0, 0), id = Enum.NormalId.Right},
    {norm = Vector3.new(-1, 0, 0), id = Enum.NormalId.Left},
    {norm = Vector3.new( 0, 1, 0), id = Enum.NormalId.Top},
    {norm = Vector3.new( 0,-1, 0), id = Enum.NormalId.Bottom},
    {norm = Vector3.new( 0, 0, 1), id = Enum.NormalId.Back},
    {norm = Vector3.new( 0, 0,-1), id = Enum.NormalId.Front},
}

-- ═══════════════════════════════════════
-- РЕЖИМ MOVE
-- ═══════════════════════════════════════
local function applyMoveMode(model)
    makeSelBox(model, modeColor.move)
    local pp = getPP(model)
    if not pp then return end

    hMove = Instance.new("Handles")
    hMove.Adornee = pp
    hMove.Color3  = modeColor.move
    hMove.Style   = Enum.HandlesStyle.Movement
    hMove.Parent  = workspace

    local startPos = nil
    local startRot = nil  -- БАГ7 FIX: сохраняем ротацию отдельно

    hMove.MouseButton1Down:Connect(function()
        dragActive = true
        local cf   = getCF(model)
        startPos   = cf.Position
        startRot   = cf.Rotation  -- только поворот, без позиции
    end)

    hMove.MouseDrag:Connect(function(face, distance)
        if not dragActive or not startPos or not model.Parent then return end
        -- БАГ3 FIX: используем .Rotation вместо CFrame - Vector3
        -- нормаль грани в мировых координатах через startRot
        local normal = startRot * Vector3.FromNormalId(face)
        local newPos = startPos + normal * distance
        local newCF  = CFrame.new(newPos) * startRot
        moveToCF(model, newCF)
        updateInfo()
    end)

    hMove.MouseButton1Up:Connect(function()
        dragActive = false
        commitMove(model)
        startPos = nil; startRot = nil
    end)
end

-- ═══════════════════════════════════════
-- РЕЖИМ ROTATE
-- ═══════════════════════════════════════
local function applyRotateMode(model)
    makeSelBox(model, modeColor.rotate)
    local pp = getPP(model)
    if not pp then return end

    hRotate = Instance.new("ArcHandles")
    hRotate.Adornee = pp
    hRotate.Parent  = workspace

    local startCF = nil

    hRotate.MouseButton1Down:Connect(function()
        dragActive = true
        startCF = getCF(model)
    end)

    hRotate.MouseDrag:Connect(function(axis, relAngle, _delta)
        if not dragActive or not startCF or not model.Parent then return end
        -- ось вращения в мировых координатах
        local ax
        if    axis == Enum.Axis.X then ax = startCF.RightVector
        elseif axis == Enum.Axis.Y then ax = startCF.UpVector
        else                            ax = startCF.LookVector end

        local rot   = CFrame.fromAxisAngle(ax, relAngle)
        -- БАГ3 FIX: startCF.Rotation вместо startCF - startCF.Position
        local newCF = CFrame.new(startCF.Position) * rot * startCF.Rotation
        moveToCF(model, newCF)
        updateInfo()
    end)

    hRotate.MouseButton1Up:Connect(function()
        dragActive = false
        commitMove(model)
        startCF = nil
    end)
end

-- ═══════════════════════════════════════
-- РЕЖИМ SCALE
-- ═══════════════════════════════════════
local function applyScaleMode(model)
    makeSelBox(model, modeColor.scale)
    local pp = getPP(model)
    if not pp then return end

    local function sphereCF(norm)
        -- БАГ6 FIX: компоненты по отдельности, не Vector3*Vector3
        return CFrame.new(
            norm.X * pp.Size.X * 0.5,
            norm.Y * pp.Size.Y * 0.5,
            norm.Z * pp.Size.Z * 0.5
        )
    end

    -- создаём 6 шаров
    for _, face in ipairs(FACES) do
        local s = Instance.new("SphereHandleAdornment")
        s.Adornee     = pp
        s.Color3      = C.orange
        s.Radius      = 0.38
        s.AlwaysOnTop = false
        s.CFrame      = sphereCF(face.norm)
        s.Parent      = workspace
        table.insert(hScaleList, s)
    end

    local function refreshSpheres()
        for i, s in ipairs(hScaleList) do
            s.CFrame = sphereCF(FACES[i].norm)
        end
    end

    -- drag state
    local activeNorm  = nil
    local startSz     = nil
    local startMouse  = nil

    -- mousedown на каждом шаре
    for i, s in ipairs(hScaleList) do
        local face = FACES[i]
        s.MouseButton1Down:Connect(function()
            dragActive  = true
            activeNorm  = face.norm
            startSz     = pp.Size
            startMouse  = nil
        end)
    end

    -- БАГ1 FIX: scaleConn — внешняя переменная
    scaleConn = RunService.Heartbeat:Connect(function()
        if not dragActive or not activeNorm then return end
        if not model.Parent then return end

        local mousePos = UserInputService:GetMouseLocation()
        local ray      = camera:ScreenPointToRay(mousePos.X, mousePos.Y)

        -- мировой вектор нормали грани (с учётом ротации блока)
        local normWorld = pp.CFrame:VectorToWorldSpace(activeNorm)

        -- БАГ2 FIX: math.abs по компонентам
        local halfX = pp.Size.X * 0.5 * math.abs(activeNorm.X)
        local halfY = pp.Size.Y * 0.5 * math.abs(activeNorm.Y)
        local halfZ = pp.Size.Z * 0.5 * math.abs(activeNorm.Z)
        local faceOrigin = pp.CFrame.Position + normWorld * (halfX + halfY + halfZ)

        local denom = ray.Direction:Dot(normWorld)
        if math.abs(denom) < 0.001 then return end

        local t    = (faceOrigin - ray.Origin):Dot(normWorld) / denom
        local hit  = ray.Origin + ray.Direction * t
        local dist = (hit - pp.CFrame.Position):Dot(normWorld)

        if not startMouse then startMouse = dist; return end

        local delta = dist - startMouse
        local MIN   = 0.1

        local newSz = Vector3.new(
            math.max(MIN, startSz.X + (math.abs(activeNorm.X) > 0.5 and delta*2 or 0)),
            math.max(MIN, startSz.Y + (math.abs(activeNorm.Y) > 0.5 and delta*2 or 0)),
            math.max(MIN, startSz.Z + (math.abs(activeNorm.Z) > 0.5 and delta*2 or 0))
        )
        pp.Size = newSz
        refreshSpheres()
        updateInfo()
    end)

    -- БАГ5 FIX: один листенер, сохраняем в inputEndedConn
    inputEndedConn = UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            if dragActive and activeNorm then
                dragActive = false
                commitResize(model, pp.Size)
                activeNorm = nil; startSz = nil; startMouse = nil
            end
        end
    end)
end

-- ═══════════════════════════════════════
-- ПРИМЕНИТЬ РЕЖИМ
-- ═══════════════════════════════════════
local stepMap = {select="", move="1 st", rotate="15°", scale="0.5"}

local function applyMode(m)
    mode = m
    setHL(m)
    clearHandles()

    local hasBlock = sel ~= nil
    stepFrame.Visible = hasBlock and m ~= "select"
    modeTag.Visible   = hasBlock and m ~= "select"
    stepVal.Text      = stepMap[m] or ""

    if not sel then return end

    if     m == "move"   then applyMoveMode(sel)
    elseif m == "rotate" then applyRotateMode(sel)
    elseif m == "scale"  then applyScaleMode(sel)
    elseif m == "select" then makeSelBox(sel, modeColor.select)
    end
end

-- ═══════════════════════════════════════
-- SELECT / DESELECT
-- ═══════════════════════════════════════
local function deselect()
    sel = nil
    clearHandles()
    infoPanel.Visible = false
    modeTag.Visible   = false
    stepFrame.Visible = false
end

local function selectModel(model)
    if sel == model then return end
    deselect()
    sel = model
    infoPanel.Visible = true
    infoTitle.Text    = "📦 " .. model.Name
    updateInfo()
    -- при первом выборе → сразу move
    applyMode(mode == "select" and "move" or mode)
end

-- ═══════════════════════════════════════
-- RAYCAST + INPUT
-- ═══════════════════════════════════════
local function doRaycast(screenPos)
    local ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)
    local p   = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    local ch = player.Character
    p.FilterDescendantsInstances = ch and {ch} or {}
    return workspace:Raycast(ray.Origin, ray.Direction * 1500, p)
end

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp or dragActive then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseButton1
    and inp.UserInputType ~= Enum.UserInputType.Touch then return end

    local pos    = Vector2.new(inp.Position.X, inp.Position.Y)
    local result = doRaycast(pos)

    if not result or not result.Instance then
        deselect(); return
    end

    local model = getBlockModel(result.Instance)
    if model then selectModel(model)
    else deselect() end
end)

