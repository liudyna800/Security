-- Надёжный скрипт для быстрого открытия TikTok в браузере через Delta
local url = "https://www.tiktok.com/@yamy_ts/video/7001583785355611394"

-- Функция, которая пробует несколько способов открыть ссылку
local function forceOpenURL(targetUrl)
    -- Способ 1: Открыть ссылку в браузере по умолчанию (Windows/macOS)
    local success, err = pcall(function()
        if identifyexecutor and identifyexecutor():lower():find("delta") then
            -- Команда для Windows
            os.execute('start "" "' .. targetUrl .. '"')
        else
            -- Команды для macOS (попытка)
            os.execute('open "' .. targetUrl .. '"')
        end
    end)
    
    -- Способ 2: Если не вышло, скопировать ссылку в буфер обмена
    if not success then
        warn("Не удалось открыть браузер: " .. tostring(err))
        pcall(function()
            syn.write_clipboard(targetUrl)
            print("Ссылка скопирована в буфер обмена. Вставьте её в браузер.")
        end)
    end
end

-- Создадим удобную кнопку в игре, чтобы запускать видео с друзьями
local player = game:GetService("Players").LocalPlayer
if player then
    local gui = Instance.new("ScreenGui")
    gui.Name = "TikTokOpener"
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 220, 0, 45)
    button.Position = UDim2.new(0.5, -110, 0.85, -10)
    button.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Чёрный фон как у TikTok
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = "▶ Открыть TikTok видео"
    button.Font = Enum.Font.GothamBold
    button.TextSize = 15
    button.Parent = gui

    -- Создаём красивую рамку для кнопки
    local border = Instance.new("UIStroke")
    border.Color = Color3.fromRGB(255, 0, 80) -- Розовая рамка в стиле TikTok
    border.Thickness = 2
    border.Parent = button

    button.MouseButton1Click:Connect(function()
        forceOpenURL(url)
        button.Text = "✓ Открывается..."
        task.wait(1.5)
        button.Text = "▶ Открыть TikTok видео"
    end)

    print("Кнопка для TikTok готова в правом нижнем углу!")
else
    warn("Не удалось найти игрока. Запускайте скрипт, находясь в игре.")
end

-- Вывод информации в консоль
print("-------------------------------------------")
print("Скрипт для Delta активирован.")
print("Если кнопка не сработает, ссылка будет скопирована.")
print("Целевое видео: " .. url)
print("-------------------------------------------")
