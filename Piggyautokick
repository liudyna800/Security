-- ==================== AUTO FARM ====================
local Farming = false
local FarmConnection

local function getAllCoins()
    local coins = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.CanCollide and not obj.Anchored then
            local name = obj.Name
            -- Все возможные имена монет в MM2
            if name == "Coin" or name == "CoinPickup" or name == "Candy" or name == "Coin_Server" then
                table.insert(coins, obj)
            end
        end
        -- Проверка внутри моделей
        if obj:IsA("Model") and obj.Name == "Coin_Server" then
            local coinPart = obj:FindFirstChild("Coin") or obj:FindFirstChild("CoinPickup")
            if coinPart and coinPart:IsA("BasePart") then
                table.insert(coins, coinPart)
            end
        end
    end
    return coins
end

local function findNearestCoin()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    local nearest = nil
    local minDist = math.huge
    for _, coin in ipairs(getAllCoins()) do
        if coin and coin.Parent then
            local dist = (coin.Position - root.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = coin
            end
        end
    end
    return nearest
end

local function collectItem(item)
    if not item or not item.Parent then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    -- Метод 1: firetouchinterest
    pcall(function()
        firetouchinterest(root, item, 0)
        firetouchinterest(root, item, 1)
    end)
    -- Метод 2: прямое перемещение (если первый не сработал)
    pcall(function()
        root.CFrame = item.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.05)
    end)
end

MainTab:AddToggle({
    Name = "Auto Farm Coins",
    Default = false,
    Callback = function(Value)
        Farming = Value
        if Value then
            FarmConnection = RunService.Heartbeat:Connect(function()
                if not Farming then return end
                local char = LocalPlayer.Character
                if not char then return end
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if not humanoid then return end
                local coin = findNearestCoin()
                if coin then
                    humanoid:MoveTo(coin.Position)
                    if (char.HumanoidRootPart.Position - coin.Position).Magnitude < 10 then
                        collectItem(coin)
                    end
                end
            end)
        else
            if FarmConnection then
                FarmConnection:Disconnect()
                FarmConnection = nil
            end
        end
    end
})

-- ==================== ESP ====================
local ESPEnabled = false
local ESPObjects = {}

local function createESP(player)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ESP_" .. player.Name
    screenGui.Parent = LocalPlayer.PlayerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 180, 0, 55)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.4
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 18)
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 14
    nameLabel.Parent = frame

    local roleLabel = Instance.new("TextLabel")
    roleLabel.Size = UDim2.new(1, 0, 0, 18)
    roleLabel.Position = UDim2.new(0, 0, 0, 18)
    roleLabel.Text = "Innocent"
    roleLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    roleLabel.BackgroundTransparency = 1
    roleLabel.Font = Enum.Font.SourceSans
    roleLabel.TextSize = 13
    roleLabel.Parent = frame

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0, 18)
    distLabel.Position = UDim2.new(0, 0, 0, 36)
    distLabel.Text = "0m"
    distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distLabel.BackgroundTransparency = 1
    distLabel.Font = Enum.Font.SourceSans
    distLabel.TextSize = 13
    distLabel.Parent = frame

    ESPObjects[player] = {
        Gui = screenGui,
        Frame = frame,
        RoleLabel = roleLabel,
        DistLabel = distLabel
    }
end

local function updateESP()
    for player, data in pairs(ESPObjects) do
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            data.Frame.Visible = false
            continue
        end
        local root = player.Character.HumanoidRootPart
        local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
        if onScreen then
            data.Frame.Visible = true
            data.Frame.Position = UDim2.new(0, screenPos.X - 90, 0, screenPos.Y - 80)
        else
            data.Frame.Visible = false
        end

        -- Определение роли
        local role = "Innocent"
        local char = player.Character
        local backpack = player:FindFirstChild("Backpack")
        if (backpack and backpack:FindFirstChild("SheriffPistol")) or (char and char:FindFirstChild("SheriffPistol")) then
            role = "Sheriff"
            data.RoleLabel.TextColor3 = Color3.fromRGB(0, 150, 255)
        elseif (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
            role = "Murderer"
            data.RoleLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        else
            data.RoleLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        end
        data.RoleLabel.Text = role
        data.DistLabel.Text = math.floor((root.Position - Camera.CFrame.Position).Magnitude) .. "m"
    end
end

ESPTab:AddToggle({
    Name = "Player ESP",
    Default = false,
    Callback = function(Value)
        ESPEnabled = Value
        if Value then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    createESP(player)
                end
            end
            Players.PlayerAdded:Connect(function(player)
                if ESPEnabled then createESP(player) end
            end)
            Players.PlayerRemoving:Connect(function(player)
                if ESPObjects[player] then
                    ESPObjects[player].Gui:Destroy()
                    ESPObjects[player] = nil
                end
            end)
        else
            for _, data in pairs(ESPObjects) do
                data.Gui:Destroy()
            end
            ESPObjects = {}
        end
    end
})

RunService.RenderStepped:Connect(function()
    if ESPEnabled then updateESP() end
end)

-- ==================== AIMBOT ====================
local SilentAim = false
local AimConnection

AimbotTab:AddToggle({
    Name = "Silent Aim",
    Default = false,
    Callback = function(Value)
        SilentAim = Value
        if Value then
            AimConnection = RunService.RenderStepped:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                local tool = char:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                if not tool or not tool:FindFirstChild("Handle") then return end
                local nearest = nil
                local minDist = math.huge
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                        local head = player.Character.Head
                        local dist = (head.Position - char.Head.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            nearest = head
                        end
                    end
                end
                if nearest then
                    tool.Handle.CFrame = CFrame.new(tool.Handle.Position, nearest.Position)
                end
            end)
        else
            if AimConnection then
                AimConnection:Disconnect()
                AimConnection = nil
            end
        end
    end
})

