UtilTab:AddToggle({
    Name = "Fly (Noclip)",
    Default = false,
    Callback = function(Value)
        local plr = game.Players.LocalPlayer
        local char = plr.Character or plr.CharacterAdded:Wait()
        local rootPart = char:WaitForChild("HumanoidRootPart")
        if Value then
            -- Simple fly script
            local bodyVel = Instance.new("BodyVelocity")
            bodyVel.MaxForce = Vector3.new(1,1,1)*1e6
            bodyVel.Velocity = Vector3.new(0,10,0)
            bodyVel.Parent = rootPart
            local bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(1,1,1)*1e6
            bodyGyro.CFrame = rootPart.CFrame
            bodyGyro.Parent = rootPart
            local flyLoop
            flyLoop = game:GetService("RunService").RenderStepped:Connect(function()
                if not Value then
                    bodyVel:Destroy()
                    bodyGyro:Destroy()
                    flyLoop:Disconnect()
                else
                    local camera = workspace.CurrentCamera
                    local moveDirection = camera.CFrame.LookVector * (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) and 50 or 0)
                    + camera.CFrame.RightVector * (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) and 50 or 0)
                    + camera.CFrame.LookVector * (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) and -50 or 0)
                    + camera.CFrame.RightVector * (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) and -50 or 0)
                    bodyVel.Velocity = moveDirection
                end
            end)
        else
            -- Disconnect handled above
        end
    end
})

