local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"))()
local Window = OrionLib:MakeWindow({
    Name = "MM2 INFINITY • " .. game.Players.LocalPlayer.Name,
    HidePremium = false,
    SaveConfig = false,
    ConfigFolder = "MM2_Infinity"
})

-- Сервисы
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Вспомогательные функции
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getTool(name)
    local char = getChar()
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") and v.Name:lower():find(name) then
            return v
        end
    end
    return nil
end

local function fireRemote(remoteName, ...)
    local remotes = RS:FindFirstChild("Remotes") or RS:FindFirstChild("Events")
    if remotes then
        local r = remotes:FindFirstChild(remoteName)
        if r and r:IsA("RemoteEvent") then
            r:FireServer(...)
        end
    end
end

-- Вкладки
local MainTab = Window:MakeTab({Name = "⚡ Главная"})
local CombatTab = Window:MakeTab({Name = "🎯 Бой"})
local VisualsTab = Window:MakeTab({Name = "👁️ Визуал"})
local FarmTab = Window:MakeTab({Name = "🪙 Фарм"})
local TeleportTab = Window:MakeTab({Name = "🌀 Телепорт"})
local MiscTab = Window:MakeTab({Name = "🛠 Разное"})

-- ================== ГЛАВНАЯ ==================
MainTab:AddLabel("Твои параметры бога")

MainTab:AddToggle({Name = "GodMode (Бессмертие)", Default = false, Callback = function(v)
    if v then
        local char = getChar()
        char.Humanoid.MaxHealth = math.huge
        char.Humanoid.Health = math.huge
        while v and task.wait(0.3) do
            if char and char.Humanoid then
                char.Humanoid.Health = math.huge
            else
                char = getChar()
            end
        end
    end
end})

MainTab:AddSlider({Name = "Скорость", Min = 16, Max = 300, Default = 16, Color = Color3.fromRGB(0,255,0), Increment = 1, ValueName = "studs", Callback = function(val)
    local char = getChar()
    if char and char.Humanoid then char.Humanoid.WalkSpeed = val end
end})

MainTab:AddSlider({Name = "Прыжок", Min = 50, Max = 500, Default = 50, Color = Color3.fromRGB(255,255,0), Increment = 1, ValueName = "power", Callback = function(val)
    local char = getChar()
    if char and char.Humanoid then char.Humanoid.JumpPower = val end
end})

MainTab:AddToggle({Name = "Infinite Jump", Default = false, Callback = function(v)
    local char = getChar()
    while v do
        if char and char:FindFirstChild("Humanoid") and char.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
            char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
        task.wait()
    end
end})

MainTab:AddToggle({Name = "Fly (Полёт)", Default = false, Callback = function(v)
    local char = getChar()
    local bv
    if v then
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9,1e9,1e9)
        bv.Parent = char.HumanoidRootPart
        while v do
            local vel = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel += char.HumanoidRootPart.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel -= char.HumanoidRootPart.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel -= char.HumanoidRootPart.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel += char.HumanoidRootPart.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel -= Vector3.yAxis end
            bv.Velocity = vel * 100
            task.wait()
        end
        bv:Destroy()
    elseif bv then
        bv:Destroy()
    end
end})

MainTab:AddToggle({Name = "Noclip", Default = false, Callback = function(v)
    local char = getChar()
    while v do
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        task.wait(0.1)
    end
end})

-- ================== БОЙ ==================
CombatTab:AddLabel("Маньяк / Шериф — власть в твоих руках")

CombatTab:AddToggle({Name = "Silent Aim (Аим)", Default = false, Callback = function(v)
    local gun = getTool("gun")
    while v do
        if gun and gun:IsA("Tool") and getChar():FindFirstChild("HumanoidRootPart") then
            local nearest, dist = nil, 100
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                    local d = (p.Character.Head.Position - getChar().HumanoidRootPart.Position).Magnitude
                    if d < dist then nearest = p.Character.Head; dist = d end
                end
            end
            if nearest then
                local cam = Workspace.CurrentCamera
                cam.CFrame = CFrame.new(cam.CFrame.Position, nearest.Position)
            end
        end
        task.wait()
    end
end})

CombatTab:AddButton({Name = "Kill All (Маньяк)", Callback = function()
    local knife = getTool("knife")
    if not knife then return OrionLib:MakeNotification({Name = "Ошибка", Content = "Возьми нож!", Time = 2}) end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            getChar().HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0,0,3)
            task.wait(0.05)
            knife:Activate()
            task.wait(0.08)
        end
    end
    OrionLib:MakeNotification({Name = "Резня", Content = "Все мертвы!", Time = 2})
end})

CombatTab:AddToggle({Name = "Auto Kill Murderer (Шериф)", Default = false, Callback = function(v)
    while v do
        local gun = getTool("gun")
        if gun then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and (p.Backpack:FindFirstChild("Knife") or (p.Character and p.Character:FindFirstChild("Knife"))) then
                    if p.Character and p.Character:FindFirstChild("Head") then
                        getChar().HumanoidRootPart.CFrame = p.Character.Head.CFrame * CFrame.new(0,3,0)
                        task.wait(0.1)
                        gun:Activate()
                        task.wait(0.3)
                        break
                    end
                end
            end
        end
        task.wait(0.5)
    end
end})

CombatTab:AddButton({Name = "Дать пистолет (Grab Gun)", Callback = function()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Tool") and v.Name:lower():find("gun") and v.Parent ~= getChar() then
            getChar().HumanoidRootPart.CFrame = v.Handle.CFrame
            wait(0.1)
            fireproximityprompt(v:FindFirstChildOfClass("ProximityPrompt"))
            return
        end
    end
    OrionLib:MakeNotification({Name = "Поиск", Content = "Пистолета нет на карте", Time = 2})
end})

-- ================== ВИЗУАЛ ==================
VisualsTab:AddToggle({Name = "ESP Boxes", Default = false, Callback = function(v)
    local boxes = {}
    while v do
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local head = p.Character.Head
                local gui = head:FindFirstChild("ESPBox")
                if not gui then
                    gui = Instance.new("BillboardGui")
                    gui.Name = "ESPBox"
                    gui.Size = UDim2.new(0, 100, 0, 30)
                    gui.StudsOffset = Vector3.new(0, 2, 0)
                    gui.Parent = head
                    local tl = Instance.new("TextLabel")
                    tl.Size = UDim2.new(1,0,1,0)
                    tl.BackgroundTransparency = 1
                    tl.Text = p.Name
                    tl.TextColor3 = Color3.new(1,1,1)
                    tl.BackgroundColor3 = Color3.new(0,0,0)
                    tl.Parent = gui
                end
            end
        end
        task.wait(0.5)
    end
    -- очистка
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Head") then
            local gui = p.Character.Head:FindFirstChild("ESPBox")
            if gui then gui:Destroy() end
        end
    end
end})

VisualsTab:AddToggle({Name = "FullBright", Default = false, Callback = function(v)
    Lighting = game:GetService("Lighting")
    if v then
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1e9
    else
        Lighting.Brightness = 1
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 10000
    end
end})

VisualsTab:AddToggle({Name = "Chams (Подсветка)", Default = false, Callback = function(v)
    local highlights = {}
    while v do
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not highlights[p.UserId] then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.new(1,0,0)
                hl.Parent = p.Character
                highlights[p.UserId] = hl
            end
        end
        task.wait(1)
    end
    for _, hl in pairs(highlights) do hl:Destroy() end
end})

