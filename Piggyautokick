    "ServerStorage",
    "Players"
}

local SelectedTarget = "Workspace"

-- ============================================
-- 5. КЛЮЧЕВЫЕ СЛОВА ДЛЯ ФИЛЬТРА ESP / АНТИ-XXX
--    Дополни сам, если нужно
-- ============================================
local KEYWORDS = {
    "esp", "aimbot", "silent", "trigger", "wallhack",
    "remote", "remotefunction", "remoteevent", "bindable",
    "antichat", "anti", "cheat", "backdoor", "virus",
    "script", "localscript", "modulescript",
    "exploit", "inject", "hook", "bypass",
    "esp", "box", "skeleton", "health", "distance",
    "fly", "noclip", "speed", "jump", "inf",
    "teleport", "farm", "autofarm", "collect"
}

-- 6. Функция: проверяет, содержит ли строка любое из ключевых слов
local function matchesFilter(str)
    str = str:lower()
    for _, kw in ipairs(KEYWORDS) do
        if str:find(kw:lower(), 1, true) then
            return true
        end
    end
    return false
end

-- 7. Рекурсивный сбор ВСЕХ объектов с фильтрацией
local function ScanAll(targetName)
    local service = game:GetService(targetName)
    local results = {}

    local function recurse(parent, depth)
        depth = depth or 0
        for _, child in ipairs(parent:GetChildren()) do
            local name = child.Name
            local class = child.ClassName
            local path = child:GetFullName()

            -- Добавляем объект, если имя ИЛИ класс совпадает с фильтром
            if matchesFilter(name) or matchesFilter(class) then
                table.insert(results, {
                    Name = name,
                    ClassName = class,
                    Path = path,
                    Depth = depth
                })
            end

            -- Заходим глубже
            if #child:GetChildren() > 0 then
                recurse(child, depth + 1)
            end
        end
    end

    recurse(service)
    return results
end

-- 8. Переменные UI
local Dropdown
local SelectedObjectPath = ""

-- 9. Обновление выпадающего списка объектов
local function UpdateDropdown()
    local objects = ScanAll(SelectedTarget)
    local items = {}

    for _, obj in ipairs(objects) do
        local indent = string.rep("    ", obj.Depth)
        table.insert(items, indent .. obj.Name .. " (" .. obj.ClassName .. ")")
    end

    if Dropdown then
        Dropdown:Refresh(items, true)
    end

    -- Возвращаем количество найденного
    return #objects
end

-- 10. Сохранение результатов в УНИКАЛЬНЫЙ файл
local function SaveToFile()
    local objects = ScanAll(SelectedTarget)
    if #objects == 0 then
        OrionLib:MakeNotification({
            Name = "Пусто",
            Content = "Нет объектов, соответствующих фильтру.",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end

    -- Генерируем имя файла с датой и временем
    local now = os.date("%Y-%m-%d_%H-%M-%S")
    local filename = "explorer_scan_" .. now .. ".txt"

    -- Формируем содержимое
    local lines = {}
    table.insert(lines, "=== EXPLORER SCAN ===")
    table.insert(lines, "Дата: " .. os.date("%Y-%m-%d %H:%M:%S"))
    table.insert(lines, "Цель: " .. SelectedTarget)
    table.insert(lines, "Найдено объектов: " .. #objects)
    table.insert(lines, "------------------------")
    for _, obj in ipairs(objects) do
        table.insert(lines, obj.Path .. " [" .. obj.ClassName .. "]")
    end
    table.insert(lines, "=== КОНЕЦ ===")
    local content = table.concat(lines, "\n")

    -- Пытаемся записать файл через writefile (работает на Delta)
    local success, err = pcall(function()
        writefile(filename, content)
    end)

    if success then
        OrionLib:MakeNotification({
            Name = "✅ Сохранено!",
            Content = "Файл: " .. filename,
            Image = "rbxassetid://4483345998",
            Time = 5
        })
    else
        -- Фолбэк: если writefile нет, пробуем delta:SaveScript (для Delta X)
        local success2, err2 = pcall(function()
            delta:SaveScript(filename, content, "scan")
        end)
        if success2 then
            OrionLib:MakeNotification({
                Name = "✅ Сохранено (Delta API)",
                Content = "Скрипт сохранён в локальное меню Delta",
                Image = "rbxassetid://4483345998",
                Time = 5
            })
        else
            OrionLib:MakeNotification({
                Name = "❌ Ошибка сохранения",
                Content = "writefile и delta:SaveScript недоступны. Проверь версию Delta.",
                Image = "rbxassetid://4483345998",
                Time = 5
            })
        end
    end
end

