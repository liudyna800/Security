--[[
   ТРАКТОР-ДРИФТ (МОБИЛЬНАЯ ВЕРСИЯ)
   Управление: экранные кнопки (WASD) или клавиши.
   При движении и повороте трактор скользит боком,
   из колёс идёт дым, звучит занос.
]]--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- Конфигурация
local DRIFT_FACTOR = 0.7
local SPEED = 40
local TURN_SPEED = 3.5
local DRIFT_SOUND_ID = "rbxassetid://9120386436"  -- замените при желании

-- Переменные состояния ввода
local input = { W = false, A = false, S = false, D = false }
local driftSound = nil
local wheelSmokes = {}

-- ---- ЭКРАННЫЕ КНОПКИ ДЛЯ ТЕЛЕФОНА ----
local function createMobileButtons()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "TractorControls"
	screenGui.Parent = player:WaitForChild("PlayerGui")
	screenGui.ResetOnSpawn = false  -- чтобы не пропадало при респавне

	local btnSize = UDim2.new(0, 70, 0, 70)
	local cornerRadius = UDim.new(0, 12)

	local function makeButton(name, position, text, inputKey)
		local btn = Instance.new("TextButton")
		btn.Name = name
		btn.Size = btnSize
		btn.Position = position
		btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		btn.BackgroundTransparency = 0.6
		btn.Text = text
		btn.TextColor3 = Color3.new(0, 0, 0)
		btn.Font = Enum.Font.SourceSansBold
		btn.TextSize = 24
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		-- скругление
		local corner = Instance.new("UICorner")
		corner.CornerRadius = cornerRadius
		corner.Parent = btn

		-- События касания
		btn.InputBegan:Connect(function(inputObj)
			if inputObj.UserInputType == Enum.UserInputType.Touch or
			   inputObj.UserInputType == Enum.UserInputType.MouseButton1 then
				input[inputKey] = true
			end
		end)
		btn.InputEnded:Connect(function(inputObj)
			if inputObj.UserInputType == Enum.UserInputType.Touch or
			   inputObj.UserInputType == Enum.UserInputType.MouseButton1 then
				input[inputKey] = false
			end
		end)
		btn.Parent = screenGui
		return btn
	end

	-- Расположим кнопки по углам экрана (как на мобильных гонках)
	makeButton("W", UDim2.new(0, 40, 0.75, 0), "▲", "W")   -- вперёд
	makeButton("S", UDim2.new(0, 40, 0.85, 0), "▼", "S")   -- назад
	makeButton("A", UDim2.new(0, 10, 0.80, 0), "◀", "A")   -- влево
	makeButton("D", UDim2.new(0, 140, 0.80, 0), "▶", "D")  -- вправо
end

-- ---- КЛАВИАТУРНЫЙ ВВОД (ПК) ----
local function onInputBegan(key, processed)
	if processed then return end
	local k = key.KeyCode.Name
	if input[k] ~= nil then input[k] = true end
end
local function onInputEnded(key, processed)
	if processed then return end
	local k = key.KeyCode.Name
	if input[k] ~= nil then input[k] = false end
end
UserInputService.InputBegan:Connect(onInputBegan)
UserInputService.InputEnded:Connect(onInputEnded)

-- ---- ПОСТРОЕНИЕ ТРАКТОРА И ЛОГИКА ДВИЖЕНИЯ ----
local function setupCharacter(newChar)
	character = newChar
	repeat task.wait() until character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid")
	local humanoid = character.Humanoid
	local rootPart = character.HumanoidRootPart

	-- Прячем родное тело
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part ~= rootPart then
			part.Transparency = 1
		end
	end

	humanoid.AutoRotate = false
	humanoid.PlatformStand = true

	-- Модель трактора
	local tractor = Instance.new("Model")
	tractor.Name = "Tractor"
	tractor.Parent = character

	local body = Instance.new("Part")
	body.Size = Vector3.new(5, 2, 8)
	body.Color = Color3.fromRGB(50, 130, 50)
	body.Material = Enum.Material.Metal
	body.Anchored = false
	body.CanCollide = false
	body.Parent = tractor

	local cabin = Instance.new("Part")
	cabin.Size = Vector3.new(3, 2.5, 3)
	cabin.Color = Color3.fromRGB(30, 100, 30)
	cabin.Material = Enum.Material.Glass
	cabin.Anchored = false
	cabin.CanCollide = false
	cabin.Parent = tractor
	local cabinWeld = Instance.new("Weld")
	cabinWeld.Part0 = body
	cabinWeld.Part1 = cabin
	cabinWeld.C0 = CFrame.new(0, 2.25, -1)
	cabinWeld.Parent = cabin

	local pipe = Instance.new("Part")
	pipe.Size = Vector3.new(0.5, 3, 0.5)
	pipe.Color = Color3.fromRGB(40, 40, 40)
	pipe.Material = Enum.Material.Metal
	pipe.Anchored = false
	pipe.CanCollide = false
	pipe.Parent = tractor
	local pipeWeld = Instance.new("Weld")
	pipeWeld.Part0 = body
	pipeWeld.Part1 = pipe
	pipeWeld.C0 = CFrame.new(1.5, 2, -2.5)
	pipeWeld.Parent = pipe

	local function createWheel(name, position, size)
		local wheel = Instance.new("Part")
		wheel.Name = name
		wheel.Shape = Enum.PartType.Cylinder
		wheel.Size = size or Vector3.new(1.5, 1, 1.5)
		wheel.Color = Color3.fromRGB(20, 20, 20)
		wheel.Material = Enum.Material.Metal
		wheel.Anchored = false
		wheel.CanCollide = false
		wheel.Parent = tractor
		local weld = Instance.new("Weld")
		weld.Part0 = body
		weld.Part1 = wheel
		weld.C0 = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
		weld.Parent = wheel
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxassetid://1234567890"
		smoke.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))
		smoke.Size = NumberSequence.new(0.5, 1)
		smoke.Lifetime = NumberRange.new(0.5, 1.5)
		smoke.Rate = 0
		smoke.Speed = NumberRange.new(2, 5)
		smoke.Enabled = false
		smoke.Parent = wheel
		wheelSmokes[wheel] = smoke
		return wheel
	end

	createWheel("FrontLeft",  Vector3.new(-2.5, -1, 3),    Vector3.new(1.5, 1.2, 1.5))
	createWheel("FrontRight", Vector3.new(2.5, -1, 3),     Vector3.new(1.5, 1.2, 1.5))
	createWheel("RearLeft",   Vector3.new(-2.5, -1, -3),   Vector3.new(1.5, 1.2, 1.5))
	createWheel("RearRight",  Vector3.new(2.5, -1, -3),    Vector3.new(1.5, 1.2, 1.5))

	local rootWeld = Instance.new("Weld")
	rootWeld.Part0 = rootPart
	rootWeld.Part1 = body
	rootWeld.C0 = CFrame.new(0, -1.5, 0)
	rootWeld.Parent = body

	driftSound = Instance.new("Sound")
	driftSound.SoundId = DRIFT_SOUND_ID
	driftSound.Looped = true
	driftSound.Volume = 0.5
	driftSound.Parent = body
	driftSound:Stop()

	-- Основной цикл
	local heartbeatConn
	heartbeatConn = RunService.Heartbeat:Connect(function(dt)
		if not character or not character.Parent or not rootPart or not humanoid then
			heartbeatConn:Disconnect()
			return
		end

		local forward = rootPart.CFrame.LookVector
		local right = rootPart.CFrame.RightVector

		local moveInput = 0
		if input.W then moveInput += 1 end
		if input.S then moveInput -= 1 end

		local turnInput = 0
		if input.D then turnInput -= 1 end
		if input.A then turnInput += 1 end

		local targetSpeed = moveInput * SPEED
		local turnRate = turnInput * TURN_SPEED

		local drift = (math.abs(moveInput) > 0.1) and (math.abs(turnInput) > 0.1)
		local lateralSlide = 0
		if drift then
			lateralSlide = turnInput * math.abs(targetSpeed) * DRIFT_FACTOR
		end

		local desiredVelocity = forward * targetSpeed + right * lateralSlide
		desiredVelocity = Vector3.new(desiredVelocity.X, rootPart.AssemblyLinearVelocity.Y, desiredVelocity.Z)
		rootPart.AssemblyLinearVelocity = desiredVelocity
		rootPart.AssemblyAngularVelocity = Vector3.new(0, turnRate, 0)

		if drift then
			for _, smoke in pairs(wheelSmokes) do
				if not smoke.Enabled then smoke.Enabled = true end
				smoke.Rate = 30
			end
			if not driftSound.IsPlaying then driftSound:Play() end
		else
			for _, smoke in pairs(wheelSmokes) do
				if smoke.Enabled then
					smoke.Enabled = false
					smoke.Rate = 0
				end
			end
			if driftSound.IsPlaying then driftSound:Stop() end
		end
	end)

	character.Destroying:Connect(function()
		heartbeatConn:Disconnect()
		if driftSound then driftSound:Stop() end
		wheelSmokes = {}
	end)
end

-- Создаём кнопки один раз
createMobileButtons()

-- Привязка к персонажу
if player.Character then
	setupCharacter(player.Character)
end
player.CharacterAdded:Connect(setupCharacter)
