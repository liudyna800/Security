local function getItem(itemName)
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v.Name == itemName then return v end
        end
    end
end

local function useItem(itemName)
    local item = getItem(itemName)
    if not item then
        Notify("Нет предмета", itemName)
        return
    end
    for _, child in ipairs(item:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("BindableEvent") then
            safeFire(child)
            Notify(itemName, "Использован!")
            return
        end
    end
    local ls = item:FindFirstChildWhichIsA("LocalScript")
    if ls then
        pcall(function() require(ls) end)
        Notify(itemName, "LocalScript запущен")
        return
    end
    local serv = item:FindFirstChild("ServerBottle") or item:FindFirstChild("Script")
    if serv and serv:IsA("Script") then
        pcall(function() require(serv) end)
        Notify(itemName, "Server скрипт вызван")
        return
    end
    Notify(itemName, "Не удалось использовать")
end

