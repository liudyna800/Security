-- FIX: addLog объявлена ПОСЛЕ serializeArgs
local filterText = ""

local function addLog(remoteType, remotePath, argsStr, result)
    LogCount = LogCount + 1
    LogCounter.Text = LogCount .. " logs"
    
    local timestamp = os.date("%H:%M:%S")
    local color = remoteType == "FireServer" and Color3.fromRGB(255, 200, 80)
               or remoteType == "InvokeServer" and Color3.fromRGB(80, 200, 255)
               or Color3.fromRGB(180, 180, 200)
    
    local displayText = string.format("[%s] [%s] %s(%s)", timestamp, remoteType, remotePath, argsStr)
    if result then displayText = displayText .. "  →  " .. tostring(result) end
    
    -- FIX: удаляем старые логи ПЕРЕД добавлением нового (избегаем GetChildren() лишний раз)
    local children = LogsList:GetChildren()
    local frameCount = 0
    for _, c in ipairs(children) do
        if c:IsA("Frame") then frameCount = frameCount + 1 end
    end
    if frameCount >= Settings.MaxLogs then
        for _, c in ipairs(children) do
            if c:IsA("Frame") then c:Destroy(); break end
        end
    end
    
    local entry = Instance.new("Frame")
    entry.Size = UDim2.new(1, 0, 0, 28)
    entry.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    entry.BorderSizePixel = 0
    entry.LayoutOrder = LogCount
    
    -- Полоска типа
    local typeBar = Instance.new("Frame")
    typeBar.Size = UDim2.new(0, 3, 1, 0)
    typeBar.BackgroundColor3 = color
    typeBar.BorderSizePixel = 0
    typeBar.Parent = entry
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 8, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = displayText
    label.TextColor3 = color
    label.Font = Enum.Font.Code
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = entry
    
    -- FIX: hover эффект
    entry.MouseEnter:Connect(function()
        entry.BackgroundColor3 = Color3.fromRGB(30, 32, 45)
    end)
    entry.MouseLeave:Connect(function()
        entry.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    end)
    
    -- FIX: клик копирует в буфер и показывает в консоли
    entry.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            pcall(function() setclipboard(argsStr) end)
            setTab(2) -- переключаем на консоль
            addConsoleText(string.format("-- Copied: %s(%s)", remotePath, argsStr), Color3.fromRGB(255, 220, 80))
        end
    end)
    
    -- FIX: видимость при фильтре
    if filterText ~= "" then
        entry.Visible = displayText:lower():find(filterText:lower(), 1, true) ~= nil
    end
    
    entry.Parent = LogsList
    
    -- Сохранение в файл
    if Settings.SaveLogs then
        pcall(function()
