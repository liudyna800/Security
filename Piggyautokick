-- ================== ТЕЛЕПОРТЫ ==================
TeleportTab:AddLabel("Быстрые перемещения")

TeleportTab:AddButton({Name = "К ближайшему компьютеру", Callback = function()
    local char = getChar()
    local nearest, dist = nil, 100
    for _, obj in ipairs(WS:GetDescendants()) do
        if (obj.Name == "Computer" or obj.Name == "HackComputer") and obj:IsA("BasePart") then
            local d = (obj.Position - char.HumanoidRootPart.Position).Magnitude
            if d < dist then nearest = obj; dist = d end
        end
    end
    if nearest then char.HumanoidRootPart.CFrame = nearest.CFrame * CFrame.new(0, 0, 2) end
end})

TeleportTab:AddButton({Name = "К выходу", Callback = function()
    local char = getChar()
    for _, obj in ipairs(WS:GetDescendants()) do
        if (obj.Name == "ExitDoor" or obj.Name == "EscapeDoor") and obj:IsA("BasePart") and obj.Transparency < 0.5 then
            char.HumanoidRootPart.CFrame = obj.CFrame * CFrame.new(0, 0, -2)
            break
        end
    end
end})

TeleportTab:AddButton({Name = "К зверю", Callback = function()
    local beast = findBeast()
    if beast and beast.Character then
        getChar().HumanoidRootPart.CFrame = beast.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 10)
    end
end})

TeleportTab:AddButton({Name = "К выжившему", Callback = function()
    local survivors = findSurvivors()
    if #survivors > 0 then
        local target = survivors[math.random(1, #survivors)]
        if target.Character then
            getChar().HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        end
    end
end})

