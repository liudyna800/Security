end})

MiscTab:AddButton({Name = "Anti-AFK (анти кик)", Callback = function()
    while true do
        getChar().HumanoidRootPart.CFrame = getChar().HumanoidRootPart.CFrame * CFrame.new(0, 0, 0)
        task.wait(60)
    end
end})

MiscTab:AddToggle({Name = "Server Hop (авто смена сервера)", Default = false, Callback = function(v)
    while v do
        task.wait(5) -- ждем 5 минут
        game:GetService("TeleportService"):Teleport(game.PlaceId)
    end
end})

