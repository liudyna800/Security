-- 1. Инициализация Orion
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"))()
local Window = OrionLib:MakeWindow({
    Name = "Flee The Facility • Ultimate",
    HidePremium = false,
    SaveConfig = false,
    ConfigFolder = "FTF_Ultimate"
})

-- 2. Сервисы и переменные
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local WS = game:GetService("Workspace")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local function getChar()
    return LP.Character or LP.CharacterAdded:Wait()
end

-- Поиск зверя (Beast)
local function findBeast()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("Beast") then
            return p
        end
    end
    return nil
end

-- Поиск выживших
local function findSurvivors()
    local survivors = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and not p.Character:FindFirstChild("Beast") then
            table.insert(survivors, p)
        end
    end
    return survivors
end

-- 3. Вкладки
local MainTab = Window:MakeTab({Name = "Главная"})
local SurvivorTab = Window:MakeTab({Name = "Выживший"})
local BeastTab = Window:MakeTab({Name = "Зверь"})
local VisualsTab = Window:MakeTab({Name = "Визуалы"})
local TeleportTab = Window:MakeTab({Name = "Телепорты"})
local MiscTab = Window:MakeTab({Name = "Разное"})

-- ================== ГЛАВНАЯ ==================
MainTab:AddLabel("Общие настройки")

MainTab:AddSlider({
    Name = "Скорость",
    Min = 16, Max = 200, Default = 16,
    Color = Color3.fromRGB(0, 255, 0),
    Increment = 1,
    ValueName = "studs/s",
    Callback = function(v)
        local char = getChar()
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = v
        end
    end
})

MainTab:AddSlider({
    Name = "Прыжок",
    Min = 50, Max = 300, Default = 50,
    Color = Color3.fromRGB(255, 255, 0),
    Increment = 5,
    ValueName = "power",
    Callback = function(v)
        local char = getChar()
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.JumpPower = v
        end
    end
})

MainTab:AddToggle({
    Name = "Бесконечные прыжки",
    Default = false,
    Callback = function(v)
        local char = getChar()
        while v do
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            task.wait()
        end
    end
})

MainTab:AddToggle({
    Name = "NoClip (сквозь стены)",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            task.wait(0.1)
        end
    end
})

MainTab:AddToggle({
    Name = "Fly (полёт)",
    Default = false,
    Callback = function(v)
        local char = getChar()
        local bv
        if v then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Parent = char.HumanoidRootPart
            while v do
                local vel = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel += char.HumanoidRootPart.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel -= char.HumanoidRootPart.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel -= char.HumanoidRootPart.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel += char.HumanoidRootPart.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.yAxis end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel -= Vector3.yAxis end
                bv.Velocity = vel * 80
                task.wait()
            end
            bv:Destroy()
        elseif bv then
            bv:Destroy()
        end
    end
})

-- ================== ВЫЖИВШИЙ ==================
SurvivorTab:AddLabel("Автоматизация выжившего")
SurvivorTab:AddToggle({
    Name = "Auto Hack Computers",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj.Name == "Computer" or obj.Name == "HackComputer" then
                    if obj:IsA("BasePart") and (obj.Position - char.HumanoidRootPart.Position).Magnitude < 30 then
                        char.HumanoidRootPart.CFrame = obj.CFrame * CFrame.new(0, 0, 2)
                        task.wait(0.3)
                        local prox = obj:FindFirstChildOfClass("ProximityPrompt")
                        if prox then
                            fireproximityprompt(prox)
                        end
                    end
                end
            end
            task.wait(1)
        end
    end
})

SurvivorTab:AddToggle({
    Name = "Auto Escape (авто выход)",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            for _, obj in ipairs(WS:GetDescendants()) do
                if (obj.Name == "ExitDoor" or obj.Name == "EscapeDoor") and obj:IsA("BasePart") then
                    if obj.Transparency < 0.5 then
                        char.HumanoidRootPart.CFrame = obj.CFrame * CFrame.new(0, 0, -2)
                        task.wait(0.5)
                    end
                end
            end
            task.wait(1)
        end
    end
})

SurvivorTab:AddToggle({
    Name = "Auto Unfreeze (спасать)",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj.Name == "FreezePod" or obj.Name == "FrozenPlayer" then
                    if obj:IsA("BasePart") and (obj.Position - char.HumanoidRootPart.Position).Magnitude < 20 then
                        char.HumanoidRootPart.CFrame = obj.CFrame * CFrame.new(0, 0, 1.5)
                        task.wait(0.2)
                        local prox = obj:FindFirstChildOfClass("ProximityPrompt")
                        if prox then fireproximityprompt(prox) end
                    end
                end
            end
            task.wait(0.5)
        end
    end
})

SurvivorTab:AddToggle({
    Name = "Never Fail Hack",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            for _, gui in ipairs(char:GetDescendants()) do
                if gui:IsA("ScreenGui") and (gui.Name:lower():find("hack") or gui.Name:lower():find("skill")) then
                    for _, btn in ipairs(gui:GetDescendants()) do
                        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                            -- Автоматически "нажимает" на кнопку проверки
                            local success, err = pcall(function()
                                fireclickdetector(btn)
                            end)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end
})

SurvivorTab:AddToggle({
    Name = "Anti Ragdoll (не падать)",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.PlatformStand = false
                char.Humanoid.Sit = false
            end
            task.wait(0.2)
        end
    end
})

-- ================== ЗВЕРЬ ==================
BeastTab:AddLabel("Инструменты Зверя")

BeastTab:AddToggle({
    Name = "Auto Attack (авто удар)",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            local beast = char:FindFirstChild("Beast") or char:FindFirstChild("Hammer")
            if beast then
                for _, p in ipairs(findSurvivors()) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if dist < 10 then
                            char.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
                            task.wait(0.1)
                            if beast:IsA("Tool") then
                                beast:Activate()
                            end
                            task.wait(0.3)
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end
})

BeastTab:AddToggle({
    Name = "Auto Tie (авто связывание)",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            local beast = char:FindFirstChild("Beast") or char:FindFirstChild("Hammer")
            if beast then
                for _, obj in ipairs(WS:GetDescendants()) do
                    if obj.Name == "DownSurvivor" or obj.Name == "CapturedPlayer" then
                        if obj:IsA("BasePart") and (obj.Position - char.HumanoidRootPart.Position).Magnitude < 10 then
                            char.HumanoidRootPart.CFrame = obj.CFrame * CFrame.new(0, 0, 1.5)
                            task.wait(0.2)
                            local prox = obj:FindFirstChildOfClass("ProximityPrompt")
                            if prox then fireproximityprompt(prox) end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end
})

BeastTab:AddToggle({
    Name = "No Hammer Cooldown",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            local hammer = char:FindFirstChild("Hammer")
            if hammer and hammer:IsA("Tool") then
                hammer:Activate()
            end
            task.wait(0.05)
        end
    end
})

BeastTab:AddToggle({
    Name = "Hitbox Expander",
    Default = false,
    Callback = function(v)
        while v do
            local char = getChar()
            local hammer = char:FindFirstChild("Hammer")
            if hammer and hammer:FindFirstChild("Handle") then
                hammer.Handle.Size = Vector3.new(10, 10, 10)
                hammer.Handle.Transparency = 0.5
            end
            task.wait(1)
