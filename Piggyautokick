-- Функция для сериализации аргументов (поддержка таблиц, Vector3, CFrame и т.д.)
local function serializeArgs(args, depth)
    depth = depth or 0
    if depth > 5 then return "{...}" end -- Защита от рекурсии
    
    local serialized = {}
    for i, v in ipairs(args) do
        local t = type(v)
        if t == "string" then
            table.insert(serialized, string.format("%q", v))
        elseif t == "number" or t == "boolean" then
            table.insert(serialized, tostring(v))
        elseif t == "nil" then
            table.insert(serialized, "nil")
        elseif t == "table" then
            -- Обработка таблиц
            local parts = {}
            for k, val in pairs(v) do
                local keyStr = type(k) == "string" and string.format("%q", k) or tostring(k)
                local valStr = serializeArgs({val}, depth + 1)
                table.insert(parts, string.format("[%s] = %s", keyStr, valStr))
            end
            table.insert(serialized, "{" .. table.concat(parts, ", ") .. "}")
        elseif t == "userdata" then
            -- Обработка специальных типов Roblox
            if typeof(v) == "Vector3" then
                table.insert(serialized, string.format("Vector3.new(%s, %s, %s)", v.X, v.Y, v.Z))
            elseif typeof(v) == "CFrame" then
                table.insert(serialized, string.format("CFrame.new(%s, %s, %s)", v.X, v.Y, v.Z))
            elseif typeof(v) == "Color3" then
                table.insert(serialized, string.format("Color3.fromRGB(%s, %s, %s)", math.floor(v.R*255), math.floor(v.G*255), math.floor(v.B*255)))
            else
                table.insert(serialized, tostring(v))
            end
        elseif t == "function" then
            table.insert(serialized, "function(...)")
        else
            table.insert(serialized, tostring(v))
        end
    end
    return table.concat(serialized, ", ")
end

-- Функция для парсинга аргументов из строки (поддержка таблиц, Vector3 и т.д.)
local function parseArgs(str)
    if not str or str == "" then return {} end
    
    local success, result = pcall(function()
        -- Создаем безопасное окружение для парсинга
        local env = {
            Vector3 = Vector3,
            CFrame = CFrame,
            Color3 = Color3,
            BrickColor = BrickColor,
            UDim2 = UDim2,
            UDim = UDim,
            Ray = Ray,
            TweenInfo = TweenInfo,
            NumberRange = NumberRange,
            NumberSequence = NumberSequence,
            ColorSequence = ColorSequence,
        }
        
        local func, err = loadstring("return " .. str)
        if not func then
            func, err = loadstring("return {" .. str .. "}")
        end
        
        if func then
            setfenv(func, env)
            local res = func()
            if type(res) == "table" then
                return res
            else
                return {res}
            end
        else
            return {}
        end
    end)
    
    if success then
        return result
    else
        return {}
    end
end

-- Функция для добавления записи в лог
local function addLog(logType, remoteType, remote, args, result, stackTrace)
    local timestamp = os.date("%Y-%m-%d %H:%M:%S")
    local remotePath = tostring(remote)
    local remoteName = remote.Name or "Unknown"
    local remoteParent = remote.Parent and remote.Parent:GetFullName() or "Unknown"
    
    local logEntry = {
        Timestamp = timestamp,
        Type = remoteType,
        Name = remoteName,
        Path = remoteParent .. "." .. remoteName,
        FullPath = remotePath,
        Args = args,
        Result = result,
        StackTrace = stackTrace,
        LogType = logType
    }
    
    table.insert(Logs, 1, logEntry)
    
    -- Ограничение количества записей
    while #Logs > Settings.MaxLogEntries do
        table.remove(Logs)
    end
    
    -- Обновление UI
    pcall(function()
        if LogTable then
            local rows = {}
            for i, entry in ipairs(Logs) do
                local shortArgs = serializeArgs(entry.Args):sub(1, 30) .. (#serializeArgs(entry.Args) > 30 and "..." or "")
                table.insert(rows, {
                    Time = entry.Timestamp,
                    Type = entry.Type,
                    Name = entry.Name,
                    Args = shortArgs,
                    Index = i
                })
            end
            LogTable:Refresh(rows, true)
        end
    end)
    
    -- Сохранение в файл
    if Settings.SaveLogsToFile then
        local fileName = SaveFolder .. "/" .. game.PlaceId .. "_" .. os.date("%Y%m%d") .. ".txt"
        local logString = string.format("[%s] [%s] %s.%s(%s)\n", 
            timestamp, remoteType, remoteParent, remoteName, serializeArgs(args))
        if result ~= nil then
            logString = logString .. "    Result: " .. serializeArgs({result}) .. "\n"
        end
        if stackTrace then
            logString = logString .. "    Stack: " .. stackTrace .. "\n"
        end
        appendfile(fileName, logString)
    end
    
    return logEntry
end

-- Функция для перехвата RemoteEvent:FireServer
local function hookFireServer(originalFunc, remote)
    return function(...)
        local args = {...}
        local stackTrace = Settings.DebugMode and debug.traceback(nil, 2) or nil
        
        -- Логирование
        if Settings.HookEnabled then
            addLog("FireServer", "RemoteEvent", remote, args, nil, stackTrace)
        end
        
        -- Передача оригинальному серверу
        return originalFunc(remote, ...)
    end
end

-- Функция для перехвата RemoteFunction:InvokeServer
local function hookInvokeServer(originalFunc, remote)
    return function(...)
        local args = {...}
        local stackTrace = Settings.DebugMode and debug.traceback(nil, 2) or nil
        
        -- Вызов оригинального метода
        local results = {originalFunc(remote, ...)}
        
        -- Логирование
        if Settings.HookEnabled then
            local result = #results == 1 and results[1] or results
            addLog("InvokeServer", "RemoteFunction", remote, args, result, stackTrace)
        end
        
        return unpack(results)
    end
end

-- Функция для сканирования всех RemoteEvent и RemoteFunction в игре
local function scanRemotes()
    RemoteList = {}
    local services = {
        game:GetService("ReplicatedStorage"),
        game:GetService("Players"),
        game:GetService("Workspace"),
        game:GetService("Lighting"),
        game:GetService("StarterGui"),
        game:GetService("StarterPlayer"),
        game:GetService("SoundService"),
        game:GetService("Chat"),
        game:GetService("ServerStorage"),
        game:GetService("ServerScriptService")
    }
    
    for _, service in ipairs(services) do
        pcall(function()
            for _, obj in ipairs(service:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    table.insert(RemoteList, {
                        Object = obj,
                        Name = obj.Name,
                        Path = obj:GetFullName(),
                        Type = obj.ClassName
                    })
                end
            end
        end)
    end
    
    return RemoteList
end

-- Функция для включения хуков
local function enableHooks()
    if HookConnections and #HookConnections > 0 then return end
    
    Settings.HookEnabled = true
    
    -- Хукаем все существующие RemoteEvent и RemoteFunction
    for _, remoteData in ipairs(RemoteList) do
        local remote = remoteData.Object
        if remote:IsA("RemoteEvent") then
            local oldHook
            oldHook = hookfunction(remote.FireServer, function(...)
                return hookFireServer(oldHook or remote.FireServer, remote)(...)
            end)
            HookConnections[remote] = oldHook
        elseif remote:IsA("RemoteFunction") then
            local oldHook
            oldHook = hookfunction(remote.InvokeServer, function(...)
                return hookInvokeServer(oldHook or remote.InvokeServer, remote)(...)
            end)
            HookConnections[remote] = oldHook
        end
    end
    
    -- Хукаем новые ремоуты при их создании
    local function hookNewRemote(remote)
        if remote:IsA("RemoteEvent") then
            local oldHook
            oldHook = hookfunction(remote.FireServer, function(...)
                return hookFireServer(oldHook or remote.FireServer, remote)(...)
            end)
            HookConnections[remote] = oldHook
        elseif remote:IsA("RemoteFunction") then
            local oldHook
            oldHook = hookfunction(remote.InvokeServer, function(...)
                return hookInvokeServer(oldHook or remote.InvokeServer, remote)(...)
            end)
            HookConnections[remote] = oldHook
        end
    end
    
    -- Наблюдаем за новыми объектами
    local services = {game:GetService("ReplicatedStorage"), game:GetService("Players"), game:GetService("Workspace")}
    for _, service in ipairs(services) do
        service.DescendantAdded:Connect(function(child)
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                hookNewRemote(child)
            end
        end)
    end
    
    OrionLib:MakeNotification({
        Name = "RemoteSpy",
        Content = "Перехват ремоутов включен!",
        Time = 3
    })
end

