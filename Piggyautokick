-- Сервисы
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local WS = game:GetService("Workspace")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- Полезные сокращения
local function getChar()
    return LP.Character or LP.CharacterAdded:Wait()
end

-- Универсальный сбор всех RemoteEvent/RemoteFunction
local allRemotes = {}
for _, obj in ipairs(RS:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        table.insert(allRemotes, obj)
    end
end

-- Динамический поиск всех интерактивных объектов
local function findAllPromptObjects()
    local list = {}
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            table.insert(list, {Name = obj.Parent.Name, Object = obj, Type = "Proximity"})
        elseif obj:IsA("ClickDetector") then
            table.insert(list, {Name = obj.Parent.Name, Object = obj, Type = "Click"})
        end
    end
    return list
end

-- Поиск компьютеров (любые объекты с ProximityPrompt, которые привязаны к взлому)
local function findAllComputers()
    local computers = {}
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if prompt and (obj.Name:lower():find("comp") or obj.Name:lower():find("hack") or obj.Name:lower():find("laptop")) then
                table.insert(computers, obj)
            end
        end
    end
    return computers
end

-- Поиск выходов (двери, которые открываются после взлома)
local function findAllExits()
    local exits = {}
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("exit") or obj.Name:lower():find("door")) then
            -- Исключаем обычные стены
            if obj.Transparency < 0.5 and obj.Size.Y > 3 then
                table.insert(exits, obj)
            end
        end
    end
    return exits
end

-- Поиск капсул с замороженными
local function findAllPods()
    local pods = {}
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("pod") or obj.Name:lower():find("freeze") or obj.Name:lower():find("frozen")) then
            table.insert(pods, obj)
        end
    end
    return pods
end

