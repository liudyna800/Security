-- Загрузка Orion (проверенная ссылка)
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Orion/main/source"))()
local Window = OrionLib:MakeWindow({Name = "Explorer Scanner V3", HidePremium = false, SaveConfig = false, ConfigFolder = "ScannerConfig"})

-- Переменные
local scanCounter = 0
local defaultFolder = "Scans" -- папка для сохранения

-- ==================== ВКЛАДКИ ====================
local MainTab = Window:MakeTab({Name = "Сканер", Icon = "rbxassetid://4483345998", PremiumOnly = false})
local SettingsTab = Window:MakeTab({Name = "Настройки", Icon = "rbxassetid://4483345998", PremiumOnly = false})
local OutputTab = Window:MakeTab({Name = "Вывод", Icon = "rbxassetid://4483345998", PremiumOnly = false})

-- ==================== НАСТРОЙКИ ====================
local scanTarget = "Workspace"
local maxDepth = 3 -- глубина рекурсии
local includeProperties = true
local fileFormat = "txt" -- txt/json

SettingsTab:AddDropdown({
    Name = "Цель сканирования",
    Default = "Workspace",
    Options = {"Workspace", "Players", "Lighting", "ReplicatedStorage", "ServerStorage", "StarterGui"},
    Callback = function(val) scanTarget = val end
})

SettingsTab:AddSlider({
    Name = "Макс. глубина",
    Min = 1,
    Max = 10,
    Default = 3,
    Color = Color3.fromRGB(0, 170, 255),
    Increment = 1,
    ValueName = "уровней",
    Callback = function(val) maxDepth = val end
})

SettingsTab:AddToggle({
    Name = "Добавлять свойства объектов",
    Default = true,
    Callback = function(val) includeProperties = val end
})

SettingsTab:AddDropdown({
    Name = "Формат файла",
    Default = "txt",
    Options = {"txt", "json"},
    Callback = function(val) fileFormat = val end
})

SettingsTab:AddTextbox({
    Name = "Папка сохранения",
    Default = defaultFolder,
    TextDisappear = false,
    Callback = function(val) defaultFolder = val end
})

-- ==================== ЛОГ ВЫВОДА ====================
local OutputLog = OutputTab:AddParagraph("Лог", "Ожидание сканирования...")

local function addLog(text)
    local current = OutputLog:GetText()
    OutputLog:SetText(current .. "\n" .. text)
end

-- ==================== СКАНЕР ====================
-- Функция рекурсивного обхода
local function scanInstance(instance, depth, currentDepth)
    if currentDepth > depth then return "" end
    local entry = ""
    local indent = string.rep("  ", currentDepth)
    
    -- Название и класс
    entry = entry .. indent .. "[" .. instance.ClassName .. "] " .. instance.Name
    
    -- Свойства, если включены и объект не слишком тяжёлый
    if includeProperties then
        local props = {}
        local success, result = pcall(function()
            if instance:IsA("BasePart") then
                table.insert(props, "Position = " .. tostring(instance.Position))
                table.insert(props, "Size = " .. tostring(instance.Size))
                table.insert(props, "Anchored = " .. tostring(instance.Anchored))
            elseif instance:IsA("Model") then
                table.insert(props, "PrimaryPart = " .. tostring(instance.PrimaryPart))
            elseif instance:IsA("Humanoid") then
                table.insert(props, "Health = " .. tostring(instance.Health))
            end
            -- общие свойства
            if #props > 0 then
                entry = entry .. " (" .. table.concat(props, ", ") .. ")"
            end
        end)
        if not success then
            entry = entry .. " [Error reading properties]"
        end
    end
    
    entry = entry .. "\n"
    
    -- Обходим потомков
    local children = instance:GetChildren()
    for _, child in ipairs(children) do
        entry = entry .. scanInstance(child, depth, currentDepth + 1)
    end
    
    return entry
end

-- Функция сбора всех данных
local function performScan(targetName, depth)
    local root = game:FindFirstChild(targetName)
    if not root then
        return nil, "Цель не найдена: " .. targetName
    end
    
    local result = "=== СКАНИРОВАНИЕ: " .. targetName .. " ===\n"
    result = result .. "Дата: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n"
    result = result .. "Глубина: " .. depth .. "\n\n"
    result = result .. scanInstance(root, depth, 0)
    return result
end

-- Преобразование в JSON (простой способ, без библиотеки)
local function toJsonTable(instance, depth, currentDepth)
    if currentDepth > depth then return nil end
    local obj = {Name = instance.Name, Class = instance.ClassName}
    if includeProperties then
        if instance:IsA("BasePart") then
            obj.Position = tostring(instance.Position)
            obj.Size = tostring(instance.Size)
        end
    end
    obj.Children = {}
    for _, child in ipairs(instance:GetChildren()) do
        local childData = toJsonTable(child, depth, currentDepth + 1)
        if childData then
            table.insert(obj.Children, childData)
        end
    end
    return obj
end

-- Основная кнопка сканирования
MainTab:AddButton({
    Name = "Сканировать сейчас!",
    Callback = function()
        local target = scanTarget
        local depth = maxDepth
        
        addLog("▶ Запуск сканирования цели: " .. target .. " с глубиной " .. depth)
        scanCounter = scanCounter + 1
        
        -- Генерация имени файла
        local timestamp = os.date("%Y-%m-%d_%H-%M-%S")
        local extension = (fileFormat == "json") and ".json" or ".txt"
        local fileName = "Scan_" .. target .. "_" .. timestamp .. "_" .. scanCounter .. extension
        local filePath = defaultFolder .. "/" .. fileName
        
        -- Запуск в корутине, чтобы не вис интерфейс
        task.spawn(function()
            local success, data_or_err
            
            if fileFormat == "json" then
                local root = game:FindFirstChild(target)
                if root then
                    local jsonTable = toJsonTable(root, depth, 0)
                    if jsonTable then
                        local jsonStr = game:GetService("HttpService"):JSONEncode(jsonTable)
                        data_or_err = jsonStr
                        success = true
                    else
                        success = false
                        data_or_err = "Ошибка при преобразовании в JSON"
                    end
                else
                    success = false
                    data_or_err = "Цель не найдена"
                end
            else
                success, data_or_err = pcall(performScan, target, depth)
                if not success then
                    data_or_err = "Ошибка сканирования: " .. tostring(data_or_err)
                end
            end
            
            if success then
                -- Сохранение
                local writeSuccess = pcall(function()
                    writefile(filePath, data_or_err)
                end)
                if writeSuccess then
                    addLog("✅ Файл сохранён: " .. filePath)
                else
                    addLog("❌ Не удалось записать файл (возможно нет прав)")
                end
            else
                addLog("❌ Скан провален: " .. data_or_err)
            end
        end)
    end
})

