local SilentAimEnabled = false
local AimTarget = nil
local AimConnection

AimbotTab:AddToggle({
    Name = "Silent Aim (Shoot nearest enemy)",
    Default = false,
    Callback = function(Value)
        SilentAimEnabled = Value
        if Value then
            -- Disconnect any previous connection
            if AimConnection then AimConnection:Disconnect() end
            AimConnection = game:GetService("RunService").RenderStepped:Connect(function()
                if not SilentAimEnabled then return end
                local plr = game.Players.LocalPlayer
                local char = plr.Character
                if not char then return end
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    -- also check backpack
                    local backpack = plr:FindFirstChild("Backpack")
                    if backpack then
                        tool = backpack:FindFirstChildOfClass("Tool")
                    end
                end
                if not tool then return end
                if not tool:FindFirstChild("Handle") then return end
                local cam = workspace.CurrentCamera
                local localPos = char.Head.Position

                local nearestEnemy = nil
                local nearestDist = math.huge
                for _, p in ipairs(game.Players:GetPlayers()) do
                    if p ~= plr and p.Character and p.Character:FindFirstChild("Head") then
                        local head = p.Character.Head
                        local dist = (head.Position - localPos).magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearestEnemy = p
                        end
                    end
                end
                if nearestEnemy and nearestEnemy.Character and nearestEnemy.Character:FindFirstChild("Head") then
                    tool.Handle.CFrame = CFrame.new(tool.Handle.Position, nearestEnemy.Character.Head.Position)
                end
            end)
        else
            if AimConnection then
                AimConnection:Disconnect()
                AimConnection = nil
            end
        end
    end
})

