local oldNC
pcall(function()
    oldNC = hookmetamethod(game, "__namecall", function(self, ...)
        if not Settings.HookEnabled then return oldNC(self, ...) end
        local m = getnamecallmethod()
        if m == "FireServer" and self:IsA("RemoteEvent") then
            local a = {...}
            local path = self:GetFullName()
            local astr = serializeArgs(a)
            pcall(addLog, "FireServer", path, astr, nil)
            return oldNC(self, ...)
        elseif m == "InvokeServer" and self:IsA("RemoteFunction") then
            local a = {...}
            local path = self:GetFullName()
            local astr = serializeArgs(a)
            local res = oldNC(self, ...)
            pcall(addLog, "InvokeServer", path, astr, res)
            return res
        end
        return oldNC(self, ...)
    end)
end)

