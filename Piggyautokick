-- FIX: serializeArgs объявлена ДО addLog и hookfunction
local function serializeArgs(args)
    local parts = {}
    for i, v in ipairs(args) do
        local t = typeof and typeof(v) or type(v)
        if t == "string" then
            parts[i] = string.format("%q", v)
        elseif t == "number" or t == "boolean" then
            parts[i] = tostring(v)
        elseif t == "nil" then
            parts[i] = "nil"
        elseif t == "Vector3" then
            parts[i] = string.format("Vector3.new(%g,%g,%g)", v.X, v.Y, v.Z)
        elseif t == "Vector2" then
            parts[i] = string.format("Vector2.new(%g,%g)", v.X, v.Y)
        elseif t == "CFrame" then
            local pos = v.Position
            parts[i] = string.format("CFrame.new(%g,%g,%g)", pos.X, pos.Y, pos.Z)
        elseif t == "Color3" then
            parts[i] = string.format("Color3.fromRGB(%d,%d,%d)", v.R*255, v.G*255, v.B*255)
        elseif t == "Instance" then
            parts[i] = string.format('[Instance "%s"]', v:GetFullName())
        elseif t == "table" then
            parts[i] = "{table}"
        else
            parts[i] = string.format("[%s]", t)
        end
    end
    return table.concat(parts, ", ")
end

