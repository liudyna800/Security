-- Проверка видимости окна (чтобы не спамило невидимыми кнопками)
local function isGuiVisible(obj)
    local current = obj
    while current and current ~= game do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end
        current = current.Parent
    end
    return true
end

-- =============================================
-- SETTINGS
-- =============================================
local SETTINGS_FILE = "security_settings.json"
local BLACKLIST_FILE = "security_blacklist.json"

local settings = { 
    walkMax = 15.5,      -- Threshold where sustained timer starts
    sprintMax = 21.5,    -- Instant cheat threshold
    sprintTime = 5.0     -- Seconds before sustained speed is flagged
}

local function saveSettings()
    pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(settings)) end)
end
local function loadSettings()
    pcall(function()
        if isfile(SETTINGS_FILE) then
            local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            for k, v in pairs(data) do settings[k] = tonumber(v) or v end
        end
    end)
end
loadSettings()

-- =============================================
-- BLACKLIST
-- =============================================
local blacklist = {}

local function saveBlacklist()
    pcall(function()
        local data = {}
        for name in pairs(blacklist) do table.insert(data, name) end
        writefile(BLACKLIST_FILE, HttpService:JSONEncode(data))
    end)
end
local function loadBlacklist()
    pcall(function()
        if isfile(BLACKLIST_FILE) then
            for _, name in ipairs(HttpService:JSONDecode(readfile(BLACKLIST_FILE))) do
                blacklist[name:lower()] = true
            end
        end
    end)
end
loadBlacklist()

