local function serializeArgs(args)
    local out = {}
    for i, v in ipairs(args) do
        local t = typeof(v)
        if t == "string"  then out[i] = string.format("%q", v)
        elseif t == "number" or t == "boolean" then out[i] = tostring(v)
        elseif t == "nil" then out[i] = "nil"
        elseif t == "Vector3" then out[i] = ("Vector3(%g,%g,%g)"):format(v.X,v.Y,v.Z)
        elseif t == "Vector2" then out[i] = ("Vector2(%g,%g)"):format(v.X,v.Y)
        elseif t == "CFrame" then local p=v.Position; out[i]=("CFrame(%g,%g,%g)"):format(p.X,p.Y,p.Z)
        elseif t == "Color3" then out[i]=("Color3(%d,%d,%d)"):format(v.R*255,v.G*255,v.B*255)
        elseif t == "Instance" then out[i] = '['..v:GetFullName()..']'
        else out[i] = "["..t.."]" end
    end
    return table.concat(out, ", ")
end

local function addLog(rtype, path, argsStr, result)
    LogCount = LogCount + 1
    CountLabel.Text = LogCount .. " logs"

    local ts   = os.date("%H:%M:%S")
    local col  = rtype == "FireServer" and Color3.fromRGB(255,195,70)
              or rtype == "InvokeServer" and Color3.fromRGB(70,195,255)
              or Color3.fromRGB(170,170,200)
    local txt  = ("[%s] [%s] %s(%s)"):format(ts, rtype, path, argsStr)
    if result then txt = txt .. " -> " .. tostring(result) end

    -- чистим старые
    local kids = LogsScroll:GetChildren()
    local fc = 0
    for _, c in ipairs(kids) do if c:IsA("Frame") then fc = fc + 1 end end
    if fc >= Settings.MaxLogs then
        for _, c in ipairs(kids) do if c:IsA("Frame") then c:Destroy(); break end end
    end

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 26)
    row.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    row.BorderSizePixel = 0
    row.LayoutOrder = LogCount
    row.Parent = LogsScroll

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, 0)
    bar.BackgroundColor3 = col
    bar.BorderSizePixel = 0
    bar.Parent = row

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 1, 0)
    lbl.Position = UDim2.new(0, 7, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = txt
    lbl.TextColor3 = col
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Parent = row

    row.MouseEnter:Connect(function() row.BackgroundColor3 = Color3.fromRGB(28,30,44) end)
    row.MouseLeave:Connect(function() row.BackgroundColor3 = Color3.fromRGB(20,20,28) end)
    row.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            pcall(setclipboard, argsStr)
            switchTab(2)
            consoleWrite("-- Copied: "..path.."("..argsStr..")", Color3.fromRGB(255,215,70))
        end
    end)

    if filterText ~= "" and not txt:lower():find(filterText, 1, true) then
        row.Visible = false
    end

    pcall(function()
        appendfile(Settings.LogFolder.."/"..tostring(game.PlaceId).."_"..os.date("%Y%m%d")..".txt", txt.."\n")
    end)

    RunService.Heartbeat:Wait()
    LogsScroll.CanvasSize = UDim2.new(0, 0, 0, LogsLL.AbsoluteContentSize.Y + 6)
    LogsScroll.CanvasPosition = Vector2.new(0, 1e6)
end

