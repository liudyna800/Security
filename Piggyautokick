-- ==================== OBJECT SCANNER (ACCURATE) ====================
local function scanGame()
    local objects = {
        computers = {},    -- functional PCs (with ProximityPrompt)
        exitDoors = {},    -- escape exits
        cryoChambers = {}, -- cryo chambers (if present)
        beasts = {}        -- beast objects
    }
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local name = obj.Name:lower()
            
            -- Functional computers: must have an enabled ProximityPrompt
            if name:find("computer") or name:find("pc") or name:find("laptop") then
                for _, child in pairs(obj:GetDescendants()) do
                    if child:IsA("ProximityPrompt") and child.Enabled then
                        table.insert(objects.computers, obj)
                        break
                    end
                end
            end
            
            -- Exit doors
            if name:find("exit") or name:find("escape") then
                table.insert(objects.exitDoors, obj)
            end
            
            -- Cryo chambers
            if name:find("cryo") or name:find("chamber") then
                table.insert(objects.cryoChambers, obj)
            end
            
            -- Beast objects
            if name:find("beast") or name:find("creature") then
                table.insert(objects.beasts, obj)
            end
        end
    end
    
    return objects
end

-- ==================== ESP SYSTEM ====================
local ESPConnections = {}
local function toggleESP()
    -- Cleanup old connections
    for _, conn in pairs(ESPConnections) do
        pcall(function() conn:Disconnect() end)
    end
    ESPConnections = {}
    
    -- Remove existing highlights
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:FindFirstChild("FTF_ESP") then
            obj.FTF_ESP:Destroy()
        end
    end
    
    if not Settings.ESP.Enabled then return end
    
    local function createHighlight(obj, color, text)
        if obj:FindFirstChild("FTF_ESP") then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "FTF_ESP"
        highlight.FillColor = color
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.FillTransparency = 0.3
        highlight.OutlineTransparency = 0.2
        highlight.Parent = obj
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "FTF_ESP_Label"
        billboard.Size = UDim2.new(0, 100, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = obj
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 0.7
        label.BackgroundColor3 = color
        label.TextColor3 = Color3.new(1, 1, 1)
        label.Text = text
        label.Font = Enum.Font.GothamBold
        label.TextSize = 12
        label.Parent = billboard
    end
    
    local connection = RunService.RenderStepped:Connect(function()
        local objects = scanGame()
        
        if Settings.ESP.Computers then
            for _, pc in pairs(objects.computers) do
                createHighlight(pc, Color3.new(0, 1, 0), "💻 PC")
            end
        end
        
        if Settings.ESP.Exits then
            for _, exit in pairs(objects.exitDoors) do
                createHighlight(exit, Color3.new(0, 1, 1), "🚪 EXIT")
            end
        end
        
        if Settings.ESP.CryoChambers then
            for _, cryo in pairs(objects.cryoChambers) do
                createHighlight(cryo, Color3.new(0, 0.5, 1), "❄️ CRYO")
            end
        end
        
        if Settings.ESP.Beasts then
            for _, beast in pairs(objects.beasts) do
                createHighlight(beast, Color3.new(1, 0, 0), "👹 BEAST")
            end
        end
        
        -- Players with role detection (BeastPowers or Role attribute)
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local isBeast = false
                if player.Character:FindFirstChild("BeastPowers") then
                    isBeast = true
                elseif player:GetAttribute("Role") == "Beast" then
                    isBeast = true
                end
                
                if isBeast and Settings.ESP.BeastPlayer then
                    createHighlight(player.Character, Color3.new(1, 0, 0), "👹 " .. player.Name)
                elseif not isBeast and Settings.ESP.Survivors then
                    createHighlight(player.Character, Color3.new(0, 1, 0), "👤 " .. player.Name)
                end
            end
        end
    end)
    
    table.insert(ESPConnections, connection)
end

-- ==================== AUTO HACK ====================
local function startAutoHack()
    task.spawn(function()
        while Settings.AutoHack do
            pcall(function()
                local character = LocalPlayer.Character
                if not character then return end
                
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local objects = scanGame()
                local nearest = nil
                local nearestDist = Settings.AutoHackRange
                
                for _, pc in pairs(objects.computers) do
                    local dist = (hrp.Position - pc:GetPivot().Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pc
                    end
                end
                
                if nearest then
                    hrp.CFrame = nearest:GetPivot().CFrame + Vector3.new(0, 2, 0)
                    wait(0.2)
                    
                    for _, child in pairs(nearest:GetDescendants()) do
                        if child:IsA("ProximityPrompt") and child.Enabled then
                            fireproximityprompt(child)
                            wait(child.HoldDuration + 0.2)
                            
                            -- Anti PC error (Koala method)
                            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                            if remotes and remotes:FindFirstChild("ComputerError") then
                                remotes.ComputerError:FireServer()
                            end
                            break
                        end
                    end
                end
            end)
            wait(0.5)
        end
    end)
end

-- ==================== ANTI-FREEZE ====================
local function startAntiFreeze()
    task.spawn(function()
        while Settings.AntiFreeze do
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid.PlatformStand = false
                    humanoid.WalkSpeed = Settings.Speed
                    humanoid.JumpPower = Settings.JumpPower
                    
                    for _, effect in pairs(character:GetDescendants()) do
                        if effect:IsA("ParticleEmitter") and effect.Name:lower():find("freeze") then
                            effect.Enabled = false
                        end
                    end
                end
            end
            wait(0.1)
        end
    end)
end

-- ==================== FLY (PC + MOBILE) ====================
local function startFly()
    local player = LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")
    
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.P = 9e4
    bodyGyro.Parent = hrp
    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVelocity.Parent = hrp
    
    task.spawn(function()
        while Settings.Fly and hrp and humanoid do
            wait()
            humanoid.PlatformStand = true
            bodyGyro.CFrame = Camera.CFrame
            
            local moveDirection = Vector3.new(0, 0, 0)
            
            if isMobile then
                local joystick = UserInputService:GetJoystickState()
                if joystick.Position.Magnitude > 0.1 then
                    moveDirection = Vector3.new(joystick.Position.X, 0, -joystick.Position.Y) * Settings.FlySpeed
                end
            else
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    moveDirection += Camera.CFrame.LookVector * Settings.FlySpeed
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    moveDirection -= Camera.CFrame.LookVector * Settings.FlySpeed
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    moveDirection -= Camera.CFrame.RightVector * Settings.FlySpeed
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    moveDirection += Camera.CFrame.RightVector * Settings.FlySpeed
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    moveDirection += Vector3.new(0, Settings.FlySpeed, 0)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                    moveDirection -= Vector3.new(0, Settings.FlySpeed, 0)
                end
            end
            
            bodyVelocity.Velocity = moveDirection
        end
        
        if bodyGyro then bodyGyro:Destroy() end
        if bodyVelocity then bodyVelocity:Destroy() end
        if humanoid then humanoid.PlatformStand = false end
    end)
end

-- ==================== FULL BRIGHT ====================
local function toggleFullBright(state)
    local character = LocalPlayer.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if state then
        local light = Instance.new("PointLight")
        light.Brightness = 10
        light.Range = 1000
        light.Shadows = false
        light.Parent = hrp
        light.Name = "FTF_FullBright"
    else
        if hrp:FindFirstChild("FTF_FullBright") then
            hrp.FTF_FullBright:Destroy()
        end
    end
end

