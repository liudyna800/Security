local function doExec()
    local code = CInput.Text
    if code == "" then return end
    consoleWrite("> "..code, Color3.fromRGB(155, 155, 195))
    CInput.Text = ""
    local fn, err = loadstring(code)
    if not fn then
        consoleWrite("Compile error: "..tostring(err), Color3.fromRGB(255,75,75))
        return
    end
    local ok, res = pcall(fn)
    if ok then
        consoleWrite(tostring(res ~= nil and res or "(ok)"), Color3.fromRGB(90,225,120))
    else
        consoleWrite("Error: "..tostring(res), Color3.fromRGB(255,75,75))
    end
end

