-- =============================================
-- ANTICHEAT WATCH & VARIABLES
-- =============================================
local playerWatch = {}

local function resetWatch(uid)
    playerWatch[uid] = {
        sprintStart = nil,
        flagged     = false,
        flagCount   = 0,
        flyStart    = nil,
        flaggedFly1 = false,
        tiltStart   = nil,
        flaggedFly2 = false,
        _char       = nil,
    }
end

local FLY1_TIME = 4
local FLY2_TIME = 4
local TILT_THRESHOLD = 0.7

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        resetWatch(player.UserId)
    end)
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player.Character then
        player.CharacterAdded:Connect(function()
            resetWatch(player.UserId)
        end)
    end
end

local addLogMsgGlobal = nil
local onCheatDetected = nil

local function getHorizontalSpeed(player)
    local char = player.Character
    if not char then return 0 end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return 0 end
    local vel = hrp.Velocity
    return math.sqrt(vel.X^2 + vel.Z^2)
end

local function getHumanoidState(player)
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    return hum:GetState()
end

-- =============================================
-- ANTICHEAT MONITORING
-- =============================================
task.spawn(function()
    while true do
        task.wait(0.25)
        for _, player in ipairs(Players:GetPlayers()) do
            if player == Players.LocalPlayer then continue end

            local uid  = player.UserId
            local char = player.Character
            if not playerWatch[uid] then
                resetWatch(uid)
                if playerWatch[uid] then
                    playerWatch[uid]._char = char
                end
            else
                if playerWatch[uid]._char ~= char then
                    resetWatch(uid)
                    playerWatch[uid]._char = char
                end
            end

            local pw = playerWatch[uid]
            if pw.flagged then continue end

            local speed = getHorizontalSpeed(player)
            local state = getHumanoidState(player)

            -- Fly Detect 1: Long Freefall/Jump
            if not pw.flaggedFly1 then
                local isAir = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
                if isAir then
                    if pw.flyStart == nil then
                        pw.flyStart = tick()
                    elseif tick() - pw.flyStart >= FLY1_TIME then
                        pw.flaggedFly1 = true
                        if onCheatDetected then onCheatDetected(player, speed, "FLY1") end
                        task.delay(8, function()
                            if playerWatch[player.UserId] then
                                playerWatch[player.UserId].flaggedFly1 = false
                                playerWatch[player.UserId].flyStart    = nil
                            end
                        end)
                    end
                else
                    pw.flyStart = nil
                end
            end

            -- Fly Detect 2: Torso Tilt / Fake Swim
            if not pw.flaggedFly2 then
                local char_ = player.Character
                if char_ then
                    local torso_ = char_:FindFirstChild("UpperTorso") or char_:FindFirstChild("Torso")
                    local hum_   = char_:FindFirstChildOfClass("Humanoid")
                    if torso_ and hum_ then
                        local upY    = torso_.CFrame.UpVector.Y
                        local state_ = hum_:GetState()
                        local isSwim = state_ == Enum.HumanoidStateType.Swimming
                        local inWater = hum_.FloorMaterial == Enum.Material.Water
                        local isTilted = upY < TILT_THRESHOLD
                        local isSuspect = isTilted or (isSwim and not inWater)
                        
                        if isSuspect then
                            if pw.tiltStart == nil then
                                pw.tiltStart = tick()
                            elseif tick() - pw.tiltStart >= FLY2_TIME then
                                pw.flaggedFly2 = true
                                if onCheatDetected then onCheatDetected(player, speed, "FLY2") end
                                task.delay(8, function()
                                    if playerWatch[player.UserId] then
                                        playerWatch[player.UserId].flaggedFly2 = false
                                        playerWatch[player.UserId].tiltStart   = nil
                                    end
                                end)
                            end
                        else
                            pw.tiltStart = nil
                        end
                    end
                end
            end

            -- Speedhack Detect (Uses Live Settings)
            if not pw.flagged then
                if speed > settings.sprintMax then
                    pw.flagCount = pw.flagCount + 1
                    if pw.flagCount >= 3 then
                        pw.flagged = true
                        if onCheatDetected then onCheatDetected(player, speed, "SPEED_OVER_MAX") end
                        task.delay(8, function()
                            if playerWatch[player.UserId] then
                                playerWatch[player.UserId].flagged    = false
                                playerWatch[player.UserId].flagCount  = 0
                                playerWatch[player.UserId].sprintStart = nil
                            end
                        end)
                    end
                elseif speed > settings.walkMax then
                    pw.flagCount = 0
                    if pw.sprintStart == nil then
                        pw.sprintStart = tick()
                    else
                        local elapsed = tick() - pw.sprintStart
                        if elapsed >= settings.sprintTime then
                            pw.flagged = true
                            if onCheatDetected then onCheatDetected(player, speed, "SPEED_SUSTAINED") end
                            task.delay(8, function()
                                if playerWatch[player.UserId] then
                                    playerWatch[player.UserId].flagged     = false
                                    playerWatch[player.UserId].flagCount   = 0
                                    playerWatch[player.UserId].sprintStart = nil
                                end
                            end)
                        end
                    end
                else
                    pw.sprintStart = nil
                    pw.flagCount = 0
                end
            end
        end

        for uid in pairs(playerWatch) do
            local found = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.UserId == uid then found = true; break end
            end
            if not found then playerWatch[uid] = nil end
        end
    end
end)

