local function createNote(parent, yPos, text)
    local note = Instance.new("TextLabel")
    note.Parent = parent
    note.Size = UDim2.new(0.9, 0, 0, 35)
    if typeof(yPos) == "UDim2" then
        note.Position = yPos
    else
        note.Position = UDim2.new(0.05, 0, 0, yPos)
    end
    note.BackgroundTransparency = 1
    note.TextColor3 = Color3.fromRGB(100, 100, 130)
    note.TextSize = 10
    note.Font = Enum.Font.Gotham
    note.TextXAlignment = Enum.TextXAlignment.Left
    note.TextYAlignment = Enum.TextYAlignment.Top
    note.TextWrapped = true
    note.Text = "Note: " .. text
    return note
end

