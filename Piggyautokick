local AutoFarmEnabled = false
local AutoFarmConnection

-- Auto Farm Logic (collect coins & candies around the map)
local function startAutoFarm()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")

    local worksp = game:GetService("Workspace")
    local runservice = game:GetService("RunService")

    -- Simple auto collector: walk to nearest coin
    if AutoFarmConnection then AutoFarmConnection:Disconnect() end
    AutoFarmConnection = runservice.RenderStepped:Connect(function()
        if not AutoFarmEnabled then return end
        local coins = worksp:GetChildren() -- adjust depending on MM2 coin model names
        -- MM2 stores coins inside a folder or directly in workspace; we need to find them
        -- Usually "Coins" or "CandyBag" etc. Let's generic search.
        local nearest = nil
        local nearestDist = math.huge
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name == "Coin" or obj.Name == "Candy" or obj.Name == "CoinPickup" or obj.Name == "Coin_Model") then
                local dist = (obj.Position - rootPart.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = obj
                end
            end
        end
        if nearest then
            humanoid:MoveTo(nearest.Position)
            if nearestDist < 5 then
                firetouchinterest(rootPart, nearest, 0) -- collect
                wait(0.1)
            end
        end
    end)
end

local function stopAutoFarm()
    AutoFarmEnabled = false
    if AutoFarmConnection then
        AutoFarmConnection:Disconnect()
        AutoFarmConnection = nil
    end
end

MainTab:AddToggle({
    Name = "Auto Farm (Coins & Candies)",
    Default = false,
    Callback = function(Value)
        AutoFarmEnabled = Value
        if Value then
            startAutoFarm()
        else
            stopAutoFarm()
        end
    end
})

