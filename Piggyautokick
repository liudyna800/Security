-- ==================== SCAN REMOTES ====================

local function scanRemotes()
    local list = {}
    local seen = {}
    local servicesToCheck = {}
    
    pcall(function() servicesToCheck[#servicesToCheck+1] = game:GetService("ReplicatedStorage") end)
    pcall(function() servicesToCheck[#servicesToCheck+1] = game:GetService("ReplicatedFirst") end)
    pcall(function() servicesToCheck[#servicesToCheck+1] = Players end)
    pcall(function() servicesToCheck[#servicesToCheck+1] = workspace end)
    
    for _, service in ipairs(servicesToCheck) do
        pcall(function()
            for _, obj in ipairs(service:GetDescendants()) do
                if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and not seen[obj] then
                    seen[obj] = true
                    table.insert(list, obj)
                end
            end
        end)
    end
    return list
end

