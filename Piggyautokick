local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 12)
    c.Parent = p
end

local function gradient(p, c0, c1, rot)
    local g = Instance.new("UIGradient")
    g.Color    = ColorSequence.new(c0, c1)
    g.Rotation = rot or 90
    g.Parent   = p
end

local function stroke(p, color, thick)
    local s = Instance.new("UIStroke")
    s.Color     = color or Color3.fromRGB(255,255,255)
    s.Thickness = thick or 1.5
    s.Transparency = 0.7
    s.Parent    = p
end

-- ═══════════════════════════════════════
-- УТИЛИТЫ БЛОКА
-- ═══════════════════════════════════════
local function getPP(model)
    return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
end

local function getCF(model)
    local pp = getPP(model)
    return pp and pp.CFrame or CFrame.new()
end

local function moveToCF(model, cf)
    if model.PrimaryPart then
        model:SetPrimaryPartCFrame(cf)
    else
        local pp = getPP(model)
        if pp then pp.CFrame = cf end
    end
end

local function getBlockModel(part)
    if not BUILD_FOLDER then return nil end
    local o = part
    while o do
        if o:IsA("Model") and o.Parent == BUILD_FOLDER then return o end
        o = o.Parent
    end
    return nil
end

