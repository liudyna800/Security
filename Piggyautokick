-- ==================== ХУКИ ====================
-- FIX: правильный способ — hookmetamethod или hooking через __namecall/upvalue
-- hookfunction на new Instance не работает корректно во всех executor'ах
-- Используем hookmetamethod (работает в Delta и большинстве exploit executor'ов)

local oldNamecall
oldNamecall = hookmetamethod and hookmetamethod(game, "__namecall", function(self, ...)
    if not Settings.HookEnabled then return oldNamecall(self, ...) end
    
    local method = getnamecallmethod()
    
    if (method == "FireServer") and self:IsA("RemoteEvent") then
        local args = {...}
        local remotePath = self:GetFullName()
        local argsStr = serializeArgs(args)
        -- FIX: pcall чтобы ошибки в addLog не ломали игру
        pcall(addLog, "FireServer", remotePath, argsStr, nil)
        return oldNamecall(self, ...)
        
    elseif (method == "InvokeServer") and self:IsA("RemoteFunction") then
        local args = {...}
        local remotePath = self:GetFullName()
        local argsStr = serializeArgs(args)
        local result = oldNamecall(self, ...)
        pcall(addLog, "InvokeServer", remotePath, argsStr, result)
        return result
        
    elseif (method == "FireAllClients" or method == "FireClient") and self:IsA("RemoteEvent") then
        local args = {...}
        local remotePath = self:GetFullName()
        local argsStr = serializeArgs(args)
        pcall(addLog, method, remotePath, argsStr, nil)
        return oldNamecall(self, ...)
    end
    
    return oldNamecall(self, ...)
end) or nil

-- Fallback если hookmetamethod недоступен
if not oldNamecall then
    local function tryHookFallback()
        -- hookfunction на прототипе RemoteEvent
        local testRE = Instance.new("RemoteEvent")
        local testRF = Instance.new("RemoteFunction")
        
        local oldFS
        pcall(function()
            oldFS = hookfunction(testRE.FireServer, function(self, ...)
                if Settings.HookEnabled and self:IsA("RemoteEvent") then
                    pcall(addLog, "FireServer", self:GetFullName(), serializeArgs({...}), nil)
                end
                return oldFS(self, ...)
            end)
        end)
        
        local oldIS
        pcall(function()
            oldIS = hookfunction(testRF.InvokeServer, function(self, ...)
                if Settings.HookEnabled and self:IsA("RemoteFunction") then
                    local result = oldIS(self, ...)
                    pcall(addLog, "InvokeServer", self:GetFullName(), serializeArgs({...}), result)
                    return result
                end
                return oldIS(self, ...)
            end)
        end)
        
        testRE:Destroy()
        testRF:Destroy()
    end
    pcall(tryHookFallback)
end

