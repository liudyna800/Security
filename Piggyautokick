-- Состояние лимитов
local geminiLimitUntil = 0   -- tick() до которого gemini на паузе
local groqTokensUsed = 0     -- токены в текущей минуте
local groqMinuteStart = tick()
local GROQ_LIMIT = 6000      -- токенов в минуту

local currentProvider = "gemini" -- "gemini" или "groq"
local aiStatusLabel = nil  -- будет задан позже

local function setAiStatus(txt, color)
    if aiStatusLabel then
        aiStatusLabel.Text = txt
        aiStatusLabel.TextColor3 = color or Color3.fromRGB(120, 120, 150)
    end
end

-- Системный промпт — краткие ответы
local SYSTEM_PROMPT = [[Ты помощник в игре Roblox. Отвечай КОРОТКО — максимум 2-3 предложения. Без лишней воды. Будь дружелюбным и по делу.]]

-- История диалога (для контекста)
local chatHistory = {}

local function buildGeminiBody(userMsg)
    local contents = {}
    for _, m in ipairs(chatHistory) do
        table.insert(contents, {
            role = m.role == "assistant" and "model" or "user",
            parts = {{text = m.content}}
        })
    end
    table.insert(contents, {role = "user", parts = {{text = userMsg}}})
    return HttpService:JSONEncode({
        system_instruction = {parts = {{text = SYSTEM_PROMPT}}},
        contents = contents,
        generationConfig = {maxOutputTokens = 200, temperature = 0.7}
    })
end

local function buildGroqBody(userMsg)
    local messages = {{role = "system", content = SYSTEM_PROMPT}}
    for _, m in ipairs(chatHistory) do
        table.insert(messages, {role = m.role, content = m.content})
    end
    table.insert(messages, {role = "user", content = userMsg})
    return HttpService:JSONEncode({
        model = "openai/gpt-oss-120b",
        messages = messages,
        max_tokens = 200,
        temperature = 0.7
    })
end

local function callGemini(userMsg)
    local key = settings.geminiKey
    if key == "" then return nil, "no_key" end
    local url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite-preview:generateContent?key=" .. key
    local ok, res = pcall(function()
        return request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = buildGeminiBody(userMsg)
        })
    end)
    if not ok then return nil, "error" end
    if res.StatusCode == 429 then return nil, "rate_limit" end
    if res.StatusCode ~= 200 then return nil, "error" end
    local data = HttpService:JSONDecode(res.Body)
    local text = data and data.candidates and data.candidates[1]
        and data.candidates[1].content and data.candidates[1].content.parts
        and data.candidates[1].content.parts[1] and data.candidates[1].content.parts[1].text
    return text, nil
end

local function callGroq(userMsg)
    local key = settings.groqKey
    if key == "" then return nil, "no_key" end

    -- Проверка лимита токенов в минуту
    local now = tick()
    if now - groqMinuteStart >= 60 then
        groqTokensUsed = 0
        groqMinuteStart = now
    end

    -- Ждём восстановления если лимит исчерпан
    while groqTokensUsed >= GROQ_LIMIT do
        local waitSec = 60 - (tick() - groqMinuteStart)
        if waitSec <= 0 then
            groqTokensUsed = 0
            groqMinuteStart = tick()
            break
        end
        setAiStatus("⏳ Groq лимит, жду " .. math.ceil(waitSec) .. "с...", Color3.fromRGB(255, 180, 0))
        task.wait(2)
        -- Проверяем вдруг Gemini восстановился
        if tick() > geminiLimitUntil and currentProvider == "groq" then
            setAiStatus("✅ Gemini восстановлен, переключаюсь...", Color3.fromRGB(0, 200, 100))
            currentProvider = "gemini"
            return nil, "switch_to_gemini"
        end
    end

    local ok, res = pcall(function()
        return request({
            Url = "https://api.groq.com/openai/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. key
            },
            Body = buildGroqBody(userMsg)
        })
    end)
    if not ok then return nil, "error" end
    if res.StatusCode == 429 then
        -- Groq тоже лимит — ждём
        groqTokensUsed = GROQ_LIMIT
        return nil, "rate_limit"
    end
    if res.StatusCode ~= 200 then return nil, "error" end
    local data = HttpService:JSONDecode(res.Body)
    local text = data and data.choices and data.choices[1] and data.choices[1].message and data.choices[1].message.content
    -- Считаем примерные токены (1 токен ~ 4 символа)
    if text then
        groqTokensUsed = groqTokensUsed + math.ceil(#text / 4) + math.ceil(#buildGroqBody(userMsg) / 4)
    end
    return text, nil
end

-- Главная функция запроса к ИИ с fallback логикой
local aiWorking = false
local function askAI(userMsg, onReply, onStatus)
    if aiWorking then return end
    aiWorking = true

    task.spawn(function()
        local reply = nil
        local attempt = 0

        while not reply and attempt < 10 do
            attempt = attempt + 1

            -- Проверяем восстановление Gemini
            if currentProvider == "groq" and tick() > geminiLimitUntil then
                currentProvider = "gemini"
                onStatus("✅ Переключился на Gemini", Color3.fromRGB(0, 200, 100))
                task.wait(0.5)
            end

            if currentProvider == "gemini" then
                onStatus("💭 Думаю (Gemini)...", Color3.fromRGB(100, 180, 255))
                local text, err = callGemini(userMsg)
                if text then
                    reply = text
                elseif err == "rate_limit" then
                    geminiLimitUntil = tick() + 65 -- пауза на ~1 минуту
                    currentProvider = "groq"
                    onStatus("⚠️ Gemini лимит → Groq", Color3.fromRGB(255, 180, 0))
                    task.wait(0.5)
                elseif err == "no_key" then
                    onStatus("❌ Нет ключа Gemini!", Color3.fromRGB(255, 80, 80))
                    -- Пробуем Groq
                    currentProvider = "groq"
                else
                    onStatus("❌ Ошибка Gemini", Color3.fromRGB(255, 80, 80))
                    task.wait(2)
                end

            elseif currentProvider == "groq" then
                onStatus("💭 Думаю (Groq)...", Color3.fromRGB(180, 100, 255))
                local text, err = callGroq(userMsg)
                if text then
                    reply = text
                elseif err == "switch_to_gemini" then
                    currentProvider = "gemini"
                elseif err == "no_key" then
                    onStatus("❌ Нет ключа Groq!", Color3.fromRGB(255, 80, 80))
                    task.wait(3)
                    break
                elseif err == "rate_limit" then
                    -- уже ждёт внутри callGroq
                else
                    onStatus("❌ Ошибка Groq", Color3.fromRGB(255, 80, 80))
                    task.wait(2)
                end
            end
        end

        if reply then
            -- Добавляем в историю
            table.insert(chatHistory, {role = "user", content = userMsg})
            table.insert(chatHistory, {role = "assistant", content = reply})
            -- Ограничиваем историю 20 сообщениями
            while #chatHistory > 20 do
                table.remove(chatHistory, 1)
            end
            onReply(reply)
        else
            onReply("⚠️ Не удалось получить ответ. Проверь ключи в Настройках.")
        end

        aiWorking = false
    end)
end

