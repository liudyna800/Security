--[[
    Aim Bot + Auto Shoot для 1v1 PvP
    Поддержка телефона (ТАП по экрану)
]]

local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"))()

local Window = OrionLib:MakeWindow({
    Name = "Aim Bot Mobile",
    HidePremium = false,
    SaveConfig = false
})

local Tab = Window:MakeTab({
    Name = "Aim Bot",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

local players = game.Players
local workspace = game.Workspace
local localPlayer = players.LocalPlayer
local camera = workspace.CurrentCamera
local UserInputService = game:GetService("UserInputService")

-- Состояния
local aimEnabled = false
local autoShoot = false
local aimPart = "Head"
local shootCooldown = 0.1 -- Задержка между выстрелами
local lastShoot = 0

-- Быстрый выстрел
local function shoot()
    if tick() - lastShoot < shootCooldown then return end
    
    local char = localPlayer.Character
    if not char then return end
    
    -- Ищем любое оружие в руках
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Пробуем все RemoteEvent в оружии
    for _, child in ipairs(tool:GetDescendants()) do
        if child:IsA("RemoteEvent") then
            pcall(function()
                child:FireServer()
                lastShoot = tick()
            end)
            return
        end
    end
end

-- Поиск врага
local function getTarget()
    local char = localPlayer.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    
    local nearest = nil
    local minDist = math.huge
    
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local targetChar = player.Character
            local humanoid = targetChar:FindFirstChild("Humanoid")
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            local targetHead = targetChar:FindFirstChild("Head")
            
            if humanoid and humanoid.Health > 0 and targetRoot and targetHead then
                local targetPos = aimPart == "Head" and targetHead.Position or targetRoot.Position
                local dist = (myRoot.Position - targetPos).Magnitude
                
                if dist < minDist then
                    minDist = dist
                    nearest = {
                        player = player,
                        position = targetPos,
                        character = targetChar
                    }
                end
            end
        end
    end
    
    return nearest
end

-- Наведение камеры
local function aimAt(target)
    if not target then return end
    
    local camPos = camera.CFrame.Position
    local lookAt = CFrame.lookAt(camPos, target.position)
    camera.CFrame = camera.CFrame:Lerp(lookAt, 0.3)
end

-- Главный цикл
local function mainLoop()
    while aimEnabled do
        local target = getTarget()
        
        if target then
            aimAt(target)
            
            if autoShoot then
                shoot()
            end
        end
        
        task.wait()
    end
end

-- Тоггл
Tab:AddToggle({
    Name = "🎯 Aim Bot",
    Default = false,
    Color = Color3.fromRGB(255, 100, 100),
    Callback = function(Value)
        aimEnabled = Value
        if Value then
            task.spawn(mainLoop)
            OrionLib:MakeNotification({
                Name = "Aim Bot",
                Content = "Включён! Камера следит за врагом",
                Time = 2,
                Color = Color3.fromRGB(0, 255, 0)
            })
        else
            OrionLib:MakeNotification({
                Name = "Aim Bot",
                Content = "Выключен!",
                Time = 2,
                Color = Color3.fromRGB(255, 0, 0)
            })
        end
    end
})

-- Авто-шут
Tab:AddToggle({
    Name = "🔫 Auto Shoot",
    Default = false,
    Color = Color3.fromRGB(255, 200, 100),
    Callback = function(Value)
        autoShoot = Value
    end
})

-- Большая кнопка СТРЕЛЯТЬ для телефона
Tab:AddButton({
    Name = "🔫 СТРЕЛЯТЬ (нажми на меня)",
    Callback = function()
        shoot()
    end
})

-- Часть тела
Tab:AddDropdown({
    Name = "Целиться в",
    Default = "Head",
    Options = {"Head", "HumanoidRootPart"},
    Callback = function(Value)
        aimPart = Value
    end
})

-- Бинд на выстрел (для ПК)
Tab:AddBind({
    Name = "Клавиша выстрела (ПК)",
    Default = Enum.KeyCode.F,
    Hold = false,
    Callback = function()
        shoot()
    end
})

Tab:AddLabel("📱 Для телефона:")
Tab:AddLabel("1. Включи Aim Bot")
Tab:AddLabel("2. Включи Auto Shoot")
Tab:AddLabel("3. Или жми кнопку СТРЕЛЯТЬ")

OrionLib:Init()
