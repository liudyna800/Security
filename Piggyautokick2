end

-- Функция сохранения ВСЕХ данных в файл
local function saveAllResults(filename)
    local results = scanExplorer()
    local HttpService = game:GetService("HttpService")
    
    -- Создаем полный дамп всех данных
    local fullData = {
        GameName = game.Name or "Unknown",
        PlaceId = game.PlaceId,
        ScanTime = os.date("%Y-%m-%d %H:%M:%S"),
        TotalObjects = {
            Scripts = #results.scripts,
            LocalScripts = #results.localScripts,
            Modules = #results.modules,
            Parts = #results.parts,
            Models = #results.models,
            Tools = #results.tools,
            Values = #results.values,
            GUI = #results.gui,
            Players = #results.players
        },
        Scripts = results.scripts,
        LocalScripts = results.localScripts,
        Modules = results.modules,
        Parts = results.parts,
        Models = results.models,
        Tools = results.tools,
        Values = results.values,
        GUI = results.gui,
        Players = results.players
    }
    
    -- Сохраняем в JSON
    local jsonData = HttpService:JSONEncode(fullData)
    writefile(filename .. ".json", jsonData)
    
    -- Также сохраняем в читаемом TXT формате
    local txtData = "=== EXPLORER SCAN RESULTS ===\n"
    txtData = txtData .. "Game: " .. (game.Name or "Unknown") .. "\n"
    txtData = txtData .. "Place ID: " .. game.PlaceId .. "\n"
    txtData = txtData .. "Scan Time: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n"
    txtData = txtData .. "================================\n\n"
    
    -- Scripts
    txtData = txtData .. "=== SCRIPTS (" .. #results.scripts .. ") ===\n"
    for i, script in ipairs(results.scripts) do
        txtData = txtData .. i .. ". " .. script.Path .. "\n"
        txtData = txtData .. "   Disabled: " .. tostring(script.Disabled) .. "\n"
    end
    txtData = txtData .. "\n"
    
    -- LocalScripts
    txtData = txtData .. "=== LOCAL SCRIPTS (" .. #results.localScripts .. ") ===\n"
    for i, script in ipairs(results.localScripts) do
        txtData = txtData .. i .. ". " .. script.Path .. "\n"
        txtData = txtData .. "   Disabled: " .. tostring(script.Disabled) .. "\n"
    end
    txtData = txtData .. "\n"
    
    -- Modules
    txtData = txtData .. "=== MODULES (" .. #results.modules .. ") ===\n"
    for i, module in ipairs(results.modules) do
        txtData = txtData .. i .. ". " .. module.Path .. "\n"
    end
    txtData = txtData .. "\n"
    
    -- Parts
    txtData = txtData .. "=== PARTS (" .. #results.parts .. ") ===\n"
    for i, part in ipairs(results.parts) do
        txtData = txtData .. i .. ". " .. part.Path .. "\n"
        txtData = txtData .. "   Anchored: " .. tostring(part.Anchored) .. "\n"
        txtData = txtData .. "   CanCollide: " .. tostring(part.CanCollide) .. "\n"
    end
    txtData = txtData .. "\n"
    
    -- Models
    txtData = txtData .. "=== MODELS (" .. #results.models .. ") ===\n"
    for i, model in ipairs(results.models) do
        txtData = txtData .. i .. ". " .. model.Path .. "\n"
        txtData = txtData .. "   PrimaryPart: " .. model.PrimaryPart .. "\n"
    end
    txtData = txtData .. "\n"
    
    -- Tools
    txtData = txtData .. "=== TOOLS (" .. #results.tools .. ") ===\n"
    for i, tool in ipairs(results.tools) do
        txtData = txtData .. i .. ". " .. tool.Path .. "\n"
        txtData = txtData .. "   CanBeDropped: " .. tostring(tool.CanBeDropped) .. "\n"
    end
    txtData = txtData .. "\n"
    
    -- Values
    txtData = txtData .. "=== VALUES (" .. #results.values .. ") ===\n"
    for i, value in ipairs(results.values) do
        txtData = txtData .. i .. ". " .. value.Path .. "\n"
        txtData = txtData .. "   Value: " .. value.Value .. "\n"
    end
    txtData = txtData .. "\n"
    
    -- GUI
    txtData = txtData .. "=== GUI (" .. #results.gui .. ") ===\n"
    for i, gui in ipairs(results.gui) do
        txtData = txtData .. i .. ". " .. gui.Path .. "\n"
        txtData = txtData .. "   Enabled: " .. tostring(gui.Enabled) .. "\n"
    end
    txtData = txtData .. "\n"
    
    -- Players
    txtData = txtData .. "=== PLAYERS (" .. #results.players .. ") ===\n"
    for i, player in ipairs(results.players) do
        txtData = txtData .. i .. ". " .. player.Path .. "\n"
        txtData = txtData .. "   UserId: " .. player.UserId .. "\n"
    end
    
    writefile(filename .. ".txt", txtData)
    
    return filename
end

