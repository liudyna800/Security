    createListTab("📝 LocalScripts", "rbxassetid://7733968881", results.localScripts, Color3.fromRGB(100, 255, 100))
    createListTab("📦 Modules", "rbxassetid://7733968881", results.modules, Color3.fromRGB(100, 100, 255))
