-- Функция глубокого сканирования
local function scanExplorer()
    local results = {
        scripts = {},
        localScripts = {},
        modules = {},
        parts = {},
        models = {},
        tools = {},
        values = {},
        gui = {},
        players = {}
    }
    
    local function scanObject(obj, path)
        path = path .. "." .. obj.Name
        
        -- Сбор важных объектов
        if obj:IsA("Script") then
            table.insert(results.scripts, {
                Name = obj.Name,
                Path = path,
                Class = obj.ClassName,
                Disabled = obj.Disabled,
                Source = obj.Source
            })
        elseif obj:IsA("LocalScript") then
            table.insert(results.localScripts, {
                Name = obj.Name,
                Path = path,
                Class = obj.ClassName,
                Disabled = obj.Disabled,
                Source = obj.Source
            })
        elseif obj:IsA("ModuleScript") then
            table.insert(results.modules, {
                Name = obj.Name,
                Path = path,
                Class = obj.ClassName,
                Source = obj.Source
            })
        elseif obj:IsA("BasePart") then
            table.insert(results.parts, {
                Name = obj.Name,
                Path = path,
                Class = obj.ClassName,
                Position = obj.Position,
                Anchored = obj.Anchored,
                CanCollide = obj.CanCollide,
                Transparency = obj.Transparency
            })
        elseif obj:IsA("Model") then
            table.insert(results.models, {
                Name = obj.Name,
                Path = path,
                Class = obj.ClassName,
                PrimaryPart = obj.PrimaryPart and obj.PrimaryPart.Name or "None"
            })
        elseif obj:IsA("Tool") then
            table.insert(results.tools, {
                Name = obj.Name,
                Path = path,
                Class = obj.ClassName,
                CanBeDropped = obj.CanBeDropped,
                RequiresHandle = obj.RequiresHandle
            })
        elseif obj:IsA("ValueBase") then
            table.insert(results.values, {
                Name = obj.Name,
                Path = path,
                Class = obj.ClassName,
                Value = tostring(obj.Value)
            })
        elseif obj:IsA("ScreenGui") or obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            table.insert(results.gui, {
                Name = obj.Name,
                Path = path,
                Class = obj.ClassName,
                Enabled = obj.Enabled,
                ResetOnSpawn = obj.ResetOnSpawn
            })
        elseif obj:IsA("Player") then
            if obj ~= game.Players.LocalPlayer then
                table.insert(results.players, {
                    Name = obj.Name,
                    Path = path,
                    Class = obj.ClassName,
                    UserId = obj.UserId,
                    Character = obj.Character and obj.Character.Name or "None"
                })
            end
        end
        
        -- Рекурсивное сканирование
        for _, child in ipairs(obj:GetChildren()) do
            scanObject(child, path)
        end
    end
    
    -- Запуск сканирования
    scanObject(game, "game")
    
    return results
end

-- Создание окна результатов
local function createResultsWindow(results)
