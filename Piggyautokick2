--[[
    Aim Bot для 1v1 PvP (MM2 Style)
    Работает с BasicGun
]]

local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"))()

local Window = OrionLib:MakeWindow({
    Name = "Aim Bot 1v1",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "AimBot1v1"
})

local MainTab = Window:MakeTab({
    Name = "Aim Bot",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

local players = game:GetService("Players")
local workspace = game:GetService("Workspace")
local localPlayer = players.LocalPlayer
local mouse = localPlayer:GetMouse()

-- Переменные
local aimEnabled = false
local aimKey = Enum.UserInputType.MouseButton2 -- ПКМ по умолчанию
local fovRadius = 200
local aimSmoothness = 1
local aimPart = "Head" -- Куда целиться
local autoShoot = false

-- Функция получения оружия
local function getCurrentGun()
    local char = localPlayer.Character
    if not char then return nil end
    
    -- Ищем BasicGun в персонаже
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == "BasicGun" then
            return tool
        end
    end
    
    -- Ищем в Backpack
    local backpack = localPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == "BasicGun" then
                return tool
            end
        end
    end
    
    return nil
end

-- Функция выстрела
local function shoot()
    local gun = getCurrentGun()
    if not gun then return end
    
    -- Через RemoteEvent Fire
    local fireEvent = gun:FindFirstChild("Fire")
    if fireEvent and fireEvent:IsA("RemoteEvent") then
        fireEvent:FireServer()
        return true
    end
    
    -- Через FireWeapon
    local fireWeaponEvent = gun:FindFirstChild("FireWeapon")
    if fireWeaponEvent and fireWeaponEvent:IsA("RemoteEvent") then
        fireWeaponEvent:FireServer()
        return true
    end
    
    -- Через RemoteEvent
    for _, child in ipairs(gun:GetChildren()) do
        if child:IsA("RemoteEvent") then
            child:FireServer()
            return true
        end
    end
    
    return false
end

-- Функция поиска ближайшего врага
local function getClosestEnemy()
    local closest = nil
    local shortestDistance = fovRadius
    
    local char = localPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local targetChar = player.Character
            local targetHumanoid = targetChar:FindFirstChild("Humanoid")
            
            -- Проверка жив ли игрок
            if targetHumanoid and targetHumanoid.Health > 0 then
                local targetPart = targetChar:FindFirstChild(aimPart)
                if not targetPart then
                    targetPart = targetChar:FindFirstChild("Head") -- Фолбек на голову
                end
                
                if targetPart then
                    local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position)
                    
                    if onScreen then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                        
                        if distance < shortestDistance then
                            shortestDistance = distance
                            closest = {
                                player = player,
                                part = targetPart,
                                position = targetPart.Position,
                                screenPos = screenPos
                            }
                        end
                    end
                end
            end
        end
    end
    
    return closest
end

-- Основной цикл аимбота
local function aimBotLoop()
    while aimEnabled do
        if autoShoot then
            local target = getClosestEnemy()
            if target then
                -- Наводим камеру
                workspace.CurrentCamera.CFrame = CFrame.new(
                    workspace.CurrentCamera.CFrame.Position,
                    target.position
                )
                
                -- Стреляем
                shoot()
            end
        else
            -- Режим зажатия кнопки
            if mouse.Button2Down or (aimKey == Enum.UserInputType.MouseButton1 and mouse.Button1Down) then
                local target = getClosestEnemy()
                if target then
                    -- Плавное наведение
                    local targetCFrame = CFrame.new(
                        workspace.CurrentCamera.CFrame.Position,
                        target.position
                    )
                    workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame:Lerp(targetCFrame, aimSmoothness)
                    
                    -- Авто выстрел
                    if autoShoot then
                        shoot()
                    end
                end
            end
        end
        
        task.wait()
    end
end

-- Запуск аимбота
local function startAimBot()
    if not aimEnabled then
        aimEnabled = true
        task.spawn(aimBotLoop)
        OrionLib:MakeNotification({
            Name = "Aim Bot",
            Content = "✅ Aim Bot включён!",
            Time = 3,
            Color = Color3.fromRGB(0, 255, 0)
        })
    end
end

-- Остановка аимбота
local function stopAimBot()
    aimEnabled = false
    OrionLib:MakeNotification({
        Name = "Aim Bot",
        Content = "❌ Aim Bot выключен!",
        Time = 3,
        Color = Color3.fromRGB(255, 0, 0)
    })
end

-- Тоггл аимбота
MainTab:AddToggle({
    Name = "🎯 Aim Bot",
    Default = false,
    Color = Color3.fromRGB(255, 100, 100),
    Callback = function(Value)
        if Value then
            startAimBot()
        else
            stopAimBot()
        end
    end
})

-- Режим Auto Shoot
MainTab:AddToggle({
    Name = "🔫 Auto Shoot (авто-стрельба)",
    Default = false,
    Color = Color3.fromRGB(255, 200, 100),
    Callback = function(Value)
        autoShoot = Value
    end
})

-- Кнопка для ручного выстрела
MainTab:AddBind({
    Name = "🔥 Клавиша выстрела",
    Default = Enum.KeyCode.F,
    Hold = false,
    Callback = function()
        if shoot() then
            print("Выстрел!")
        else
            OrionLib:MakeNotification({
                Name = "Ошибка",
                Content = "Оружие не найдено! Возьмите BasicGun",
                Time = 2,
                Color = Color3.fromRGB(255, 100, 100)
            })
        end
    end
})

-- Часть тела для наведения
local partDropdown = MainTab:AddDropdown({
    Name = "Куда целиться",
    Default = "Head",
    Options = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso"},
    Callback = function(Value)
        aimPart = Value
    end
})

-- Радиус FOV
MainTab:AddSlider({
    Name = "Радиус захвата цели",
    Min = 50,
    Max = 500,
    Default = 200,
    Color = Color3.fromRGB(255, 100, 100),
    Increment = 10,
    ValueName = "пикселей",
    Callback = function(Value)
        fovRadius = Value
    end
})

-- Плавность наведения
MainTab:AddSlider({
    Name = "Плавность наведения",
    Min = 0.1,
    Max = 1,
    Default = 0.5,
    Color = Color3.fromRGB(100, 100, 255),
    Increment = 0.1,
    ValueName = "",
    Callback = function(Value)
        aimSmoothness = Value
    end
})

-- FOV Круг (визуальный)
local fovCircle = Drawing.new("Circle")
fovCircle.Color = Color3.fromRGB(255, 100, 100)
fovCircle.Thickness = 1
fovCircle.Transparency = 0.5
fovCircle.Visible = false

MainTab:AddToggle({
    Name = "Показать FOV круг",
    Default = false,
    Color = Color3.fromRGB(100, 255, 100),
    Callback = function(Value)
        fovCircle.Visible = Value
        if Value then
            task.spawn(function()
                while fovCircle.Visible do
                    fovCircle.Radius = fovRadius
                    fovCircle.Position = Vector2.new(mouse.X, mouse.Y + 36)
                    task.wait()
                end
            end)
        end
    end
})

-- Информация
MainTab:AddLabel("🎮 Управление:")
MainTab:AddLabel("ПКМ (зажать) - Наведение на цель")
MainTab:AddLabel("F - Ручной выстрел")
MainTab:AddLabel("Auto Shoot - Авто стрельба")
MainTab:AddLabel("Возьмите BasicGun чтобы работало")

-- Авто-подбор оружия
MainTab:AddButton({
    Name = "🔫 Авто-взять BasicGun",
    Callback = function()
        local char = localPlayer.Character
        if not char then
            OrionLib:MakeNotification({
                Name = "Ошибка",
                Content = "Персонаж не загружен!",
                Time = 2,
                Color = Color3.fromRGB(255, 0, 0)
            })
            return
        end
        
        -- Ищем BasicGun в Workspace
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj.Name == "BasicGun" and not obj.Parent:IsA("Player") then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    obj.Handle.CFrame = root.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.1)
                    obj.Parent = localPlayer.Backpack
                end
                OrionLib:MakeNotification({
                    Name = "Успех",
                    Content = "BasicGun в рюкзаке!",
                    Time = 2,
                    Color = Color3.fromRGB(0, 255, 0)
                })
                return
            end
        end
        
        OrionLib:MakeNotification({
            Name = "Ошибка",
            Content = "BasicGun не найден на карте",
            Time = 2,
            Color = Color3.fromRGB(255, 0, 0)
        })
    end
})

OrionLib:Init()

OrionLib:MakeNotification({
    Name = "Aim Bot 1v1 готов!",
    Content = "Жми ПКМ для наведения\nF для выстрела",
    Time = 5,
    Color = Color3.fromRGB(0, 255, 0)
})

-- Авто-уничтожение FOV круга при выходе
localPlayer.OnTeleport:Connect(function(state)
    fovCircle:Remove()
end)
