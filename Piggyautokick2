-- Поиск конкретного скрипта
Tab:AddTextbox({
    Name = "Поиск скрипта по имени",
    Default = "",
    TextDisappear = "Имя скрипта...",
    Callback = function(name)
        if name ~= "" then
            local results = fastScan()
            local found = {}
            
            local allScripts = {}
            for _, cat in ipairs({results.scripts, results.localScripts, results.modules}) do
                for _, path in ipairs(cat) do
                    table.insert(allScripts, path)
                end
            end
            
            for _, path in ipairs(allScripts) do
                if string.find(string.lower(path), string.lower(name)) then
                    table.insert(found, path)
                end
            end
            
            if #found > 0 then
                setclipboard(table.concat(found, "\n"))
                OrionLib:MakeNotification({
                    Name = "Найдено: " .. #found,
                    Content = "Скопированы в буфер обмена",
                    Time = 3,
                    Color = Color3.fromRGB(0, 255, 0)
                })
            else
                OrionLib:MakeNotification({
                    Name = "Не найдено",
                    Content = "Ничего не найдено по запросу: " .. name,
                    Time = 3,
                    Color = Color3.fromRGB(255, 100, 100)
                })
            end
        end
    end
})

