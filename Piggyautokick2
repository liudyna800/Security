--[[
    ПРОСТОЙ AIM BOT (без перехватов)
    Берёт позицию врага и отправляет выстрел туда
]]

local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"))()

local Window = OrionLib:MakeWindow({
    Name = "Simple Aim",
    HidePremium = false,
    SaveConfig = false
})

local Tab = Window:MakeTab({Name = "Aim", PremiumOnly = false})

local players = game.Players
local localPlayer = players.LocalPlayer
local workspace = game.Workspace

local enabled = false
local aimPart = "Head"

-- Найти врага
local function getTarget()
    local char = localPlayer.Character
    if not char then return nil end
    
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local hum = p.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local part = p.Character:FindFirstChild(aimPart) or p.Character:FindFirstChild("Head")
                if part then
                    return part
                end
            end
        end
    end
    return nil
end

-- Выстрел
local function shoot()
    local target = getTarget()
    if not target then return end
    
    local char = localPlayer.Character
    if not char then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Находим RemoteEvent в оружии
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            pcall(function()
                v:FireServer(target.Position)
            end)
            break
        end
    end
end

-- Auto shoot
local function autoLoop()
    while enabled do
        shoot()
        wait(0.1)
    end
end

-- UI
Tab:AddToggle({
    Name = "Auto Shoot",
    Default = false,
    Callback = function(v)
        enabled = v
        if v then spawn(autoLoop) end
    end
})

Tab:AddDropdown({
    Name = "Куда",
    Default = "Head",
    Options = {"Head", "HumanoidRootPart"},
    Callback = function(v) aimPart = v end
})

Tab:AddButton({
    Name = "ВЫСТРЕЛ",
    Callback = shoot
})

OrionLib:Init()
