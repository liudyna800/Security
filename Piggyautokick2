local players = game:GetService("Players")
local workspace = game:GetService("Workspace")
local localPlayer = players.LocalPlayer
local RunService = game:GetService("RunService")

-- Состояния
local silentAim = false
local autoShoot = false
local aimPart = "Head"
local shootDelay = 0.1
local lastShot = 0

-- Получаем ВСЕ RemoteEvent из оружия в руках
local function getAllRemotes()
    local char = localPlayer.Character
    if not char then return {} end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return {} end
    
    local remotes = {}
    for _, child in ipairs(tool:GetDescendants()) do
        if child:IsA("RemoteEvent") then
            table.insert(remotes, child)
        end
    end
    
    return remotes
end

-- Поиск ближайшего врага
local function getNearestEnemyPart()
    local char = localPlayer.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    
    local nearest = nil
    local minDist = math.huge
    
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            
            if humanoid and humanoid.Health > 0 then
                local part = player.Character:FindFirstChild(aimPart)
                if not part then
                    part = player.Character:FindFirstChild("Head")
                end
                
                if part then
                    local dist = (myRoot.Position - part.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = part
                    end
                end
            end
        end
    end
    
    return nearest
end

-- Функция выстрела с подменой позиции
local function shootAtEnemy()
    local target = getNearestEnemyPart()
    if not target then return false end
    
    local remotes = getAllRemotes()
    if #remotes == 0 then return false end
    
    -- Отправляем через все найденные RemoteEvent
    for _, remote in ipairs(remotes) do
        pcall(function()
            -- Пробуем разные форматы аргументов
            remote:FireServer(target.Position)
        end)
        pcall(function()
            remote:FireServer(target.Position, target)
        end)
        pcall(function()
            remote:FireServer({Position = target.Position, Hit = target.Position, Origin = target.Position})
        end)
    end
    
    lastShot = tick()
    return true
end

-- Перехват FireServer для Silent Aim
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if method == "FireServer" and silentAim then
        if self:IsA("RemoteEvent") then
            local remoteName = self.Name
            -- Проверяем что это оружейный RemoteEvent
            if remoteName == "Fire" or remoteName == "FireWeapon" or remoteName == "RemoteEvent" then
                local target = getNearestEnemyPart()
                if target then
                    local newArgs = {}
                    for _, arg in ipairs(args) do
                        if typeof(arg) == "Vector3" then
                            newArgs[#newArgs + 1] = target.Position
                        elseif typeof(arg) == "CFrame" then
                            newArgs[#newArgs + 1] = CFrame.new(target.Position)
                        elseif type(arg) == "table" then
                            local t = {}
                            for k, v in pairs(arg) do
                                if k == "Position" or k == "Origin" or k == "Hit" then
                                    t[k] = target.Position
                                elseif k == "Direction" then
                                    t[k] = (target.Position - workspace.CurrentCamera.CFrame.Position).Unit
                                else
                                    t[k] = v
                                end
                            end
                            newArgs[#newArgs + 1] = t
                        else
                            newArgs[#newArgs + 1] = arg
                        end
                    end
                    return oldNamecall(self, unpack(newArgs))
                end
            end
        end
    end
    
    return oldNamecall(self, ...)
end)

-- Авто-шут цикл
local function autoShootLoop()
    while autoShoot and silentAim do
        if tick() - lastShot >= shootDelay then
            local char = localPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    shootAtEnemy()
                end
            end
        end
        task.wait(0.05)
    end
end

