local detectedRemote = nil
local detectedRemoteName = "Не найден"

-- Функция поиска RemoteEvent в оружии
local function findFireRemote()
    local char = localPlayer.Character
    if not char then return nil end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return nil end
    
    -- Ищем все RemoteEvent в оружии
    for _, child in ipairs(tool:GetDescendants()) do
        if child:IsA("RemoteEvent") then
            return child
        end
    end
    
    return nil
end

-- Поиск ближайшего врага
local function getNearestEnemy()
    local char = localPlayer.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    
    local nearest = nil
    local minDist = math.huge
    
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local targetChar = player.Character
            local humanoid = targetChar:FindFirstChild("Humanoid")
            
            if humanoid and humanoid.Health > 0 then
                local targetPart = targetChar:FindFirstChild(aimPart)
                if not targetPart then
                    targetPart = targetChar:FindFirstChild("Head")
                end
                
                if targetPart then
                    local dist = (myRoot.Position - targetPart.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = targetPart
                    end
                end
            end
        end
    end
    
    return nearest
end

-- Перехват FireServer (Silent Aim)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if method == "FireServer" and silentAim then
        if self:IsA("RemoteEvent") then
            local target = getNearestEnemy()
            if target then
                -- Подменяем позицию на врага
                local newArgs = {}
                for _, arg in ipairs(args) do
                    if typeof(arg) == "Vector3" then
                        newArgs[#newArgs + 1] = target.Position
                    elseif typeof(arg) == "CFrame" then
                        newArgs[#newArgs + 1] = CFrame.new(target.Position)
                    elseif type(arg) == "table" then
                        local newTable = {}
                        for k, v in pairs(arg) do
                            if k == "Position" or k == "Origin" or k == "Hit" or k == "lookVector" then
                                newTable[k] = target.Position
                            elseif k == "Direction" then
                                newTable[k] = (target.Position - workspace.CurrentCamera.CFrame.Position).Unit
                            else
                                newTable[k] = v
                            end
                        end
                        newArgs[#newArgs + 1] = newTable
                    else
                        newArgs[#newArgs + 1] = arg
                    end
                end
                return oldNamecall(self, unpack(newArgs))
            end
        end
    end
    
    return oldNamecall(self, ...)
end)

-- Авто-шут цикл
local function autoShootLoop()
    while autoShootEnabled and silentAim do
        local char = localPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                -- Активируем оружие
                local remote = findFireRemote()
                if remote then
                    pcall(function()
                        remote:FireServer(Vector3.new(0, 0, 0))
                    end)
                else
                    -- Альтернативный метод: Activate
                    pcall(function()
                        tool:Activate()
                        task.wait(0.05)
                        tool:Deactivate()
                    end)
                end
            end
        end
        task.wait(0.12)
    end
end

-- Сканер всех RemoteEvent в игре
local function scanAllRemotes()
    local found = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(found, obj:GetFullName())
        end
    end
    for _, obj in ipairs(game.ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(found, obj:GetFullName())
        end
    end
    return found
end

