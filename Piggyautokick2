local players = game:GetService("Players")
local localPlayer = players.LocalPlayer
local workspace = game:GetService("Workspace")
local camera = workspace.CurrentCamera

local silentAim = false
local autoShoot = false
local aimPart = "Head"
local shootDelay = 0.1
local lastShot = 0

-- Ближайший враг
local function getTarget()
    local char = localPlayer.Character
    if not char then return nil end
    
    local nearest = nil
    local minDist = math.huge
    
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local part = player.Character:FindFirstChild(aimPart) or player.Character:FindFirstChild("Head")
                if part then
                    local dist = (char:GetPivot().Position - part.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = part
                    end
                end
            end
        end
    end
    
    return nearest
end

-- Выстрел в цель
local function fireAtEnemy()
    local target = getTarget()
    if not target then return false end
    
    local char = localPlayer.Character
    if not char then return false end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return false end
    
    -- Ищем RemoteEvent
    local remote = nil
    for _, child in ipairs(tool:GetDescendants()) do
        if child:IsA("RemoteEvent") then
            remote = child
            break
        end
    end
    
    if remote then
        pcall(function()
            remote:FireServer(target.Position)
            lastShot = tick()
        end)
        return true
    end
    
    return false
end

-- Auto Shoot цикл (через spawn + while wait)
local function autoShootLoop()
    while autoShoot and silentAim do
        if tick() - lastShot >= shootDelay then
            fireAtEnemy()
        end
        wait(0.05)
    end
end

-- ПЕРЕХВАТ (Silent Aim)
local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldNamecall = mt.__namecall

mt.__namecall = function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if method == "FireServer" and silentAim and self:IsA("RemoteEvent") then
        local target = getTarget()
        if target then
            local newArgs = {}
            for _, arg in ipairs(args) do
                if typeof(arg) == "Vector3" then
                    newArgs[#newArgs + 1] = target.Position
                elseif typeof(arg) == "CFrame" then
                    newArgs[#newArgs + 1] = CFrame.new(target.Position)
                elseif type(arg) == "table" then
                    local t = {}
                    for k, v in pairs(arg) do
                        if k == "Position" or k == "Origin" or k == "Hit" then
                            t[k] = target.Position
                        else
                            t[k] = v
                        end
                    end
                    newArgs[#newArgs + 1] = t
                else
                    newArgs[#newArgs + 1] = arg
                end
            end
            return oldNamecall(self, unpack(newArgs))
        end
    end
    
    return oldNamecall(self, ...)
end

setreadonly(mt, true)

