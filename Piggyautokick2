-- Поиск по имени
MainTab:AddTextbox({
    Name = "Поиск по имени",
    Default = "",
    TextDisappear = "Введите имя объекта",
    Callback = function(searchTerm)
        if searchTerm ~= "" then
            local results = scanExplorer()
            local found = {}
            
            -- Поиск во всех категориях
            for category, items in pairs(results) do
                for _, item in ipairs(items) do
                    if string.find(string.lower(item.Name), string.lower(searchTerm)) then
                        table.insert(found, item.Path)
                    end
                end
            end
            
            if #found > 0 then
                local msg = "Найдено: " .. #found .. " объектов\n" .. table.concat(found, "\n", 1, math.min(5, #found))
                if #found > 5 then
                    msg = msg .. "\n... и еще " .. (#found - 5) .. " объектов"
                end
                OrionLib:MakeNotification({
                    Name = "Результаты поиска",
                    Content = msg,
                    Time = 10,
                    Color = Color3.fromRGB(100, 255, 100)
                })
            else
                OrionLib:MakeNotification({
                    Name = "Не найдено",
                    Content = "Объекты с именем '" .. searchTerm .. "' не найдены",
                    Time = 3,
                    Color = Color3.fromRGB(255, 100, 100)
                })
            end
        end
    end
})

