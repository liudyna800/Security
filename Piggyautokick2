-- Состояния
local silentAim = false
local autoShoot = false
local aimPart = "Head"
local teamCheck = false

-- Главная функция Silent Aim
local function getNearestEnemy()
    local char = localPlayer.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    
    local nearest = nil
    local minDist = math.huge
    
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local targetChar = player.Character
            local humanoid = targetChar:FindFirstChild("Humanoid")
            
            -- Проверка команды
            if teamCheck and player.Team == localPlayer.Team then
                continue
            end
            
            if humanoid and humanoid.Health > 0 then
                local targetPart = targetChar:FindFirstChild(aimPart)
                if not targetPart then
                    targetPart = targetChar:FindFirstChild("Head")
                end
                
                if targetPart then
                    local dist = (myRoot.Position - targetPart.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = targetPart
                    end
                end
            end
        end
    end
    
    return nearest
end

-- Перехват выстрела (Silent Aim)
local oldFireServer
local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldNamecall = mt.__namecall

mt.__namecall = function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if method == "FireServer" and silentAim then
        if self:IsA("RemoteEvent") then
            local target = getNearestEnemy()
            if target then
                -- Меняем MousePos на позицию врага
                local newArgs = {}
                for i, arg in ipairs(args) do
                    if typeof(arg) == "Vector3" then
                        table.insert(newArgs, target.Position)
                    elseif type(arg) == "table" and arg.Position then
                        -- Если это Mouse позиция
                        local newMouse = {}
                        for k, v in pairs(arg) do
                            if k == "Position" or k == "Origin" then
                                newMouse[k] = target.Position
                            elseif k == "Hit" then
                                newMouse[k] = target.Position
                            else
                                newMouse[k] = v
                            end
                        end
                        table.insert(newArgs, newMouse)
                    else
                        table.insert(newArgs, arg)
                    end
                end
                
                return oldNamecall(self, unpack(newArgs))
            end
        end
    end
    
    return oldNamecall(self, ...)
end

-- Авто-шут цикл
local function autoShootLoop()
    while autoShoot and silentAim do
        local char = localPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                -- Активируем оружие (клик)
                pcall(function()
                    tool:Activate()
                    task.wait(0.1)
                    tool:Deactivate()
                end)
            end
        end
        task.wait(0.15) -- Задержка между выстрелами
    end
end

