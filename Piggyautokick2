    createListTab("🏗️ Models", "rbxassetid://7734056608", results.models, Color3.fromRGB(255, 200, 100))
    createListTab("🛠️ Tools", "rbxassetid://7734056608", results.tools, Color3.fromRGB(255, 100, 200))
    createListTab("📊 Values", "rbxassetid://7734056608", results.values, Color3.fromRGB(100, 255, 200))
    createListTab("🎨 GUI", "rbxassetid://7734056608", results.gui, Color3.fromRGB(200, 150, 255))
