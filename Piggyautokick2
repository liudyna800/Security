        SaveConfig = false
    })
    
    local createListTab = function(name, icon, data, color)
        local tab = ResultsWindow:MakeTab({Name = name, Icon = icon, PremiumOnly = false})
        local section = tab:AddSection({Name = "Найдено: " .. #data})
        
        for _, item in ipairs(data) do
            tab:AddButton({
                Name = item.Path or item.Name,
                Callback = function()
                    setclipboard(item.Path or item.Name)
                    OrionLib:MakeNotification({
                        Name = "Скопировано",
                        Content = "Путь скопирован в буфер обмена",
