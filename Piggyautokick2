-- Быстрое сканирование без зависаний
local function fastScan()
    local results = {
        scripts = {},
        localScripts = {},
        modules = {},
        remoteEvents = {},
        remoteFunctions = {},
        parts = {},
        models = {},
        tools = {},
        values = {},
        guis = {}
    }
    
    -- Сканируем только важное, не глубже 5 уровней
    local function scan(obj, depth)
        if depth > 5 then return end
        
        local class = obj.ClassName
        
        if class == "Script" then
            table.insert(results.scripts, obj:GetFullName())
        elseif class == "LocalScript" then
            table.insert(results.localScripts, obj:GetFullName())
        elseif class == "ModuleScript" then
            table.insert(results.modules, obj:GetFullName())
        elseif class == "RemoteEvent" then
            table.insert(results.remoteEvents, obj:GetFullName())
        elseif class == "RemoteFunction" then
            table.insert(results.remoteFunctions, obj:GetFullName())
        elseif class == "Tool" then
            table.insert(results.tools, obj:GetFullName())
        elseif class == "ScreenGui" or class == "BillboardGui" then
            table.insert(results.guis, obj:GetFullName())
        end
        
        for _, child in ipairs(obj:GetChildren()) do
            scan(child, depth + 1)
        end
    end
    
    scan(game, 1)
    return results
end

-- Сохранение в файл
local function saveToFile()
    local results = fastScan()
    local text = "=== EXPLORER SCAN RESULTS ===\n"
    text = text .. "Game: " .. game.Name .. "\n"
    text = text .. "Place ID: " .. game.PlaceId .. "\n"
    text = text .. "Time: " .. os.date() .. "\n\n"
    
    local function addCategory(name, items)
        text = text .. "=== " .. name .. " (" .. #items .. ") ===\n"
        for i, item in ipairs(items) do
            text = text .. i .. ". " .. item .. "\n"
        end
        text = text .. "\n"
    end
    
    addCategory("SCRIPTS", results.scripts)
    addCategory("LOCAL SCRIPTS", results.localScripts)
    addCategory("MODULES", results.modules)
    addCategory("REMOTE EVENTS", results.remoteEvents)
    addCategory("REMOTE FUNCTIONS", results.remoteFunctions)
    addCategory("TOOLS", results.tools)
    addCategory("GUIS", results.guis)
    
    local filename = "scan_" .. game.PlaceId .. ".txt"
    writefile(filename, text)
    
    return filename, results
end

