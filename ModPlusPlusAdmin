-- Текстовые метки статистики
local function createStatLabel(name, defaultText, color)
    local lbl = Instance.new("TextLabel")
    lbl.Name = name
    lbl.Parent = StatsFrame
    lbl.Size = UDim2.new(0.95, 0, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.SourceSansSemibold
    lbl.Text = defaultText
    lbl.TextColor3 = color or Color3.fromRGB(220, 220, 220)
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    return lbl
end

local LikesLabel = createStatLabel("LikesLabel", "👍 Лайки: 0", Color3.fromRGB(255, 215, 0))
local TotalPlayersLabel = createStatLabel("TotalLabel", "👥 Всего игроков: 0", Color3.fromRGB(255, 255, 255))
local SurvivorsLabel = createStatLabel("SurvivorsLabel", "🛡️ Выживших: 0", Color3.fromRGB(100, 255, 100))
local InfectedLabel = createStatLabel("InfectedLabel", "☣️ Зараженных: 0", Color3.fromRGB(255, 80, 80))

-- === КУСОК ОБНОВЛЕНИЯ СТАТИСТИКИ ===
local function updateStats()
    -- 1. Лайки из ReplicatedStorage.Rating
    local ratingObj = ReplicatedStorage:FindFirstChild("Rating")
    if ratingObj then
        LikesLabel.Text = "👍 Лайки: " .. tostring(ratingObj.Value)
    else
        LikesLabel.Text = "👍 Лайки: N/A"
    end

    -- 2. Всего игроков
    local allPlayers = Players:GetPlayers()
    TotalPlayersLabel.Text = "👥 Всего игроков: " .. tostring(#allPlayers)

    -- 3. Подсчет выживших и зараженных через Workspace
    local infectedCount = 0
    local survivorCount = 0

    for _, player in ipairs(allPlayers) do
        local character = player.Character or Workspace:FindFirstChild(player.Name)
        if character then
            local enemyVal = character:FindFirstChild("Enemy")
            if enemyVal and enemyVal:IsA("BoolValue") then
                if enemyVal.Value == true then
                    infectedCount = infectedCount + 1
                else
                    survivorCount = survivorCount + 1
                end
            else
                -- Если значение Enemy еще не создалось/не определилось
                survivorCount = survivorCount + 1
            end
        end
    end

    SurvivorsLabel.Text = "🛡️ Выживших: " .. tostring(survivorCount)
    InfectedLabel.Text = "☣️ Зараженных: " .. tostring(infectedCount)
end

-- Авто-обновление статистики раз в секунду и при изменении Rating
task.spawn(function()
    local ratingObj = ReplicatedStorage:WaitForChild("Rating", 5)
    if ratingObj then
        ratingObj.Changed:Connect(updateStats)
    end
    
    while true do
        updateStats()
        task.wait(1)
    end
end)

